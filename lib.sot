;-*-Scheme-*-

;; =============================================================================
;; СТАНДАРТНАЯ БИБЛИОТЕКА CORE (Refactored)
;; =============================================================================
;; Базовые макросы, функции работы со списками и утилиты управления потоком.

;; --- [ Секция 1: Мета-программирование ] ---

;; @doc (defmacro name args &rest body)
;; Определяет новый макрос. Базовый кирпич языка.
(define defmacro 
  (macro (name args &rest body)
    `(define ,name (macro ,args ,@body))))

;; @doc (defun name args &rest body)
;; Определяет функцию (обертка над lambda).
(defmacro defun (name args &rest body)
  `(define ,name (lambda ,args ,@body)))

;; @doc (with-gensyms (names...) &rest body)
;; Создает уникальные имена символов для предотвращения конфликтов в макросах.
(defmacro with-gensyms (names &rest body)
  `(let ,(map (lambda (x) `(,x (gensym))) names)
     ,@body))


;; Определяет переменную и присваивает ей значение.
;; Использует &rest для имитации опционального значения и документации.
(defmacro defparameter (name &rest args)
  (define value (car args))
  `(define ,name ,value))

;; Определяет переменную только если она еще не создана.
;; Полезно для сохранения состояния между перезагрузками кода.
(defmacro defvar (name &rest args)
  (define value (car args))
  `(if (not (bound? ',name))
       (define ,name ,value)
       nil))

;; --- [ Секция 2: Управляющие конструкции ] ---

;; @doc (if clause true-branch false-branch)
;; Классическое ветвление.
(defmacro if (test then else)
  `(cond 
     (,test ,then)
     (#t ,else)))

;; @doc (when clause &rest body)
;; Выполняет body, если clause истинно.
(defmacro when (clause &rest body)
  `(if ,clause (begin ,@body) #f))

;; @doc (unless clause &rest body)
;; Выполняет body, если clause ложно.
(defmacro unless (clause &rest body)
  `(if (not ,clause) (begin ,@body) #f))

;; @doc (not x)
;; Логическое отрицание.
(defmacro not (x)
  `(if ,x #f #t))

;; @doc (aif condition true-branch false-branch)
;; Анафорический IF: результат условия доступен внутри веток под именем 'it'.
(defmacro aif (condition true-branch false-branch)
  `(let ((it ,condition))
     (if it ,true-branch ,false-branch)))

;; Выполняет последовательность выражений и возвращает результат последнего.
(defmacro progn (&rest body)
  `(begin ,@body))

;;;; ===========================================================================
;;;; CASE-TYPE MACRO
;;;; ===========================================================================
;;; Диспетчеризация выполнения на основе динамического типа объекта.
;;; 
;;; Формат: (case-type <obj> (<type-name> <body>...) ... (else <body>...))
;;;
;;; Особенности:
;;; 1. Использует внутреннюю функцию (type-of) для определения типа.
;;; 2. <type-name> — это символ типа (например: integer, string, lextoken, pair).
;;; 3. Имена типов не нужно квотировать (integer вместо 'integer).
;;;
;;; Пример развертки:
;;; (case-type x (string 1) (else 2)) 
;;; => (let ((g!1 (type-of x))) (cond ((eq? g!1 'string) 1) (#t 2)))
;;;
;;; Примечание: Критически важен для парсеров и ассемблеров, где логика
;;; сильно зависит от того, является ли аргумент числом, символом или токеном.
(defmacro case-type (obj &rest branches)
  (let ((type-sym (gensym)))
    `(let ((,type-sym (type-of ,obj)))
       (cond
         ,@(map (lambda (branch)
                  (let ((head (car branch))
                        (body (cdr branch)))
                    (if (eq? head 'else)
                        `(#t ,@body)
                        `((eq? ,type-sym ',head) ,@body))))
                branches)))))

;;;; ===========================================================================
;;;; CASE MACRO
;;;; ===========================================================================
;;; Сравнивает результат выражения с набором константных ключей.
;;; 
;;; Формат: (case <expr> (<key> <body>...) ... (else <body>...))
;;;
;;; Особенности:
;;; 1. <expr> вычисляется только один раз (результат биндится к gensym).
;;; 2. <key> может быть символом, числом или списком: ( (k1 k2) <body> ).
;;; 3. Ключи автоматически квотируются (не нужно писать 'a, достаточно a).
;;;
;;; Пример развертки:
;;; (case x (a 1) (else 2))  =>  (let ((g!1 x)) (cond ((eq? g!1 'a) 1) (#t 2)))
(defmacro case (expr &rest branches)
  (let ((val-sym (gensym)))
    `(let ((,val-sym ,expr))
       (cond
         ,@(map (lambda (branch)
                  (let ((head (car branch))
                        (body (cdr branch)))
                    (if (eq? head 'else)
                        `(#t ,@body)
                        ;; В классическом case ключи могут быть списком (a b c)
                        (if (list? head)
                            `((member ,val-sym ',head) ,@body)
                            `((eq? ,val-sym ',head) ,@body)))))
                branches)))))

;; --- [ Секция 3: Работа со списками ] ---

;; Аксессоры (C-x-R)

(defun first (x)  (car x))
(defun rest (x)   (cdr x))
(defun second (x) (car (cdr x)))
(defun third (x)  (car (cddr x)))

(defun caar   (x) (car (car x)))
(defun cadr   (x) (car (cdr x)))   ; 2-й элемент
(defun cdar   (x) (cdr (car x)))
(defun cddr   (x) (cdr (cdr x)))
(defun caaar  (x) (car (car (car x))))
(defun caadr  (x) (car (car (cdr x))))
(defun cadar  (x) (car (cdr (car x))))
(defun caddr  (x) (car (cdr (cdr x)))) ; 3-й элемент
(defun cdddr  (x) (cdr (cdr (cdr x))))
(defun cadddr (x) (car (cdr (cdr (cdr x))))) ; 4-й элемент

;; @doc (length lst) -> integer
;; Итеративный подсчет длины списка (безопасно для стека).
;(defun length (lst)
;  (let ((n 0) (iter lst))
;    (while (not (null? iter))
;      (set! n (+ n 1))
;      (set! iter (cdr iter)))
;    n))

;; Рекурсивно «выравнивает» вложенные списки в один плоский список.
;; Использует consp для обнаружения подпунктов и append для их слияния.
(defun flatten (lis)
  (cond ((null lis) nil)
        ((consp lis) (append (flatten (car lis)) (flatten (cdr lis))))
        (t (list lis))))

;; @doc (reverse lst) -> list
;; Разворачивает список (итеративно).
(defun reverse (lst)
  (let ((result '()) (iter lst))
    (while (not (null? iter))
      (set! result (cons (car iter) result))
      (set! iter (cdr iter)))
    result))

;; @doc (member x lst) -> list or #f
;; Ищет элемент x в списке lst. Возвращает хвост списка, начинающийся с x.
(defun member (x lst)
  (if (null? lst)
      #f
      (if (eq? (car lst) x)
          lst
          (member x (cdr lst)))))

;; @doc (assoc x alist) -> pair or #f
;; Поиск в ассоциативном списке (списке пар).
(defun assoc (x alist)
  (if (null? alist)
      #f
      (if (eq? (caar alist) x)
          (car alist)
          (assoc x (cdr alist)))))

;; @doc (push! lst obj)
;; Добавляет элемент в начало списка (изменяет переменную lst).
(defmacro push! (obj lst)
  `(set! ,lst (cons ,obj ,lst)))

;; @doc (pop! lst)
;; Удаляет и возвращает первый элемент списка (изменяет переменную lst).
(defmacro pop! (lst)
  (with-gensyms (tmp)
    `(let ((,tmp (car ,lst)))
       (set! ,lst (cdr ,lst))
       ,tmp)))

;;; --- MAPCAR ---
;; Применяет функцию func к каждому элементу списка lst.
;; Результат: новый список из возвращаемых значений.
(defun mapcar (func lst)
  (if (null lst)
      nil ; Базовый случай: список кончился.
      (cons (func (car lst)) ; Вызываем func для "головы" и кладем в новый список.
            (mapcar func (cdr lst))))) ; Рекурсивно идем к "хвосту".

;;; --- MAPCAR2 ---
;; Параллельная обработка двух списков.
;; Лямбда func должна принимать ровно 2 аргумента.
(defun mapcar2 (func lst1 lst2)
  ; Если ХОТЯ БЫ ОДИН список пуст, обработка прекращается.
  (if (or (null lst1) (null lst2))
      nil
      ; Берем по одному элементу из каждого списка и передаем в func.
      (cons (func (car lst1) (car lst2))
            (mapcar2 func (cdr lst1) (cdr lst2)))))

;;; --- MAPCAR3 ---
;; Параллельная обработка трех списков (нужна для макроса soperand).
;; Лямбда func должна принимать ровно 3 аргумента (например: blo, blob, bloc).
(defun mapcar3 (func lst1 lst2 lst3)
  ; Синхронно идем по трем спискам. Если один короче других,
  ; результат будет длиной с самый короткий список.
  (if (or (null lst1) (null lst2) (null lst3))
      nil
      ; Извлекаем головы (car) всех трех списков одновременно.
      (cons (func (car lst1) (car lst2) (car lst3))
            ; Рекурсивно переходим к хвостам (cdr) всех трех списков.
            (mapcar3 func (cdr lst1) (cdr lst2) (cdr lst3)))))

;; --- [ Секция 3.1: Hash Table ] ---

;; Ищет значение в хеш-таблице по ключу.
;; Благодаря твоей реализации в C++, ключ может быть символом или строкой.
(defun gethash (key table)
  (hash-table-ref table key))

;; --- [ Секция 4: Циклы ] ---

;; @doc (dotimes (var count [result]) &rest body)
;; Цикл от 0 до count-1.
(defmacro dotimes (var &rest body)
  `(let ((,(first var) 0))
     (while (< ,(first var) ,(second var))
            ,@body
            (set! ,(first var) (+ ,(first var) 1)))
     ,@(cddr var)))

;; @doc (dolist (var list) &rest body)
;; Итерация по элементам списка.
(defmacro dolist (bindings &rest body)
  `(let ((,(car bindings) ,(cadr bindings)))
      (while (not (null? ,(car bindings)))
        ,@body
        (set! ,(car bindings) (cdr ,(car bindings))))))


;; --- [ Секция 5: Мутации и арифметика ] ---

(defmacro 1+ (x) `(+ ,x 1))
(defmacro 1- (x) `(- ,x 1))
(defmacro inc! (x) `(set! ,x (1+ ,x)))
(defmacro dec! (x) `(set! ,x (1- ,x)))
(defmacro +! (place arg) `(set! ,place (+ ,place ,arg)))
(defmacro -! (place arg) `(set! ,place (- ,place ,arg)))

;; --- [ Секция 6: Предикаты типов ] ---

(defmacro typep    (x t) `(type? ,x ,t))
(defmacro numberp  (x) `(number? ,x))
(defmacro floatp   (x) `(type? ,x 'float))
(defmacro integerp (x) `(type? ,x 'integer))
(defmacro fixnump  (x) `(type? ,x 'integer))
(defmacro symbolp  (x) `(type? ,x 'symbol))
(defmacro stringp  (x) `(type? ,x 'string))
(defmacro pairp    (x) `(type? ,x 'pair))

(defmacro neq? (a b) `(not (eq? ,a ,b)))
(defmacro !=   (a b) `(not (= ,a ,b)))


;;;; ===========================================================================
;;;; LIST? PREDICATE
;;;; ===========================================================================
;;; Проверяет, является ли объект каноничным списком.
;;; Список — это либо пустой список '(), либо пара (cons),
;;; чей хвост (cdr) также является списком.
;;; В отличие от pair?, возвращает #f для "точечных пар" вроде (1 . 2).
(defun list? (x)
  (cond
    ((null? x) #t)       ; Пустой список — это каноничный список
    ((pair? x) (list? (cdr x))) ; Рекурсивно проверяем хвост
    (else #f)))          ; Атомы (числа, символы и т.д.) — не списки

;; --- [ Секция 7: Лог ] ---

(defun info  (fmt-str &rest args)  (apply 'log 'info  fmt-str args))
(defun warn  (fmt-str &rest args)  (apply 'log 'warn  fmt-str args))
(defun error (fmt-str &rest args)  (apply 'log 'error fmt-str args))
       
;; --- [ Секция 8: Функция к сриску ] ---

;; Стандартный map: Трансформирует список, применяя функцию к каждому элементу.
;; Возвращает новый список той же длины с результатами вычислений.
;; (map (lambda (x) (* x x)) '(1 2 3)) => (1 4 9)
(defun map (fun x)
    (if (null? x)
        '()
        (cons (fun (car x))
              (map fun (cdr x)))))

;; Специализированный map2: Параллельный обход двух списков с разными функциями.
;; Полезен для задач сборки данных, где нужно одновременно обработать два потока.
;; Важно: Проверяет списки на равенство длин и завершается, если один из них пуст.
(defun map2 (fun1 fun2 lst1 lst2)
    (if (or (null? lst1)
            (null? lst2)
            (not (= (length lst1) (length lst2))))
        '()
        (cons (fun1 (car lst1))
              (cons (fun2 (car lst2))
                    (map2 fun1 fun2 (cdr lst1) (cdr lst2))))))

;=================================================================
; Mimic Common Lisp Library
;=================================================================

;; В раздел Mimic CL
;; --- Fundamental Constants ---
(define NIL '())      ; The primary empty list / false object
(define nil NIL)      ; Lowercase alias for convenience
(define T   #t)       ; The primary truth object
(define t   T)        ; Lowercase alias for convenience

;; --- Predicates ---
(defun null  (x) (null? x))
(defun nilp  (x) (null? x))
(defun atom  (x) (not (pair? x)))
(defun consp (x) (pair? x))
(defun listp (x) (or (pair? x) (null? x)))

;; --- Common Lisp Equality Alias ---
(defun eq (a b) (eq? a b))

;; --- Assignment & Variables ---
(defmacro setq (name data) `(define ,name ,data))

;; --- Generalized Variables (The core we just built) ---
(defmacro setf (place value)
  (if (symbolp place)
      `(setq ,place ,value)
      (let ((setter (get-setter (car place))))
        (if (not (nil? setter))
            `(,setter ,@(cdr place) ,value)
            (error "SETF: No setter registered for: " (car place))))))

(defsetf 'car 'set-car!)
(defsetf 'cdr 'set-cr!)
(defsetf 'get 'hash-table-set!)
(defsetf 'vector-ref 'vector-set!)

;; --- Math & Utilities ---
(defun sign (x) (if (>= x 0) '+ '-))

;; Алиас для удобства (Common Lisp style)
(defun intern (str) (string->symbol str))

;; Если нет concat, но есть string-append
(defun concat (&rest args) (apply 'string-append args))

;; --- Setf CL Style ---

;; 'setf' в CL — это мощнейшая система 'set-field'.
;; В простейшем случае (setf name value) он работает как setq.
;; Если ты передаешь getter (например, (setf (car x) 5)), это требует сложной логики.
;; Пока сделаем базовую версию для переменных:
(defmacro setf (place value)
  (if (symbol? place)
      `(set! ,place ,value)
      (let ((setter (get-setter (car place)))
            (tmp-val (gensym))) ; Если у тебя есть gensym для уникальных имен
        `(let ((,tmp-val ,value))
           (,(get-setter (car place)) ,@(cdr place) ,tmp-val)
           ,tmp-val))))

;; --- Asserts & Errors ---

(defmacro assert (condition &optional message)
  `(if (not ,condition)
       (error (if ,message ,message "Assertion failed!") ',condition)
       T))

;; (check-type x symbolp)
(defmacro check-type (var predicate)
  `(assert (,predicate ,var) (fmt #f "Variable ~s failed type check ~s" ',var ',predicate)))

;; --- Structures ----------

;; =============================================================================
;; DEFSTRUCT: Генератор структур данных в стиле Common Lisp.
;; =============================================================================
;; Автоматизирует создание "объектов" на базе ассоциативных списков (alist).
;; Пример использования: (defstruct point x y)
;; Макрос создаст в памяти:
;;   1. Конструктор (make-point :x 1 :y 2)
;;   2. Геттер (point-x instance)
;;   3. Геттер (point-y instance)
;; =============================================================================
(defmacro defstruct (name &rest fields)
  (let* ((struct-name-sym name)
          (doc? (string? (car fields)))
          ;; Если первый элемент строка — это докстринг, берем остальное как поля
          (fields (if doc? (cdr fields) fields))
          (struct-name-str (symbol->string name))
          (constructor (intern (concat "make-" struct-name-str)))
          (normalized (map (lambda (f) (if (pair? f) f (list f nil))) fields)))
    `(progn
       ;; --- Конструктор ---
       ;; Используем &key, так как это Лисп-функция, она умеет в именованные аргументы
       (defun ,constructor (&key ,@normalized)
         (make-hash-table 
          (list 
           ;; Теперь не нужно (list ':_type_ 's), можно проще:
           (cons :_type_ ',struct-name-sym)
           ,@(map (lambda (f-spec)
                    (let ((f-name (car f-spec))
                          (key (intern (concat ":" (symbol->string (car f-spec))))))
                      ;; Генерируем (list :key f-name)
                      `(cons ,key ,f-name)))
                  normalized))))

       ;; --- Предикат типа ---
       (defun ,(intern (concat struct-name-str "?")) (obj)
         (and (hash-table? obj) 
              (eq? (hash-table-ref obj :_type_) ',struct-name-sym)))

       ;; --- Геттеры ---
       ,@(map (lambda (f-spec)
                (let* ((f-name (car f-spec))
                       (getter-name (intern (concat struct-name-str "-" (symbol->string f-name))))
                       (key (intern (concat ":" (symbol->string f-name)))))
                  `(defun ,getter-name (instance)
                     ;; Просто передаем :key как есть
                     (hash-table-ref instance ,key))))
              normalized)

       ;; --- Сеттеры ---
       ,@(map (lambda (f-spec)
                (let* ((f-name (car f-spec))
                       (setter-name (intern (concat struct-name-str "-" (symbol->string f-name) "!")))
                       (key (intern (concat ":" (symbol->string f-name)))))
                  `(defun ,setter-name (instance value)
                     (hash-table-set! instance ,key value))))
              normalized))))

(defun build-struct-from-plist (fields args)
  "Превращает (:key1 val1 :key2 val2) в ((key1 . val1) (key2 . val2))"
  (if (null? args)
      '()
      (cons (cons (car args) (second args))
            (build-struct-from-plist fields (cddr args)))))
(defun build-struct-from-plist (args)
  "Превращает (:type 'imm :value 10) в ((:type . imm) (:value . 10))"
  (if (null? args)
      '()
      (cons (cons (car args) (cadr args))
            (build-struct-from-plist (cddr args)))))            




;;; --- SUBSTITUTE ---
;; "Чистая" замена только на верхнем уровне списка.
;; Создает копию списка, не меняя оригинал.
(defun substitute (new old lst)
  (cond ((null? lst) '()) ; Если список пуст — возвращаем пустой список.
        
        ; Если текущий элемент совпадает с тем, что ищем:
        ((eq? (car lst) old) 
         ; Создаем новую ячейку с 'new' и идем дальше по хвосту.
         (cons new (substitute new old (cdr lst))))
        
        ; Если не совпадает:
        (t (cons (car lst) (substitute new old (cdr lst))))))

;;; --- RECSUBSTITUTE ---
;; "Глубокая" рекурсивная замена. 
;; Ищет 'source' даже внутри вложенных списков.
(defun recsubstitute (dest source lis)
   (cond
      ; Случай 1: Сам элемент (или текущий атом) равен искомому.
      ; Заменяем его на 'dest'.
      ((eq? lis source)
         dest)
      
      ; Случай 2: Если перед нами список — нужно "просеять" его внутрь.
      ((listp lis)
         (cond
            ; Если список пуст — возвращаем как есть.
            ((null lis) lis)
            ; Магия: вызываем recsubstitute для каждого элемента списка через mapcar.
            ; Это позволяет зайти на любую глубину вложенности.
            (T (mapcar (lambda (item) (recsubstitute dest source item))
                       lis))))
      
      ; Случай 3: Если это атом, но не тот, что мы ищем — просто возвращаем его.
      (T lis)))

;;; --- NSUBSTITUTE ---
;; "Деструктивная" замена (n = non-destructive по названию, но destructive по факту).
;; В отличие от обычной substitute, она НЕ создает новый список, 
;; а переписывает память существующего.
(defun nsubstitute (new old lst)
  (let ((current lst)) ; Берем указатель на начало списка.
    (while (not (null? current)) ; Пока не дошли до конца:
      
      ; Если голова текущей ячейки (car) равна 'old'
      (if (eq? (car current) old)
          ; Мы ПЕРЕЗАПИСЫВАЕМ значение прямо в этой ячейке памяти.
          (set-car! current new)) 
      
      ; Переходим к следующей ячейке (сдвигаем указатель).
      (set! current (cdr current)))
    
    ; Возвращаем тот же самый указатель на список.
    ; Внимание: все, кто ссылался на этот список, увидят изменения!
    lst))


;; Маркер успешной загрузки библиотеки
(define *core-lib-loaded* #t)
