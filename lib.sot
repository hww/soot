;-*-Scheme-*-

;; =============================================================================
;; СТАНДАРТНАЯ БИБЛИОТЕКА CORE (Refactored)
;; =============================================================================
;; Базовые макросы, функции работы со списками и утилиты управления потоком.

;; --- [ Секция 1: Мета-программирование ] ---

;; @doc (defmacro name args &rest body)
;; Определяет новый макрос. Базовый кирпич языка.
(define defmacro 
  (macro (name args &rest body)
    `(define ,name (macro ,args ,@body))))

;; @doc (defun name args &rest body)
;; Определяет функцию (обертка над lambda).
(defmacro defun (name args &rest body)
  `(define ,name (lambda ,args ,@body)))

;; @doc (with-gensyms (names...) &rest body)
;; Создает уникальные имена символов для предотвращения конфликтов в макросах.
(defmacro with-gensyms (names &rest body)
  `(let ,(map (lambda (x) `(,x (gensym))) names)
     ,@body))

;; --- [ Секция 2: Управляющие конструкции ] ---

;; @doc (if clause true-branch false-branch)
;; Классическое ветвление.
(defmacro if (test then else)
  `(cond 
     (,test ,then)
     (#t ,else)))

;; @doc (when clause &rest body)
;; Выполняет body, если clause истинно.
(defmacro when (clause &rest body)
  `(if ,clause (begin ,@body) #f))

;; @doc (unless clause &rest body)
;; Выполняет body, если clause ложно.
(defmacro unless (clause &rest body)
  `(if (not ,clause) (begin ,@body) #f))

;; @doc (not x)
;; Логическое отрицание.
(defmacro not (x)
  `(if ,x #f #t))

;; @doc (aif condition true-branch false-branch)
;; Анафорический IF: результат условия доступен внутри веток под именем 'it'.
(defmacro aif (condition true-branch false-branch)
  `(let ((it ,condition))
     (if it ,true-branch ,false-branch)))

;; (case-type <expression>
;;   (<type-symbol-1> <body-1>)
;;   (<type-symbol-2> <body-2>)
;;   (else            <default-body>))
(defmacro case-type (obj &rest branches)
  (let ((type-sym (gensym)))
    `(let ((,type-sym (type-of ,obj)))
       (cond
         ,@(map (lambda (branch)
                  (let ((head (car branch))
                        (body (cdr branch)))
                    (if (eq? head 'else)
                        `(#t ,@body)
                        `((eq? ,type-sym ',head) ,@body))))
                branches)))))

;; --- [ Секция 3: Работа со списками ] ---

;; Аксессоры (C-x-R)
(defmacro caar (x) `(car (car ,x)))
(defmacro cadr (x) `(car (cdr ,x)))
(defmacro cdar (x) `(cdr (car ,x)))
(defmacro cddr (x) `(cdr (cdr ,x)))
(defun first (x)  (car x))
(defun rest (x)   (cdr x))
(defun second (x) (car (cdr x)))
(defun third (x)  (car (cddr x)))

;; @doc (length lst) -> integer
;; Итеративный подсчет длины списка (безопасно для стека).
(defun length (lst)
  (let ((n 0) (iter lst))
    (while (not (null? iter))
      (set! n (+ n 1))
      (set! iter (cdr iter)))
    n))

;; @doc (reverse lst) -> list
;; Разворачивает список (итеративно).
(defun reverse (lst)
  (let ((result '()) (iter lst))
    (while (not (null? iter))
      (set! result (cons (car iter) result))
      (set! iter (cdr iter)))
    result))

;; @doc (member x lst) -> list or #f
;; Ищет элемент x в списке lst. Возвращает хвост списка, начинающийся с x.
(defun member (x lst)
  (if (null? lst)
      #f
      (if (eq? (car lst) x)
          lst
          (member x (cdr lst)))))

;; @doc (assoc x alist) -> pair or #f
;; Поиск в ассоциативном списке (списке пар).
(defun assoc (x alist)
  (if (null? alist)
      #f
      (if (eq? (caar alist) x)
          (car alist)
          (assoc x (cdr alist)))))


;; --- [ Секция 4: Циклы ] ---

;; @doc (dotimes (var count [result]) &rest body)
;; Цикл от 0 до count-1.
(defmacro dotimes (var &rest body)
  `(let ((,(first var) 0))
     (while (< ,(first var) ,(second var))
            ,@body
            (set! ,(first var) (+ ,(first var) 1)))
     ,@(cddr var)))

;; @doc (dolist (var list) &rest body)
;; Итерация по элементам списка.
(defmacro dolist (bindings &rest body)
  `(let ((,(car bindings) ,(cadr bindings)))
      (while (not (null? ,(car bindings)))
        ,@body
        (set! ,(car bindings) (cdr ,(car bindings))))))


;; --- [ Секция 5: Мутации и арифметика ] ---

(defmacro 1+ (x) `(+ ,x 1))
(defmacro 1- (x) `(- ,x 1))
(defmacro inc! (x) `(set! ,x (1+ ,x)))
(defmacro dec! (x) `(set! ,x (1- ,x)))
(defmacro +! (place arg) `(set! ,place (+ ,place ,arg)))
(defmacro -! (place arg) `(set! ,place (- ,place ,arg)))

;; @doc (push! lst obj)
;; Добавляет элемент в начало списка (изменяет переменную lst).
(defmacro push! (lst obj) 
  `(set! ,lst (cons ,obj ,lst)))

;; @doc (pop! lst)
;; Удаляет и возвращает первый элемент списка (изменяет переменную lst).
(defmacro pop! (lst)
  (with-gensyms (tmp)
    `(let ((,tmp (car ,lst)))
       (set! ,lst (cdr ,lst))
       ,tmp)))


;; --- [ Секция 6: Предикаты типов ] ---

(defmacro string?  (x) `(type? 'string ,x))
(defmacro float?   (x) `(type? 'float ,x))
(defmacro integer? (x) `(type? 'integer ,x))
(defmacro pair?    (x) `(type? 'pair ,x))
(defmacro symbol?  (x) `(type? 'symbol ,x))
(defmacro number?  (x) `(or (float? ,x) (integer? ,x)))
(defmacro neq? (a b) `(not (eq? ,a ,b)))
(defmacro !=   (a b) `(not (= ,a ,b)))


;; --- [ Секция 7: Лог ] ---

(defun info  (fmt-str &rest args)  (apply 'log 'info  fmt-str args))
(defun warn  (fmt-str &rest args)  (apply 'log 'warn  fmt-str args))
(defun error (fmt-str &rest args)  (apply 'log 'error fmt-str args))

;; --- [ Секция 8: Функция к сриску ] ---

;; Стандартный map (то, что у тебя называлось apply)
(defun map (fun x)
    (if (null? x)
        '()
        (cons (fun (car x))
              (map fun (cdr x)))))

;; Твой apply2, теперь map2
(defun map2 (fun1 fun2 lst1 lst2)
    (if (or (null? lst1) 
            (null? lst2) 
            (not (= (length lst1) (length lst2))))
        '()
        (cons (fun1 (car lst1))
              (cons (fun2 (car lst2))
                    (map2 fun1 fun2 (cdr lst1) (cdr lst2))))))

;; Маркер успешной загрузки библиотеки
(define *core-lib-loaded* #t)
