(init-types 'z80)

(defmacro ts-> (&rest args) `(-> *type-system* ,@args))

(deftype Player~ (basic)
      ((id uint8 ) ;; 1 байт, по умолчанию 0
      (hp uint16 ) ;; 2 байта, Little-endian, по умолчанию 100
      (score uint16 ) ;; 4 байта
      (pos-x uint16 ) ;; 2 байта
      (pos-y uint16 ))) 

(define buf (make-buffer "DRV_SEG" 64 0))
(define wr  (make-buffer-writer buf))

(buffer-write buf '((id . 1)) :at 0 :as 'Player~)

(fmt #t "Dump:\n{}\n" (buffer-dump buf 0 64 #t 8))

(defmacro def-asm-struct (name &rest fields)
  (let* ((type-name (string->symbol (fmt #f "{}" name)))
         (size-const (string->symbol (fmt #f "{}::type::size" name))))
    
    `(begin
       ;; 1. Определяем тип в системе типов Soot
       (deftype ,name (basic) ,@fields)

       ;; 2. Определяем константу размера (вычисляется после регистрации типа)
       (define ,size-const (-> *type-system* ,type-name size))

       ;; 3. Генерируем константы смещений для каждого поля
       ,@(mapcar (lambda (f)
                   (let* ((f-name (caar f))
                          (const-name (string->symbol (fmt #f "{}::{}" name f-name))))
                     `(define ,const-name (-> *type-system* ,type-name ,f-name offset))))
                 fields))))

(def-asm-struct Player
  ((id uint8)
  (hp uint16)
  (score uint16)
  (pos-x uint16)
  (pos-y uint16)))

(print (-> *type-system* Player))