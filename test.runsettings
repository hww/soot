<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Явно указываем Visual Studio искать тестовые адаптеры и .exe в папке /bin вашей сборки Windows Debug -->
    <TestAdaptersPaths>${RuntimeFolder};${ProjectDir}\out\build\Debug\bin</TestAdaptersPaths>
  </RunConfiguration>
  
  <!-- Настройки для Google Test Adapter -->
  <GoogleTestAdapterSettings>
    <SolutionSettings>
      <Settings>
        <TestDiscoveryRegex>.*{test,tests}\.exe</TestDiscoveryRegex>
      </Settings>
    </SolutionSettings>
  </GoogleTestAdapterSettings>
</RunSettings>
