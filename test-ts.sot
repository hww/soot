(init-types 'z80)


(defenum test-enum
        :type uint8
        (red   0) 
        (green 1)
        (blue  2))

(defenum test-mask
        :bitfield #t
        :type uint8
        (bit0 1)
        (bit1 2)
        (bit2 4)
        (bit3 8)
        (bit4 #x10)
        (bit5 #x20)
        (bit6 #x40)
        (bit7 #x80)        
        )

(deftype test-struct (basic)
  ((test_i8   int8 1) 
   (test_i16  int16 2)))

(deftype test-vector (basic)
  ((x   int8 1) 
   (y   int8 2))
  (:methods
      (new (int8 int8) object)
      (set (int8 int8) none)
      (len () int8)
      ))

(let* ((buf (make-static-buffer "test" 200 #x100))
       (wr (make-static-writer buf)))
   ;; 1. Простые типы
  (write-to-writer wr #xAA :as 'int)
  (write-to-writer wr #xBB :as 'int)
  
  ;; 2. String
  (write-to-writer wr "Hello" :as 'string)
  ;; 3. test-struct с alist
  (write-to-writer wr '((test_i8 . 10) (test_i16 . 1000)) :as 'test-struct)
  
  ;; 4. test-vector с alist  
  (write-to-writer wr '((x . 5) (y . 10)) :as 'test-vector)
  ;; 5. Проверяем чтение полей
  (fmt #t "=== Чтение полей ===\n")
  
  ;; Читаем test_i8 из test-struct
 ;(let ((test_i8 (static-buffer-read-field buf 0 'test-struct "test_i8")))
 ;  (fmt #t "test_i8 = {}\n" test_i8))
 ;
 ;;; Читаем x из test-vector
 ;(let ((x (static-buffer-read-field buf 
 ;          (+ (type-size (lookup-type (current-type-system) 'test-struct))
 ;             (type-size (lookup-type (current-type-system) 'string)))
 ;          'test-vector "x")))
 ;  (fmt #t "test-vector.x = {}\n" x))


(write-to-writer wr #x0155 :as 'int) 
;;
(write-to-writer wr 1 :as 'test-enum)
;;
(write-to-writer wr #x0155 :as 'int) 
(write-to-writer wr 1 :as 'test-mask)
;;
(write-to-writer wr #x0455 :as 'int) 
(write-to-writer wr 1 :as 'test-struct)
;;
(write-to-writer wr #x0555 :as 'int) 

(static-buffer-dump buf 0 1024 #t 16))


