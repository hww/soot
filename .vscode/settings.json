{
    // 1. Главная настройка: заставляем IntelliSense брать пути из CMake
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    
    // 2. Исправляем C_Cpp_Runner, чтобы он не индексировал лишнего
    "C_Cpp_Runner.includeSearch": [
        "${workspaceFolder}/common/**",
        "${workspaceFolder}/third_party/**"
    ],
    "C_Cpp_Runner.excludeSearch": [
        "**/build/**",
        "**/.*/**",
        "**/.vscode/**",
        "**/.git/**"
    ],

    // 3. Настройки индексации (IntelliSense)
    "C_Cpp.intelliSenseEngine": "default",
    // Запрещаем сканировать папку build для поиска исходников (чтобы не дублировать символы)
    "C_Cpp.files.exclude": {
        "**/build/**": true
    },

    // 4. Настройки CMake Tools для корректной сборки
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureSettings": {
        "BUILD_TESTS": "ON",
        "FMT_TEST": "OFF"
    },
    // Отключаем встроенный проводник тестов CMake, чтобы не было дублей
    "cmake.testing.enabled": false,
    // Оставляем управление за TestMate
    "testMate.cpp.test.executables": "build/bin/*test*",
    "testMate.cpp.test.onConfigurationChange": "reload",
    // Это заставит CMake пересобирать зависимости при изменении исходников
    "cmake.buildBeforeRun": true,
    "cmake.autoSelectActiveFolder": true,
    "cmake.generator": "Unix Makefiles"
}