{
  "name": "Carbon Test",
  "type": "cppdbg",
  "request": "launch",
  "program": "${workspaceFolder}/build/bin/typesys_tests", // Проверьте имя бинарника из CMake!
  "args": [],
  "stopAtEntry": false,
  "cwd": "${workspaceFolder}",
  "environment": [
    {
      "name": "LD_LIBRARY_PATH",
      "value": "${workspaceFolder}/build/lib:${env:LD_LIBRARY_PATH}"
    }
  ],
  "externalConsole": false,
  "MIMode": "gdb",
  "setupCommands": [
    {
      "description": "Enable pretty-printing for gdb",
      "text": "-enable-pretty-printing",
      "ignoreFailures": true
    }
  ],
  "preLaunchTask": "Build Tests" // Теперь он зависит от "Build All"
}