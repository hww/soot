{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug soot",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/soot",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build",
      "stopAtEntry": true,  // Остановиться при входе в main
    },
    {
      "name": "Debug xiff",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/xiff",
      "args": ["--compile", "-e", "(+ 1o1 2 3)", "--tokens", "--ast"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build"
    }
  ]
}