      ],
      "preLaunchTask": "Build All",
      "stopAtEntry": false,
      "visualizerFile": "${workspaceFolder}/.vscode/stringid.natvis",
      "showDisplayString": true
    },
    {
      "name": "SOOT Compiler Single Function",
