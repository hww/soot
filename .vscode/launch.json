{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Debug (gdb Launch)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/z80-lisp",
      "args": [
        "--compile",
        "-e",
        "\"(+ 1o1 2 3)\"",
        "--tokens",
        "--ast"
      ],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/valery/z80-lisp/src",
      "program": "/home/valery/z80-lisp/src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}