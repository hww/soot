    {
      "name": "SOOT Compiler",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/sootc",
      "args": [
        "--source-root",
        "${workspaceFolder}/common/sootc/src",
        "--target",
        "modules",
        "${workspaceFolder}/common/sootc/src/lib/math.sot"
      ],
      "cwd": "${workspaceFolder}/build", 
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
