            "text": "python import sys; sys.path.insert(0, '${workspaceFolder}/.vscode/libcxx-pretty-printers/src'); from libcxx.v1.printers import register_libcxx_printers; register_libcxx_printers(None)",
            "ignoreFailures": true
        },  
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build All",
      "stopAtEntry": false,
      "visualizerFile": "${workspaceFolder}/.vscode/stringid.natvis",
      "showDisplayString": true
    },    
    {
      "name": "SOOT (--no-repl)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/sootc",
      "args": [
        "--no-repl", "--debug-ast", "--debug-ir", "--debug-asm",
        "--source-root",
        "${workspaceFolder}/common/sootc/src",
        "--target",
        "modules",
        "${workspaceFolder}/common/sootc/src/lib/math.sot"
      ],
      "cwd": "${workspaceFolder}/build", 
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
            // N.B. Обязательно перед -enable-pretty-printing но требуется получить скрипты
            // git clone https://github.com/davenger/libcxx-pretty-printers.git .vscode/libcxx-pretty-printers
            "description": "Загружаем pretty-printer'ы для libc++",
            "text": "python import sys; sys.path.insert(0, '${workspaceFolder}/.vscode/libcxx-pretty-printers/src'); from libcxx.v1.printers import register_libcxx_printers; register_libcxx_printers(None)",
            "ignoreFailures": true
        },        
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build All",
      "stopAtEntry": false,
      "visualizerFile": "${workspaceFolder}/.vscode/stringid.natvis",
      "showDisplayString": true
    },
    {
      "name": "Carbon VM",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/carbon",
      "args": [
        "-I",
        "modules",
        "lib/math",
        "add",
        "5",
        "3"
      ],
      "cwd": "${workspaceFolder}/build", 
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        //{
        //  "description": "Enable pretty-printing for gdb",
