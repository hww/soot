{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SOOT",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/soot",
      "args": [],
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build All",
      "stopAtEntry": false,
      "visualizerFile": "${workspaceFolder}/.vscode/stringid.natvis",
      "showDisplayString": true
    },
    {
      "name": "SOOT (HOME)",
      "type": "cppdbg",
      "request": "launch",
