{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All",
            "type": "shell",
            "command": "cd ${workspaceFolder}/build && make -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "cd ${workspaceFolder}/build && make typesys_tests -j$(nproc)",
            "group": "build",
            "dependsOn": [
                "Build All"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean and Rebuild",
            "type": "shell",
            "command": "rm -rf ${workspaceFolder}/build/* && cd ${workspaceFolder}/build && cmake -DBUILD_TESTS=ON .. && make -j$(nproc)",
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                ""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}