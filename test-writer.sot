(init-types 'z80)

(deftype inner (basic) (
    (val_i8 int8)
    (val_i16 int16)
    (val_u8 uint8)
    (val_u16 uint16)
)) 

;; 1. Обновляем чертеж: добавляем поле для тега
(deftype outer (basic) (
    (tag  int8  1)  ;; Теперь поле 'tag существует!
    (data inner 1)
))

;; 2. Запускаем запись снова
(let* ((buf (make-static-buffer "test" 100 0))
       (wr (make-static-writer buf)))
        
   (write-to-buffer wr 
                    '((tag  . #x55) 
                      (data . ((val_i8 . #x7F)
                                (val_i16 . #x7FFF)
                                (val_u8 . #x7F)
                                (val_u16 . #x7FFF)))) 
                    :as 'outer)
      
   (fmt #t "Dump:\n{}\n" (static-buffer-dump buf 0 64 #t 8))
   
   
   ;; Чтение (слайсинг)
   (let ((obj (read-from-buffer buf :as 'outer :at 0)))
    ;; obj сейчас — это TypeCell, так как 'outer это структура
    
    (let ((val-cell (-> obj 'data 'val_i8)))
       (fmt #t "Value val_i8 is: {}\n" (cell-get val-cell)))
    
    (let ((tag-cell (-> obj 'tag)))
       (fmt #t "Tag is: #x{:x}\n" (cell-get tag-cell)))
       
    (let ((val-cell (-> obj 'data 'val_i8)))
       (set! (-> obj 'data 'val_i8) 45) 
       (fmt #t "Value val_i8 after set 45 is: {}\n" (cell-get val-cell)))

   )
   ;; Запист с переполнением
   (let ((obj (read-from-buffer buf :as 'outer :at 0)))
    ;; obj сейчас — это TypeCell, так как 'outer это структура
       
    (let ((val-cell (-> obj 'data 'val_i8)))
       (set! (-> obj 'data 'val_i8) #x80) 
       (fmt #t "Value val_i8 after set #x80 is: {}\n" (cell-get val-cell)))
    (let ((val-cell (-> obj 'data 'val_u8)))
       (set! (-> obj 'data 'val_u8) #x80) 
       (fmt #t "Value val_u8 after set #x80 is: {}\n" (cell-get val-cell)))
    (let ((val-cell (-> obj 'data 'val_i16)))
       (set! (-> obj 'data 'val_i16) #x8000) 
       (fmt #t "Value val_i16 after set #x8000 is: {}\n" (cell-get val-cell)))
    (let ((val-cell (-> obj 'data 'val_u16)))
       (set! (-> obj 'data 'val_u16) #x8000) 
       (fmt #t "Value val_u16 after set #x8000 is: {}\n" (cell-get val-cell)))

   )
   
   (fmt #t "Dump:\n{}\n" (static-buffer-dump buf 0 64 #t 8))
   )