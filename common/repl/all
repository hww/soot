void ReplWrapper::run_interactive() {
    load_history();
    print_welcome({ "core", "stdlib" });

    while (true) {
        const char* input = repl.input("aleste> ");
        if (!input || std::string(input) == "quit") break;

        std::string line(input);
        if (line.empty()) continue;

        execute_line(line);
        add_to_history(line);
    }

    save_history();
    fmt::print(fg(fmt::color::green), "👋 Goodbye!\n");
}

void ReplWrapper::execute_line(const std::string& line) {
    // Встроенные команды REPL
    if (line == "(help)") {
        print_help();
        return;
    }
    if (line == "(keybinds)") {
        print_keybind_help();
        return;
    }
    if (line == "(clear)") {
        clear_screen();
        return;
    }

    // Выполнение Lisp кода
    try {
        auto code = reader.read_from_string(line, "REPL");
        auto result = interpreter.eval(code);
        fmt::print(fg(fmt::color::green), "=> {}\n", result.print());
    }
    catch (const std::exception& e) {
        fmt::print(fg(fmt::color::red), "Error: {}\n", e.what());
    }
}

