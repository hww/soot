(require "../common/sootc/src/lib/builtins.sot")

(define add (lambda ((a int) (b int)) (+ a b)))
(define sub (lambda ((a int) (b int)) (- a b)))

(deftype vector3 (basic) 
    (
        (x  float)
        (y  float)
        (z  float)
    )
    (:methods
        (new () _type_)
        (set (_type_ float float float) none)
    )
    (:states
       idle 
       (goto-position vector3))
)
;
;
(defmethod new vector3 () 
    :dummy-result);
(defmethod delete ((this vector3)) 
    :dummy-result);
(defmethod print ((this vector3)) 
    :dummy-result);
(defmethod inspect ((this vector3)) 
    :dummy-result);
(defmethod length ((this vector3)) 
    0);
(defmethod asize-of ((this vector3)) 
    0);
(defmethod copy ((this vector3)) 
    0);    
(defmethod relocate ((this vector3)) 
    0);    
(defmethod mem-usage ((this vector3)) 
    0);       
(defmethod set ((this vector3) (x float) (y float) (z float)) 
    :dummy-result)

;
(defstate idle (vector3)
  :virtual #t
  :code
    (function ()
       :none)
  :enter (function () :none)
)

(defstate goto-position (vector3)
  :virtual #t
  :code
    (function ((position vector3))
       :none)
  :enter (function () :none)
)