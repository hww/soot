;; ==============================================
;; Add character macro
;; ==============================================

;; $ is a macro character to define labels
(set-macro-character "$"
   (lambda (s c)
      (let ((sym (read s)))
           (lab sym))))


;; [ is a macro character for indirect and indexed adressing modes
;(set-macro-character "["
;   (lambda (s c)
;        (let ((lis (read-delimited-list "]" s)))
;             (ind-reader lis))))

;; Closing macro character for indirect and indexed adressing modes
;(set-macro-character "]" ")")

;; ==============================================
