;; Получаем список всех буферов модуля для передачи в C++
(defun get-module-buffers (mod)
  (let ((buffers '()))
    (for-each (module-segment-order mod)
      (lambda (seg-name)
        (let ((seg (hash-table-ref (module-segments mod) seg-name)))
          (set! buffers (cons (segment-buffer seg) buffers)))))
    (reverse buffers)))

;; Главная функция сохранения "все в одном" (Intel HEX)
(defun save-module-hex (mod &optional (filename #f))
  (let ((path (or filename (fmt #f "{}.hex" (module-name mod))))
        (bufs (get-module-buffers mod)))
    (export-hex path bufs) ;; Наша C++ функция, которую мы обсудили
    (fmt #t "Module {} saved to {} (Intel HEX)\n" (module-name mod) path)))

(defun save-module-layout (mod layout-specs)
  "layout-specs это список вида: ((\"os.hex\" \"CODE\" \"DATA\") (\"drivers.hex\" \"DRV1\"))"
  (dolist (spec layout-specs)
    (let ((filename (car spec))
          (seg-names (cdr spec))
          (buffers-to-save '()))
      ;; Собираем буферы указанных сегментов
      (dolist (name seg-names)
        (let ((seg (hash-table-ref (module-segments mod) name)))
          (set! buffers-to-save (cons (segment-buffer seg) buffers-to-save))))
      
      ;; Шмаляем в HEX
      (export-hex filename (reverse buffers-to-save))
      (format #t "Saved layout -> {} with segments: {}\n" filename seg-names))))