
(defun arg->string (arg)
  "Конвертировать аргумент в строку для записи в листинг файл"
  (if (lextoken? arg)
      (let ((val  (lextoken-value arg))
            (type (lextoken-type arg)))
        (cond 
          ;; 1. Пустые аргументы
          ((or (null? val) (eq? val 'null)) "")
          
          ;; 2. Индексная адресация (IX+d) / (IY+d)
          ((eq? type 'ix-indexed) (fmt #f "(ix{:+})" val))
          ((eq? type 'iy-indexed) (fmt #f "(iy{:+})" val))
          
          ;; 3. Косвенная адресация (HL), (BC) и т.д.
          ((eq? type 'hl-indirect) "(hl)")
          ((eq? type 'bc-indirect) "(bc)")
          ((eq? type 'de-indirect) "(de)")
          ((eq? type 'sp-indirect) "(sp)")
          
          ;; 4. Косвенная адресация по адресу (nn)
          ((eq? type 'imm-indirect) (fmt #f "({:04X}h)" val))
          ((eq? type 'asmsym-indirect) (fmt #f "({})" val))
          
          ;; 5. Обычные числа (в hex для красоты)
          ((integer? val) (fmt #f "{:02X}h" val))
          
          ;; 6. Всё остальное (регистры, метки)
          (#t (fmt #f "{}" val))))
      ""))

(defun inst->string (inst)
  "Конвертировать инструкцию в строку для записи в листинг файл"
  (let ((op (inst-op inst))
        (a1 (arg->string (inst-arg1 inst)))
        (a2 (arg->string (inst-arg2 inst)))
        (a3 (arg->string (inst-arg3 inst))))
    (if (eq? op 'lab)
        (concat "label: " a1)
        (concat (fmt #f "{}" op)
                (if (not (string-empty? a1)) (concat " " a1) "")
                (if (not (string-empty? a2)) (concat ", " a2) "")
                (if (not (string-empty? a3)) (concat ", " a3) "")
                ;"   "
                ;(fmt #f "{}" (inspect inst))
                ))))


;; Вспомогательная функция: берет первые N элементов списка
(defun take (lst n)
  (if (or (null? lst) (<= n 0))
      '()
      (cons (car lst) (take (cdr lst) (- n 1)))))

;; Вспомогательная функция: пропускает первые N элементов списка
(defun drop (lst n)
  (if (or (null? lst) (<= n 0))
      lst
      (drop (cdr lst) (- n 1))))

;; Теперь сама нарезка на куски (chunks)
(defun list-chunks (lst n)
  (if (null? lst)
      '()
      (cons (take lst n) (list-chunks (drop lst n) n))))

;; Форматирует строку байтов в HEX
(defun format-hex-bytes (bytes)
  (let ((str ""))
    (for-each bytes 
      (lambda (b) 
        (set! str (concat str (fmt #f "{:02X} " (logand b #xFF))))))
    str))

(define *listing-dump-width* 8)

(defun make-padding (n)
  (let ((s ""))
    (begin
      (dotimes (i n) (set! s (concat s " ")))
      s)))

(define *listing-dump-width* 8)

;; Вспомогательная функция для создания ровной строки листинга
(defun format-listing-row (addr hex-part source-part width)
  (let* ((hex-col-width (* width 3)) 
         ;; Используем string-length вместо length
         (padding-size (- hex-col-width (string-length hex-part)))
         (padding (make-padding (if (> padding-size 0) padding-size 0))))
    (fmt #f "{:04X} | {}{} | {}\n" addr hex-part padding source-part)))

(defun format-instruction-line (addr bytes src width)
  (let ((chunks (if (null? bytes) (list '()) (list-chunks bytes width)))
        (res ""))
    (begin
      (let ((i 0))
        (for-each chunks
          (lambda (chunk)
            (let* ((b-str (format-hex-bytes chunk))
                   (is-first (= i 0)))
              (begin
                ;; Используем общую функцию для каждой строки чанка
                (set! res (concat res 
                   (format-listing-row addr b-str (if is-first src "") width)))
                (set! i (+ i 1)))))))
      res)))
(defun generate-module-listing (mod &key (print-listing #f) (width *listing-dump-width*))
  (let ((out ""))
    (for-each (module-segment-order mod)
      (lambda (seg-name)
        (let ((seg (hash-table-ref (module-segments mod) seg-name)))
          (set! out (concat out (fmt #f "\n--- Segment: {} | Base: #{:04X} ---\n" 
                                     seg-name (segment-base-addr seg))))
          (for-each (segment-insts seg)
            (lambda (inst)
              (let ((addr (or (inst-ilc inst) 0))
                    (op   (inst-op inst))
                    (src  (inst->string inst)))
                (cond 
                  ;; Случай 1: Метки
                  ((eq? op 'lab)
                   (let ((name (fmt #f "{}:" (lextoken-value (inst-arg1 inst)))))
                     ;; Пустая колонка байтов, но ширина сохраняется
                     (set! out (concat out (format-listing-row addr "" name width)))))
                  
                  ;; Случай 2: Директивы (org, align)
                  ((or (eq? op 'org) (eq? op 'align))
                   (set! out (concat out (format-listing-row addr "--------" src width))))
                  
                  ;; Случай 3: Обычные инструкции и данные
                  (#t
                   (set! out (concat out (format-instruction-line 
                                          addr 
                                          (or (inst-bin inst) '()) 
                                          src 
                                          width)))))))))))
    (if print-listing (print out))
    out))