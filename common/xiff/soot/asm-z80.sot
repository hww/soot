;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;; Bit Set, Reset and Test Group ;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(operand zbit 2
     "BIT b, r"
     :pass3 (begin (print "bla")(list #b11001011 
                  (logior #b01000000 (lshift (logand r1 7) 3)
                                     (reg-code r2))))
     :arg1 number
     :arg2 8-register)

(operand zbit 2
     "BIT b, (HL)"
     :pass3 (list #b11001011 
                  (logior #b01000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 hl-register)

(operand zbit 4
     "BIT b, (IX + d)"
     :pass3 (list #b11011101
                  #b11001011
                  r2
                  (logior #b01000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 ix-indirect)

(operand zbit 4
     "BIT b, (IY + d)"
     :pass3 (list #b11111101
                  #b11001011
                  r2
                  (logior #b01000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 iy-indirect)

(operand zset 2
     "SET b, r"
     :pass3 (list #b11001011 
                  (logior #b11000000 (lshift (logand r1 7) 3)
                                     (reg-code r2)))
     :arg1 number
     :arg2 8-register)

(operand zset 2
     "SET b, (HL)"
     :pass3 (list #b11001011 
                  (logior #b11000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 hl-register)

(operand zset 4
     "SET b, (IX + d)"
     :pass3 (list #b11011101
                  #b11001011
                  r2
                  (logior #b11000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 ix-indirect)

(operand zset 4
     "SET b, (IY + d)"
     :pass3 (list #b11111101
                  #b11001011
                  r2
                  (logior #b11000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 iy-indirect)

(operand res 2
     "RES b, r"
     :pass3 (list #b11001011 
                  (logior #b10000000 (lshift (logand r1 7) 3)
                                     (reg-code r2)))
     :arg1 number
     :arg2 8-register)

(operand res 2
     "RES b, (HL)"
     :pass3 (list #b11001011 
                  (logior #b10000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 hl-register)

(operand res 4
     "RES b, (IX + d)"
     :pass3 (list #b11011101
                  #b11001011
                  r2
                  (logior #b10000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 ix-indirect)

(operand res 4
     "RES b, (IY + d)"
     :pass3 (list #b11111101
                  #b11001011
                  r2
                  (logior #b10000110 (lshift (logand r1 7) 3)))
     :arg1 number
     :arg2 iy-indirect)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;; Jump group ;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; In the first pass, we do not yet know the size or the distance of the jumps.
;; In the second pass, once all symbols are known, we can reasonably determine 
;; the jump distance. Accordingly, the instruction is "mutated" so that it 
;; produces the correct result in the third phase. 
;; If we mutate to a JR (since JR is shorter than JP), all subsequent labels 
;; are shifted by 1 byte. Previously rewritten jumps are not affected, as 
;; they will only receive their final values in the third phase. 
;; However, it is entirely possible that a JMP identified as a long jump 
;; could have been a short jump due to intensive shifting; identifying 
;; such cases, however, is a very hairy problem to solve.

;; PASS 1: Returns initial instruction size
;; PASS 2: Returns instruction size after potential mutations/size changes
;; PASS 3: Returns the actual instruction bytes
(operand jmp 3 "Virtual JMP"
  :arg1 variable
  :pass1 3 ;; Всегда резервируем максимум, чтобы не было сюрпризов
  :pass2 (let* ((target (get-label-addr-optional r1 prog ctx)))
         (if (and target (not (null? target)))
             (let ((offset (- target (+ (get-abs-pc prog) 2))))
               ;(cfmt #t 'yellow "JMP :r1 {} :r2 {} :r3 {} :target {} :offset {}" r1 r2 r3 target offset) 
               (if (and (<= offset 120) (>= offset -120))
                   (begin 
                     (struct-set! inst :op 'jr) 
                     2)
                   (begin
                     (struct-set! inst :op 'jp)
                     3)))
             ;; Если метки НЕТ (target == null), мы НЕ имеем права 
             ;; мутировать в JR, так как не знаем дистанцию.
             ;; Оставляем JP (3 байта) как безопасный вариант.
             (begin
               (struct-set! inst :op 'jp)
               3)))
  :pass3 (error "JMP should have been mutated in Pass 2" inst))

(operand jp 3 "JP nn"
     :relative #f ;; (по умолчанию #f)
     :pass3 (list #xC3 (lower-byte r1) (higher-byte r1))
     :arg1 variable)


(operand jr 2 "JR e"
  :relative #t
  :pass3 (begin
           ;(cfmt #t 'yellow "JR :r1 {}" r1 ) 
           (if (and (<= r1 127) (>= r1 -128))
               (list #x18 (logand r1 #xFF))
               (error (fmt #f "JR out of range: {}" r1) ctx)))
  :arg1 variable)

(operand jr 2
     "JR c, e"
     :pass3 (case r1
                ('c (list #b00111000 (- r2 (asm-prog-ilc prog) 2)))
                ('nc (list #b00110000 (- r2 (asm-prog-ilc prog) 2)))
                ('z (list #b00101000 (- r2 (asm-prog-ilc prog) 2)))
                ('nz (list #b00100000 (- r2 (asm-prog-ilc prog) 2))))
     :arg1 asmsym
     :arg2 variable)

(operand jp 1
     "JP (HL)"
     :pass3 (list #b11101001)
     :arg1 hl-indirect)

(operand jp 2
     "JP (IX)"
     :pass3 (list #b11011101 #b11101001)
     :arg1 ix-indirect)

(operand jp 2
     "JP (IY)"
     :pass3 (list #b11111101 #b11101001)
     :arg1 iy-indirect)

(operand djnz 2 
     "DJNZ e"
     :relative #t
     :pass3 (list #x10 r1)
     :arg1 variable)

(operand call 3
     "CALL nn"
     :pass3 (list #b11001101 (lower-byte r1) (higher-byte r1))
     :arg1 variable)

(operand call 3
     "CALL c, nn"
     :pass3 (list (logior #b11000100 (lshift (con-code r1) 3))
                  (lower-byte r2) (higher-byte r2))
     :arg1 asmsym
     :arg2 variable)

(operand ret 1
     "RET"
     :pass3 (list #b11001001))

(operand ret 1
     "RET c"
     :pass3 (list (logior #b11000000 (lshift (con-code r1) 3)))
     :arg1 asmsym)

(operand reti 2
     "RETI"
     :pass3 (list #b11101101 #b01001101))

(operand retn 2
     "RETN"
     :pass3 (list #b11101101 #b01000101))

(operand rst 1
     "RST p"
     :pass3 (list (logior #b11000111 (lshift (/ r1 8) 3)))
     :arg1 number)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;; Input/Output group ;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(operand in 2
     "IN A, (n)"
     :pass3 (if (eq? r1 'a) (list #b11011011 r2))
     :arg1 8-register
     :arg2 number)

(operand in 2
     "IN r, (C)"
     :pass3 (if (eq? r2 'c)
                (list #b11101101 (logior #b01000000 
                                     (lshift (reg-code r1) 3))))
     :arg1 8-register
     :arg2 8-register)

(operand ini 2
     "INI"
     :pass3 (list #b11101101 #b10100010))

(operand inir 2
     "INIR"
     :pass3 (list #b11101101 #b10110010))

(operand ind 2
     "IND"
     :pass3 (list #b11101101 #b10101010))

(operand indr 2
     "INDR"
     :pass3 (list #b11101101 #b10111010))

(operand out 2
     "OUT (n), A"
     :pass3 (if (eq? r2 'a) (list #b11010011 r1))
     :arg1 number
     :arg2 8-register)

(operand out 2
     "OUT (C), r"
     :pass3 (if (eq? r1 'c)
                (list #b11101101 (logior #b01000001
                                     (lshift (reg-code r2) 3))))
     :arg1 8-register
     :arg2 8-register)

(operand outi 2
     "OUTI"
     :pass3 (list #b11101101 #b10100011))

(operand otir 2
     "OTIR"
     :pass3 (list #b11101101 #b10110011))

(operand outd 2
     "OUTD"
     :pass3 (list #b11101101 #b10101011))

(operand otdr 2
     "OTDR"
     :pass3 (list #b11101101 #b10111011))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;; ASM Dirrectives ;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(operand org 0 "Origin"
  :arg1 number
  :pass1 (begin (asm-prog-origin! prog r1) (asm-prog-ilc! prog r1) 0)
  :pass2 (begin (asm-prog-origin! prog r1) (asm-prog-ilc! prog r1) 0)
  :pass3 (begin (asm-prog-origin! prog r1) (asm-prog-ilc! prog r1) (quote null)))

;; Простой db для чисел и списков
(operand db 1 "Define Byte"
  :arg1 variable
  :pass1 1
  :pass2 1
  :pass3 (list (lower-byte r1))) ;; lower-byte на случай, если r1 — это 16-битный адрес

(operand db 0 "Define Byte" 
  :arg1 list
  :pass1 (length r1)       ;; ВАЖНО: возвращаем длину списка для ILC
  :pass2 (length r1)
  :pass3  r1) ;; Возвращаем список из одного байта

;; dw для чисел и меток
(operand dw 2 "Define Word"
  :arg1 variable ;; Позволяет использовать и числа, и метки
  :pass1 2
  :pass2 2
  :pass3 (let ((val r1)) ;; r1 тут уже будет абсолютным адресом из таблицы
           (list (lower-byte val) 
                 (higher-byte val))))

(operand dw 0 "Define Word List"
  :arg1 list
  :pass1 (* (length r1) 2)   ;; Каждый элемент списка — это 2 байта
  :pass2 (* (length r1) 2)
  :pass3 (let ((output '()))
           (begin
             (mapcar (lambda (item)
                       (let ((val (if (symbol? item) 
                                      (get-label item prog) 
                                      item)))
                         (set! output (append output 
                                              (list (lower-byte val) 
                                                    (higher-byte val))))))
                     r1)
             output)))

;; ds для резервирования места (заполнение нулями)
;; Пример: (ds 10) -> резервирует 10 байт
(operand ds 0 "Define Space (zeros)"
  :arg1 number
  :pass1 r1                 ;; Размер равен значению аргумента
  :pass2 r1
  :pass3 (make-list r1 0))  ;; Генерируем список из r1 нулей

;; ds с указанием значения заполнителя
;; Пример: (ds 10 #xFF) -> резервирует 10 байт, заполненных 255
(operand ds 0 "Define Space (with fill byte)"
  :arg1 number
  :arg2 number
  :pass1 r1                 ;; Размер всё равно r1
  :pass2 r1
  :pass3 (make-list r1 r2)) ;; Список из r1 элементов со значением r2

(operand ascii 0 "Define ASCII string"
  :arg1 string
  :pass1 (string-length r1)
  :pass2 (string-length r1)
  :pass3 (string->list r1))
                   
(operand align 0 "Align ILC to N bytes"
  :arg1 number
  :pass1 (let* ((current-addr (+ (asm-prog-origin prog) (asm-prog-ilc prog)))
                (rem (mod current-addr r1)))
           (if (= rem 0) 
               0 
               (- r1 rem)))
  :pass2 (let* ((current-addr (+ (asm-prog-origin prog) (asm-prog-ilc prog)))
                (rem (mod current-addr r1)))
           (if (= rem 0) 
               0 
               (- r1 rem)))
  :pass3 (let* ((current-addr (+ (asm-prog-origin prog) (asm-prog-ilc prog)))
                (rem (mod current-addr r1))
                (size (if (= rem 0) 0 (- r1 rem))))
           (make-list size 0)))
(fmt #t "Loaded asm-z80\n")
