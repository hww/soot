;; Lextoken types:
;;
;; number
;; 8register, 16register, ix, iy, hl, sp, iv, mr
;; ix-indexed, iy-indexed
;; hl-indirect, bc-indirect, de-indirect, sp-indirect, imm-indirect
;; asmsym, asmsym-indirect

(defun resolve-type-offset (expr)
  "Принимает (-> Type Field) и возвращает числовое смещение"
  (let ((type-name (second expr))
        (field-name (third expr)))
    ;; Вызываем встроенную C++ функцию type-info
    ;; Мы предполагаем, что она возвращает смещение, если передано имя поля
    (let ((offset (type-info type-name field-name)))
      (if offset
          offset
          (error (string-append "Field not found: "
                                (symbol->string field-name)
                                " in type "
                                (symbol->string type-name)))))))



;; =================================================================
(define a   (make-lextoken :type '8-register :value 'a))
(define b   (make-lextoken :type '8-register :value 'b))
(define c   (make-lextoken :type '8-register :value 'c))
(define d   (make-lextoken :type '8-register :value 'd))
(define e   (make-lextoken :type '8-register :value 'e))
(define h   (make-lextoken :type '8-register :value 'h))
(define l   (make-lextoken :type '8-register :value 'l))
(define bc  (make-lextoken :type '16-register :value 'bc))
(define de  (make-lextoken :type '16-register :value 'de))
(define hl  (make-lextoken :type '16-register :value 'hl))
(define sp  (make-lextoken :type '16-register :value 'sp))
(define af  (make-lextoken :type '16-register :value 'af))
(define bc2 (make-lextoken :type '16-register2 :value 'bc2))
(define de2 (make-lextoken :type '16-register2 :value 'de2))
(define hl2 (make-lextoken :type '16-register2 :value 'hl2))
(define af2 (make-lextoken :type '16-register2 :value 'af2))
(define rv  (make-lextoken :type 'rv-register :value 'rv))
(define ix  (make-lextoken :type 'ix-register :value 'ix))
(define iy  (make-lextoken :type 'iy-register :value 'iy))
(define iv  (make-lextoken :type 'iv-register :value 'iv))
(define mr  (make-lextoken :type 'mr-register :value 'mr))

;; Функции для косвенной адресации
(defun @hl () (make-lextoken :type 'hl-indirect))
(defun @bc () (make-lextoken :type 'bc-indirect))
(defun @de () (make-lextoken :type 'de-indirect))
(defun @sp () (make-lextoken :type 'sp-indirect))

;; Функции для индексированной адресации
;;  (ld a (@hl))      ;; LD A, (HL)
;;  (ld a (@+ ix 5))  ;; LD A, (IX+5)
;;  (ld (@+ iy 10) a) ;; LD (IY+10), A
(defun @+ (reg offset)
  (make-lextoken 
    :type (case reg
            ('ix 'ix-indexed)
            ('iy 'iy-indexed)
            ('r13 'r13-indexed)
            ('r14 'r14-indexed)
            (else (error (fmt #f "Unknown index register: {}" reg))))
    :value offset))

(defun @- (reg offset)
  (@+ reg (- offset)))

;; 1. Определяем функцию +i
(defun +i (reg offset)
  (make-lextoken 
    :type (case reg
            ('ix 'ix-indexed)
            ('iy 'iy-indexed)
            ('r13 'r13-indexed)
            ('r14 'r14-indexed)
            (else (error (fmt #f "Unknown index register: {}" reg))))
    :value offset))

;; 2. Вспомогательные функции для регистров
(defun get-low-reg (reg)
  (case reg
    ('hl 'l)
    ('de 'e)
    ('bc 'c)
    (else (error (fmt #f "Unknown 16-bit register: {}" reg)))))

(defun get-high-reg (reg)
  (case reg
    ('hl 'h)
    ('de 'd)
    ('bc 'b)
    (else (error (fmt #f "Unknown 16-bit register: {}" reg)))))

;;; make-indexed (sign reg val)
;;; ---------------------------
;;; Создает токен индексированной адресации для регистров IX или IY.
;;; Поддерживает смещение (displacement), которое может быть выражением.
;;;
;;; Аргументы:
;;;   SIGN : Символ '+' или '-', определяющий направление смещения.
;;;   REG  : Токен регистра IX или IY.
;;;   VAL  : Число или Lisp-выражение, возвращающее смещение (0-255).
;;;
;;; Логика:
;;;   Вычисляет финальное значение через (eval val). Если SIGN это '-',
;;;   значение инвертируется.
;;;
;;; Примеры:
;;;   [+ ix 10]          -> Результат: ix-indexed с value 10  => (IX+10)
;;;   [- iy (-> Sp x)]   -> Результат: iy-indexed с value -offset => (IY-offset)
;;;
;;; Примечание: В Z80 смещение IX/IY — это знаковое 8-битное число (-128..127).
(defun make-indexed (sign reg val)
   "Create an indexed lextoken"
   (let ((val (if (eq? sign '+) (eval val) (- 0 (eval val))))
         ;; Если reg - символ, пытаемся понять какой. Если токен - берем его тип.
         (r-type (if (lextoken? reg) 
                     (lextoken-type reg) 
                     reg))) 
        (case r-type
           ('ix (make-lextoken :type 'ix-indexed :value val))
           ('iy (make-lextoken :type 'iy-indexed :value val))
           (else (error "Unknown index register: {}" reg)))))

;;;; ==========================================================================
;;;; Z80 Indirect Addressing & Indexing Parser
;;;; ==========================================================================

;;; ind-reader (lis)
;;; -----------------
;;; Разбирает содержимое внутри круглых скобок для косвенной адресации.
;;; Вызывается, когда парсер встречает конструкцию ( ... ) в операндах.
;;;
;;; Аргумент LIS: Список элементов внутри скобок.
;;;
;;; Примеры входных данных и поведение:
;;;   [1234]       -> LIS: (1234)
;;;                   FIRST: 1234 (fixnump)
;;;                   Результат: imm-indirect -> LD A, (1234)
;;;
;;;   [hl]         -> LIS: (#<lextoken hl>)
;;;                   FIRST: #<lextoken> (typep lextoken)
;;;                   Результат: hl-indirect -> LD (HL), A
;;;
;;;   [+ ix 5]     -> LIS: (+ #<lextoken ix> 5)
;;;                   FIRST: + (символ операции)
;;;                   Результат: Передает управление в make-indexed
;;;
;;;   [MY_LABEL]   -> LIS: (MY_LABEL)
;;;                   FIRST: MY_LABEL (symbol?)
;;;                   Результат: asmsym-indirect (адрес будет разрешен позже)
;; В ind-reader добавить обработку r13/r14
(defun ind-reader (lis)
  "Read indirect addressing modes"
  (let ((first (car lis)))
    (cond 
      ((integer? first)
        (make-lextoken :type 'imm-indirect :value first))
      ((or (eq? '+ first) (eq? '- first))
        (apply 'make-indexed lis))
      ;; Обработка символов (hl, bc, de, sp)
      ((symbol? first)
        (case first
          ('hl (make-lextoken :type 'hl-indirect))
          ('bc (make-lextoken :type 'bc-indirect))
          ('de (make-lextoken :type 'de-indirect))
          ('sp (make-lextoken :type 'sp-indirect))
          ;; Для r13/r14 тоже нужно добавить
          ('r13 (make-lextoken :type 'r13-indirect))
          ('r14 (make-lextoken :type 'r14-indirect))
          ;; Любой другой символ - это метка
          (else (make-lextoken :type 'asmsym-indirect :value first))))
      ;; Если передали уже lextoken (из переменной hl)
      ((lextoken? first)
        (case (lextoken-value first)
          ('hl (make-lextoken :type 'hl-indirect))
          ('bc (make-lextoken :type 'bc-indirect))
          ('de (make-lextoken :type 'de-indirect))
          ('sp (make-lextoken :type 'sp-indirect))
          (else (error (fmt #f "Unsupported indirect register: {}" first) lis))))
      (else 
        (error (fmt #f "Invalid indirect addressing: {}" lis) lis)))))

;; z80 register codes, needed often during instruction assembling
(define *reg-codes* (make-hash-table '() 11))

(defmacro reg-code (reg)
   `(hash-table-ref *reg-codes* ,reg))

(defmacro reg-code! (reg value)
   `(hash-table-set! *reg-codes* ,reg ,value))

(reg-code! 'a 7)
(reg-code! 'b 0)
(reg-code! 'c 1)
(reg-code! 'd 2)
(reg-code! 'e 3)
(reg-code! 'h 4)
(reg-code! 'l 5)
(reg-code! 'bc 0)
(reg-code! 'de 1)
(reg-code! 'hl 2)
(reg-code! 'sp 3)
(reg-code! 'af 3)

; z80 condition codes, needed often during instruction assembling
(define *con-codes* (make-hash-table))

(defmacro con-code (reg)
   `(hash-table-ref *con-codes* ,reg))
(defmacro con-code! (reg value)
   `(hash-table-set! *con-codes* ,reg ,value))

(con-code! 'nz 0)
(con-code! 'z 1)
(con-code! 'nc 2)
(con-code! 'c 3)
(con-code! 'pe 4)
(con-code! 'po 5)
(con-code! 'p 6)
(con-code! 'm 7)

(defun parse-z80 (arg ctx)
     ;(error "sss" ctx)
  (cond
    ((lextoken? arg) arg)
     ;; Обработка списка (hl) как индексированной адресации
    ((and (list? arg) (= (length arg) 1) (lextoken? (car arg)))
     (let ((token (car arg)))
       (if (member (lextoken-value token) '(hl bc de sp))
           (ind-reader (list token))
           arg)))


((type? arg 'native-ref)
 (let ((b-size (-> arg .bit_size))
       (offs   (-> arg .offset))
       (base   (-> arg .reg)))
   ;; Для отладки:
   (fmt #t "PARSE native-ref: base={} offset={} bits={}\n" base offs b-size)
   
   ;; ВАЖНО: Возвращаем ТОЛЬКО ОДНО значение!
   (cond
     ;; 1. Для R13/R14 - создаем специальные токены
     ((member base '(r13 r14))
      (make-lextoken :type (if (eq? base 'r13) 'r13-indexed 'r14-indexed)
                     :value offs))
     
     ;; 2. Для битовых полей (bits=1) - число
     ((= b-size 1)
      (make-lextoken :type 'number :value (-> arg .bit_offset)))
     
     ;; 3. Для 8-битных данных в памяти - indexed-addr
     ((= b-size 8)
      (make-lextoken :type 'indexed-addr :value (list base offs)))
     
     ;; 4. Для 16-битных данных - список для макроса
     ((= b-size 16)
      (list base offs))  ;; Будет использовано макросом ld-16-from-mem
     
     ;; 5. Для регистров (offset=0) - обычный регистр
     ((= offs 0)
      (make-lextoken :type (if (>= b-size 16) '16-register '8-register) 
                     :value base))
     
     ;; 6. Все остальное - ошибка
     (else
      (error (fmt #f "Unsupported native-ref: base={} offset={} bits={}" 
                  base offs b-size) ctx)))))

    ((symbol? arg)
     (let ((type (cond 
                   ((hash-table-contains? *reg-codes* arg) '8-register)
                   ((hash-table-contains? *con-codes* arg) 'condition)
                   (else 'asmsym))))
       (make-lextoken :type type :value arg)))

    ((number? arg) (make-lextoken :type 'number :value arg))
    ((null? arg)   (make-lextoken :type null))
    (else          (make-lextoken :type 'unknown :value arg))))

  
; Set the assembler parse function to be parse-z80
(set! *parse* parse-z80)

(defun lzasm-z80 (module seg-name &rest insts)
  "Наполняет сегмент в модуле, создавая его при необходимости"
  (let* ((segments-map (module-segments module)))
    ;; Сначала проверяем, существует ли сегмент
    (if (not (hash-table-contains? segments-map seg-name))
        ;; Если нет — создаем его через твой segment-select-segment (он умеет регистрировать)
        (segment-select-segment module seg-name))
    
    (let ((seg (hash-table-ref segments-map seg-name)))
      (begin
        ;; Наполняем инструкциями
        (setf (segment-insts seg) (flatten insts))
        seg))))
      
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;; 8-Bit Load group ;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- Группа 8-bit Load ---

(operand ld 1 "LD r, r'"
     :arg1 8-register :arg2 8-register
     :pass3 (list (logior #x40 (lshift (reg-code r1) 3) (reg-code r2))))

(operand ld 2 "LD r, n"
     :arg1 8-register :arg2 number
     :pass3 (list (logior #x06 (lshift (reg-code r1) 3)) r2))

;; --- Косвенная адресация (HL, IX, IY) ---

(operand ld 1 "LD r, (HL)"
     :arg1 8-register :arg2 hl-indirect
     :pass3 (list (logior #x46 (lshift (reg-code r1) 3))))

(operand ld 3 "LD r, (IX + d)"
     :arg1 8-register :arg2 ix-indexed
     :pass3 (list #xDD (logior #x46 (lshift (reg-code r1) 3)) r2)) 

(operand ld 3 "LD r, (IY + d)"
     :arg1 8-register :arg2 iy-indexed
     :pass3 (list #xFD (logior #x46 (lshift (reg-code r1) 3)) r2)) 

(operand ld 1 "LD (HL), r"
     :arg1 hl-indirect :arg2 8-register
     :pass3 (list (logior #x70 (reg-code r2))))

(operand ld 3 "LD (IX + d), r"
     :arg1 ix-indexed :arg2 8-register
     :pass3 (list #xDD (logior #x70 (reg-code r2)) r1))

(operand ld 3 "LD (IY + d), r"
     :arg1 iy-indexed :arg2 8-register
     :pass3 (list #xFD (logior #x70 (reg-code r2)) r1))

(operand ld 2 "LD (HL), n"
     :arg1 hl-indirect :arg2 number
     :pass3 (list #x36 r2))

(operand ld 4 "LD (IX + d), n"
     :arg1 ix-indexed :arg2 number
     :pass3 (list #xDD #x36 r1 r2))

(operand ld 4 "LD (IY + d), n"
     :arg1 iy-indexed :arg2 number ;; исправлен тип на iy-indexed
     :pass3 (list #xFD #x36 r1 r2))

;; --- Аккумулятор и (BC), (DE), (nn) ---

(operand ld 1 "LD A, (BC)"
     :arg1 8-register :arg2 bc-indirect
     :pass3 (if (eq? r1 'a) '(#x0A) (error "Only LD A, (BC) is allowed" ctx)))

(operand ld 1 "LD A, (DE)"
     :arg1 8-register :arg2 de-indirect
     :pass3 (if (eq? r1 'a) '(#x1A) (error "Only LD A, (DE) is allowed" ctx)))

(operand ld 3 "LD A, (nn)"
     :arg1 8-register :arg2 var-indirect
     :pass3 (if (eq? r1 'a)
                (let ((addr (get-addr r2 seg ctx)))
                  (list #x3A (lower-byte addr) (higher-byte addr)))
                (error "Only LD A, (nn) is allowed" ctx)))

(operand ld 1 "LD (BC), A"
     :arg1 bc-indirect :arg2 8-register
     :pass3 (if (eq? r2 'a) '(#x02) (error "Only LD (BC), A is allowed" ctx)))

(operand ld 1 "LD (DE), A"
     :arg1 de-indirect :arg2 8-register
     :pass3 (if (eq? r2 'a) '(#x12) (error "Only LD (DE), A is allowed" ctx)))

(operand ld 3 "LD (nn), A"
     :arg1 var-indirect :arg2 8-register
     :pass3 (if (eq? r2 'a)
                (let ((addr (get-addr r1 seg ctx)))
                  (list #x32 (lower-byte addr) (higher-byte addr)))
                (error "Only LD (nn), A is allowed" ctx)))

;; --- Специальные регистры (I, R) ---

(operand ld 2 "LD A, I" 
     :arg1 8-register :arg2 iv-register
     :pass3 (if (eq? r1 'a) '(#xED #x57) (error "Target must be A" ctx)))

(operand ld 2 "LD A, R"
     :arg1 8-register :arg2 mr-register
     :pass3 (if (eq? r1 'a) '(#xED #x5F) (error "Target must be A" ctx)))

(operand ld 2 "LD I, A"
     :arg1 iv-register :arg2 8-register
     :pass3 (if (eq? r2 'a) '(#xED #x47) (error "Source must be A" ctx)))

(operand ld 2 "LD R, A"
     :arg1 mr-register :arg2 8-register
     :pass3 (if (eq? r2 'a) '(#xED #x4F) (error "Source must be A" ctx)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;; 16-Bit Load group ;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- 16-bit Immediate Load ---

(operand ld 3 "LD dd, nn"
     :arg1 16-register :arg2 variable
     :pass3 (let ((val (get-addr r2 seg ctx)))
              (list (logior #x01 (lshift (reg-code r1) 4))
                    (lower-byte val) (higher-byte val))))

(operand ld 4 "LD IX, nn"
     :arg1 ix-register :arg2 variable
     :pass3 (let ((val (get-addr r2 seg ctx)))
              (list #xDD #x21 (lower-byte val) (higher-byte val))))

(operand ld 4 "LD IY, nn"
     :arg1 iy-register :arg2 variable
     :pass3 (let ((val (get-addr r2 seg ctx)))
              (list #xFD #x21 (lower-byte val) (higher-byte val))))

;; --- 16-bit Memory Loads ---

;; Специальный случай для HL (оптимизированная команда 3 байта вместо 4)
(operand ldhl 3 "LD HL, (nn)"
     :arg1 16-register :arg2 var-indirect
     :pass3 (if (eq? r1 'hl)
                (let ((addr (get-addr r2 seg ctx)))
                  (list #x2A (lower-byte addr) (higher-byte addr)))
                (error "Internal error: ldhl called not for HL" ctx)))

(operand ld 4 "LD dd, (nn)"
     :arg1 16-register :arg2 var-indirect
     :pass1 (if (eq? r1 'hl)
                (begin 
                   (struct-set! inst :op 'ldhl) ;; исправлено: меняем :op в структуре inst
                   3)
                4)
     :pass3 (let ((addr (get-addr r2 seg ctx)))
              (list #xED (logior #x4B (lshift (reg-code r1) 4)) 
                    (lower-byte addr) (higher-byte addr))))

(operand ld 4 "LD IX, (nn)"
     :arg1 ix-register :arg2 var-indirect
     :pass3 (let ((addr (get-addr r2 seg ctx)))
              (list #xDD #x2A (lower-byte addr) (higher-byte addr))))

(operand ld 4 "LD IY, (nn)"
     :arg1 iy-register :arg2 var-indirect
     :pass3 (let ((addr (get-addr r2 seg ctx)))
              (list #xFD #x2A (lower-byte addr) (higher-byte addr))))

;; --- 16-bit Memory Stores ---

(operand ld 3 "LD (nn), HL"
     :arg1 var-indirect :arg2 16-register ;; добавил arg2 для порядка
     :pass3 (if (eq? r2 'hl)
                (let ((addr (get-addr r1 seg ctx)))
                  (list #x22 (lower-byte addr) (higher-byte addr)))
                (error "Use LD (nn), dd for non-HL registers" ctx)))

(operand ld 4 "LD (nn), dd"
     :arg1 var-indirect :arg2 16-register
     :pass3 (let ((addr (get-addr r1 seg ctx)))
              (list #xED (logior #x43 (lshift (reg-code r2) 4))
                    (lower-byte addr) (higher-byte addr))))

(operand ld 4 "LD (nn), IX"
     :arg1 var-indirect :arg2 ix-register
     :pass3 (let ((addr (get-addr r1 seg ctx)))
              (list #xDD #x22 (lower-byte addr) (higher-byte addr))))

(operand ld 4 "LD (nn), IY"
     :arg1 var-indirect :arg2 iy-register
     :pass3 (let ((addr (get-addr r1 seg ctx)))
              (list #xFD #x22 (lower-byte addr) (higher-byte addr))))

;; --- Stack Pointer Loads ---

(operand ld 1 "LD SP, HL"
     :arg1 sp-register :arg2 16-register ;; HL - это 16-register
     :pass3 (if (eq? r2 'hl) '(#xF9) (error "Source must be HL" ctx)))

(operand ld 2 "LD SP, IX"
     :arg1 sp-register :arg2 ix-register
     :pass3 '(#xDD #xF9))

(operand ld 2 "LD SP, IY"
     :arg1 sp-register :arg2 iy-register
     :pass3 '(#xFD #xF9))

;; --- PUSH / POP ---

(operand zpush 1 "PUSH qq"
     :arg1 16-register
     :pass3 (list (logior #xC5 (lshift (reg-code r1) 4))))

(operand zpush 2 "PUSH IX"
     :arg1 ix-register
     :pass3 '(#xDD #xE5))

(operand zpush 2 "PUSH IY"
     :arg1 iy-register
     :pass3 '(#xFD #xE5))

(operand zpop 1 "POP qq"
     :arg1 16-register
     :pass3 (list (logior #xC1 (lshift (reg-code r1) 4))))

(operand zpop 2 "POP IX"
     :arg1 ix-register
     :pass3 '(#xDD #xE1))

(operand zpop 2 "POP IY"
     :arg1 iy-register
     :pass3 '(#xFD #xE1))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; Exchange, Block Transfer, and Search Group ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- Exchange Instructions ---

(operand ex 1 "EX DE, HL"
     :arg1 16-register :arg2 16-register
     :pass3 (if (and (eq? r1 'de) (eq? r2 'hl))
                '(#xEB)
                (error "Invalid arguments for EX. Expected DE, HL" ctx)))

(operand ex 1 "EX AF, AF'"
     :arg1 16-register :arg2 16-register2
     :pass3 (if (and (eq? r1 'af) (eq? r2 'af2))
                '(#x08)
                (error "Invalid arguments for EX. Expected AF, AF'" ctx)))

(operand exx 1 "EXX"
     :pass3 '(#xD9))

(operand ex 1 "EX (SP), HL"
     :arg1 sp-indirect :arg2 16-register
     :pass3 (if (eq? r2 'hl) 
                '(#xE3)
                (error "Target for EX (SP) must be HL, IX, or IY" ctx)))

(operand ex 2 "EX (SP), IX"
     :arg1 sp-indirect :arg2 ix-register
     :pass3 '(#xDD #xE3))

(operand ex 2 "EX (SP), IY"
     :arg1 sp-indirect :arg2 iy-register
     :pass3 '(#xFD #xE3))

;; --- Block Transfer Group ---

(operand ldi 2 "LDI"
     :pass3 '(#xED #xA0))

(operand ldir 2 "LDIR"
     :pass3 '(#xED #xB0))

(operand ldd 2 "LDD"
     :pass3 '(#xED #xA8))

(operand lddr 2 "LDDR"
     :pass3 '(#xED #xB8))

;; --- Block Search Group ---

(operand cpi 2 "CPI"
     :pass3 '(#xED #xA1))

(operand cpir 2 "CPIR"
     :pass3 '(#xED #xB1))

(operand cpd 2 "CPD"
     :pass3 '(#xED #xA9))

(operand cpdr 2 "CPDR"
     :pass3 '(#xED #xB9))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;; 8-bit Arithmetic Group ;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- 8-bit Arithmetic (ADD, ADC, SUB, SBC) ---

(operand add 1 "ADD A, r"
     :arg1 8-register :arg2 8-register
     :pass3 (if (eq? r1 'a) (list (logior #x80 (reg-code r2))) (error "Dest must be A" ctx)))

(operand add 2 "ADD A, n"
     :arg1 8-register :arg2 number
     :pass3 (if (eq? r1 'a) (list #xC6 r2) (error "Dest must be A" ctx)))

(operand add 1 "ADD A, (HL)"
     :arg1 8-register :arg2 hl-indirect
     :pass3 (if (eq? r1 'a) '(#x86) (error "Dest must be A" ctx)))

(operand add 3 "ADD A, (IX + d)"
     :arg1 8-register :arg2 ix-indirect
     :pass3 (if (eq? r1 'a) (list #xDD #x86 r2) (error "Dest must be A" ctx)))

(operand add 3 "ADD A, (IY + d)"
     :arg1 8-register :arg2 iy-indirect
     :pass3 (if (eq? r1 'a) (list #xFD #x86 r2) (error "Dest must be A" ctx)))

;; ADC и SBC аналогично, но с масками #x88 и #x98
(operand adc 1 "ADC A, r"
     :arg1 8-register :arg2 8-register
     :pass3 (if (eq? r1 'a) (list (logior #x88 (reg-code r2))) (error "Dest must be A" ctx)))

(operand sub 1 "SUB r"
     :arg1 8-register ;; Здесь r1 — это то, что вычитаем (A подразумевается)
     :pass3 (list (logior #x90 (reg-code r1))))

(operand sub 2 "SUB n"
     :arg1 number
     :pass3 (list #xD6 r1))

(operand sub 1 "SUB (HL)"
     :arg1 hl-indirect
     :pass3 '(#x96))

(operand sbc 1 "SBC A, r"
     :arg1 8-register :arg2 8-register
     :pass3 (if (eq? r1 'a) (list (logior #x98 (reg-code r2))) (error "Dest must be A" ctx)))

;; --- Logical Group (AND, OR, XOR, CP) ---

(operand zand 1 "AND r"
     :arg1 8-register :pass3 (list (logior #xA0 (reg-code r1))))

(operand zand 2 "AND n"
     :arg1 number :pass3 (list #xE6 r1))

(operand zor 1 "OR r"
     :arg1 8-register :pass3 (list (logior #xB0 (reg-code r1))))

(operand zor 2 "OR n"
     :arg1 number :pass3 (list #xF6 r1))

(operand xor 1 "XOR r"
     :arg1 8-register :pass3 (list (logior #xA8 (reg-code r1))))

(operand xor 2 "XOR n"
     :arg1 number :pass3 (list #xEE r1))

(operand cp 1 "CP r"
     :arg1 8-register :pass3 (list (logior #xB8 (reg-code r1))))

(operand cp 2 "CP n"
     :arg1 number :pass3 (list #xFE r1))

(operand cp 1 "CP (HL)"
     :arg1 hl-indirect :pass3 '(#xBE))

(operand cp 3 "CP (IX + d)"
     :arg1 ix-indirect :pass3 (list #xDD #xBE r1))

;; --- Increment / Decrement ---

(operand inc 1 "INC r"
     :arg1 8-register
     :pass3 (list (logior #x04 (lshift (reg-code r1) 3))))

(operand inc 1 "INC (HL)"
     :arg1 hl-indirect :pass3 '(#x34))

(operand inc 3 "INC (IX + d)"
     :arg1 ix-indirect :pass3 (list #xDD #x34 r1))

(operand dec 1 "DEC r"
     :arg1 8-register
     :pass3 (list (logior #x05 (lshift (reg-code r1) 3))))

(operand dec 1 "DEC (HL)"
     :arg1 hl-indirect :pass3 '(#x35))

(operand dec 3 "DEC (IX + d)"
     :arg1 ix-indirect :pass3 (list #xDD #x35 r1))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; General-purpose Arithmetic and CPU Control Group ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- Arithmetic & CPU Control ---

(operand daa 1 "Decimal Adjust Accumulator"
     :pass3 '(#x27))

(operand cpl 1 "Complement Accumulator (NOT)"
     :pass3 '(#x2F))

(operand neg 2 "Negate Accumulator (2's complement)"
     :pass3 '(#xED #x44))

(operand ccf 1 "Complement Carry Flag"
     :pass3 '(#x3F))

(operand scf 1 "Set Carry Flag"
     :pass3 '(#x37))

;; --- System Control ---

(operand nop 1 "No Operation"
     :pass3 '(#x00))

(operand halt 1 "Halt CPU"
     :pass3 '(#x76))

(operand di 1 "Disable Interrupts"
     :pass3 '(#xF3))

(operand ei 1 "Enable Interrupts"
     :pass3 '(#xFB))

;; --- Interrupt Mode ---

(operand im 2 "Interrupt Mode (0, 1, 2)"
     :arg1 number
     :pass3 (list #xED
                  (case r1
                    ((0) #x46)
                    ((1) #x56)
                    ((2) #x5E)
                    (else (error (fmt #f "Invalid Interrupt Mode: {}" r1) ctx)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;; 16-bit Arithmetic Group ;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- 16-bit Addition ---

(operand add 1 "ADD HL, ss"
     :arg1 16-register :arg2 16-register
     :pass3 (if (eq? r1 'hl)
                (list (logior #x09 (lshift (reg-code r2) 4)))
                (error "Dest must be HL for 16-bit ADD" ctx)))

(operand adc 2 "ADC HL, ss"
     :arg1 16-register :arg2 16-register
     :pass3 (if (eq? r1 'hl)
                (list #xED (logior #x4A (lshift (reg-code r2) 4)))
                (error "Dest must be HL" ctx)))

(operand sbc 2 "SBC HL, ss"
     :arg1 16-register :arg2 16-register
     :pass3 (if (eq? r1 'hl)
                (list #xED (logior #x42 (lshift (reg-code r2) 4)))
                (error "Dest must be HL" ctx)))

(operand add 2 "ADD IX, pp"
     :arg1 ix-register :arg2 16-register
     :pass3 (list #xDD (logior #x09 (lshift (reg-code r2) 4))))

(operand add 2 "ADD IY, pp"
     :arg1 iy-register :arg2 16-register
     :pass3 (list #xFD (logior #x09 (lshift (reg-code r2) 4))))

;; --- 16-bit Inc/Dec ---

(operand inc 1 "INC ss"
     :arg1 16-register
     :pass3 (list (logior #x03 (lshift (reg-code r1) 4))))

(operand inc 2 "INC IX"
     :arg1 ix-register
     :pass3 '(#xDD #x23))

(operand inc 2 "INC IY"
     :arg1 iy-register
     :pass3 '(#xFD #x23))

(operand dec 1 "DEC ss"
     :arg1 16-register
     :pass3 (list (logior #x0B (lshift (reg-code r1) 4))))

(operand dec 2 "DEC IX"
     :arg1 ix-register
     :pass3 '(#xDD #x2B))

(operand dec 2 "DEC IY"
     :arg1 iy-register
     :pass3 '(#xFD #x2B))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;; Rotate and shift group ;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; --- Fast Accumulator Rotates ---

(operand rlca 1 "Rotate Left Circular Accumulator" :pass3 '(#x07))
(operand rla  1 "Rotate Left Accumulator (through Carry)" :pass3 '(#x17))
(operand rrca 1 "Rotate Right Circular Accumulator" :pass3 '(#x0F))
(operand rra  1 "Rotate Right Accumulator (through Carry)" :pass3 '(#x1F))

;; --- CB-prefix Rotates (RLC, RL, RRC, RR) ---

(operand rlc 2 "RLC r"
     :arg1 8-register :pass3 (list #xCB (logior #x00 (reg-code r1))))

(operand rlc 2 "RLC (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x06))

(operand rlc 4 "RLC (IX + d)"
     :arg1 ix-indexed :pass3 (list #xDD #xCB r1 #x06))

(operand rlc 4 "RLC (IY + d)"
     :arg1 iy-indexed :pass3 (list #xFD #xCB r1 #x06))

(operand rl 2 "RL r"
     :arg1 8-register :pass3 (list #xCB (logior #x10 (reg-code r1))))

(operand rl 2 "RL (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x16))

(operand rl 4 "RL (IX + d)"
     :arg1 ix-indexed :pass3 (list #xDD #xCB r1 #x16))

(operand rrc 2 "RRC r"
     :arg1 8-register :pass3 (list #xCB (logior #x08 (reg-code r1))))

(operand rrc 2 "RRC (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x0E))

(operand rr 2 "RR r"
     :arg1 8-register :pass3 (list #xCB (logior #x18 (reg-code r1))))

(operand rr 2 "RR (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x1E))

;; --- Shifts (SLA, SRA, SRL) ---

(operand sla 2 "SLA r"
     :arg1 8-register :pass3 (list #xCB (logior #x20 (reg-code r1))))

(operand sla 2 "SLA (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x26))

(operand sra 2 "SRA r"
     :arg1 8-register :pass3 (list #xCB (logior #x28 (reg-code r1))))

(operand sra 2 "SRA (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x2E))

(operand srl 2 "SRL r"
     :arg1 8-register :pass3 (list #xCB (logior #x38 (reg-code r1))))

(operand srl 2 "SRL (HL)"
     :arg1 hl-indirect :pass3 '(#xCB #x3E))

;; --- BCD Rotates (RLD, RRD) ---

(operand rld 2 "Rotate Left Decimal" :pass3 '(#xED #x6F))
(operand rrd 2 "Rotate Right Decimal" :pass3 '(#xED #x67))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;; Bit Set, Reset and Test Group ;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- BIT: Тестирование бита ---

(operand zbit 2 "BIT b, r"
     :arg1 number :arg2 8-register
     :pass3 (list #xCB (logior #x40 (lshift (logand r1 7) 3) (reg-code r2))))

(operand zbit 2 "BIT b, (HL)"
     :arg1 number :arg2 hl-indirect
     :pass3 (list #xCB (logior #x46 (lshift (logand r1 7) 3))))

(operand zbit 4 "BIT b, (IX + d)"
     :arg1 number :arg2 ix-indexed
     :pass3 (list #xDD #xCB r2 (logior #x46 (lshift (logand r1 7) 3))))

(operand zbit 4 "BIT b, (IY + d)"
     :arg1 number :arg2 iy-indexed
     :pass3 (list #xFD #xCB r2 (logior #x46 (lshift (logand r1 7) 3))))

;; --- SET: Установка бита в 1 ---

(operand zset 2 "SET b, r"
     :arg1 number :arg2 8-register
     :pass3 (list #xCB (logior #xC0 (lshift (logand r1 7) 3) (reg-code r2))))

(operand zset 2 "SET b, (HL)"
     :arg1 number :arg2 hl-indirect
     :pass3 (list #xCB (logior #xC6 (lshift (logand r1 7) 3))))

(operand zset 4 "SET b, (IX + d)"
     :arg1 number :arg2 ix-indexed
     :pass3 (list #xDD #xCB r2 (logior #xC6 (lshift (logand r1 7) 3))))

(operand zset 4 "SET b, (IY + d)"
     :arg1 number :arg2 iy-indexed
     :pass3 (list #xFD #xCB r2 (logior #xC6 (lshift (logand r1 7) 3))))

;; --- RES: Сброс бита в 0 ---

(operand res 2 "RES b, r"
     :arg1 number :arg2 8-register
     :pass3 (list #xCB (logior #x80 (lshift (logand r1 7) 3) (reg-code r2))))

(operand res 2 "RES b, (HL)"
     :arg1 number :arg2 hl-indirect
     :pass3 (list #xCB (logior #x86 (lshift (logand r1 7) 3))))

(operand res 4 "RES b, (IX + d)"
     :arg1 number :arg2 ix-indexed
     :pass3 (list #xDD #xCB r2 (logior #x86 (lshift (logand r1 7) 3))))

(operand res 4 "RES b, (IY + d)"
     :arg1 number :arg2 iy-indexed
     :pass3 (list #xFD #xCB r2 (logior #x86 (lshift (logand r1 7) 3))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;; Jump group ;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; In the first pass, we do not yet know the size or the distance of the jumps.
;; In the second pass, once all symbols are known, we can reasonably determine 
;; the jump distance. Accordingly, the instruction is "mutated" so that it 
;; produces the correct result in the third phase. 
;; If we mutate to a JR (since JR is shorter than JP), all subsequent labels 
;; are shifted by 1 byte. Previously rewritten jumps are not affected, as 
;; they will only receive their final values in the third phase. 
;; However, it is entirely possible that a JMP identified as a long jump 
;; could have been a short jump due to intensive shifting; identifying 
;; such cases, however, is a very hairy problem to solve.

;; PASS 1: Returns initial instruction size
;; PASS 2: Returns instruction size after potential mutations/size changes
;; PASS 3: Returns the actual instruction bytes
;; --- Умная мутация JMP ---
(operand jmp 3 "Virtual JMP (JP or JR)"
  :arg1 variable
  :pass1 3 
  :pass2 (let* ((target (segment-get-label-addr-optional r1 seg ctx)))
         (if (and target (not (null? target)))
             (let ((offset (- target (+ (segment-get-abs-pc seg) 2))))
               ;(cfmt #t "yellow" "JMP target {} offset {}\n" target offset)
               (if (and (<= offset 120) (>= offset -120))
                   (begin (inst-op! inst 'jr) 2)
                   (begin (inst-op! inst 'jp) 3)))
             (begin (inst-op! inst 'jp) 3)))
  :pass3 (error "JMP should have been mutated in Pass 2" inst))

;; --- Unconditional Jumps ---

(operand jp 3 "JP nn"
     :arg1 variable
     :pass3 (let ((addr (get-addr r1 seg ctx)))
              (list #xC3 (lower-byte addr) (higher-byte addr))))

(operand jr 2 "JR e"
  :arg1 variable :relative #t
  :pass3 (let ((rel (segment-get-rel-offset r1 seg ctx 2))) ;; 2 — это размер JR
           ;(cfmt #t "yellow" "JR r1 {} rel {:04X} seg {}\n" r1 rel (segment-name seg))

           (list #x18 rel)))

;; --- Conditional Jumps ---

(operand jr 2 "JR cc, e"
  :arg1 asmsym :arg2 variable :relative #t
  :pass3 (let ((rel (segment-get-rel-offset r2 seg ctx 2))
               (code (case r1 
                       ('nz #x20) ('z #x28) ('nc #x30) ('c #x38)
                       (else (error "Invalid JR condition" r1)))))
           (list code rel)))

(operand jp 3 "JP cc, nn"
     :arg1 asmsym :arg2 variable
     :pass3 (let ((addr (get-addr r2 seg ctx))
                  (code (logior #xC2 (lshift (cond-code r1) 3))))
              (list code (lower-byte addr) (higher-byte addr))))

;; --- Indirect Jumps ---

(operand jp 1 "JP (HL)" :arg1 hl-indirect :pass3 '(#xE9))
(operand jp 2 "JP (IX)" :arg1 ix-indirect :pass3 '(#xDD #xE9))
(operand jp 2 "JP (IY)" :arg1 iy-indirect :pass3 '(#xFD #xE9))

;; --- Subroutines & Returns ---

(operand djnz 2 "DJNZ e"
     :arg1 variable :relative #t
     :pass3 (list #x10 (segment-get-rel-offset r1 seg ctx size)))

(operand call 3 "CALL nn"
     :arg1 variable
     :pass3 (let ((addr (get-addr r1 seg ctx)))
              (list #xCD (lower-byte addr) (higher-byte addr))))

(operand call 3 "CALL cc, nn"
     :arg1 asmsym :arg2 variable
     :pass3 (let ((addr (get-addr r2 seg ctx)))
              (list (logior #xC4 (lshift (cond-code r1) 3))
                    (lower-byte addr) (higher-byte addr))))

(operand ret 1 "RET" :pass3 '(#xC9))

(operand ret 1 "RET cc"
     :arg1 asmsym
     :pass3 (list (logior #xC0 (lshift (cond-code r1) 3))))

(operand reti 2 "RETI" :pass3 '(#xED #x4D))
(operand retn 2 "RETN" :pass3 '(#xED #x45))

(operand rst 1 "RST p"
     :arg1 number
     :pass3 (list (logior #xC7 (lshift (/ (logand r1 #x38) 8) 3))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;; Input/Output group ;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; --- Basic Input ---

(operand in 2 "IN A, (n)"
     :arg1 8-register :arg2 number
     :pass3 (if (eq? r1 'a) 
                (list #xDB r2) 
                (error "Only 'IN A, (n)' is supported for direct port" ctx)))

(operand in 2 "IN r, (C)"
     :arg1 8-register :arg2 8-register
     :pass3 (if (eq? r2 'c)
                (list #xED (logior #x40 (lshift (reg-code r1) 3)))
                (error "Port must be register C" ctx)))

;; --- Block Input ---

(operand ini  2 "INI"  :pass3 '(#xED #xA2))
(operand inir 2 "INIR" :pass3 '(#xED #xB2))
(operand ind  2 "IND"  :pass3 '(#xED #xAA))
(operand indr 2 "INDR" :pass3 '(#xED #xBA))

;; --- Basic Output ---

(operand out 2 "OUT (n), A"
     :arg1 number :arg2 8-register
     :pass3 (if (eq? r2 'a) 
                (list #xD3 r1) 
                (error "Only 'OUT (n), A' is supported for direct port" ctx)))

(operand out 2 "OUT (C), r"
     :arg1 8-register :arg2 8-register
     :pass3 (if (eq? r1 'c)
                (list #xED (logior #x41 (lshift (reg-code r2) 3)))
                (error "Port must be register C" ctx)))

;; --- Block Output ---

(operand outi 2 "OUTI" :pass3 '(#xED #xA3))
(operand otir 2 "OTIR" :pass3 '(#xED #xB3))
(operand outd 2 "OUTD" :pass3 '(#xED #xAB))
(operand otdr 2 "OTDR" :pass3 '(#xED #xBB))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;; ASM Dirrectives ;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(operand bit 2 "BIT b, r (Smart Alias)"
  :arg1 any :arg2 any
  ;; pass1 и pass2 фиксированы (2 байта для CB XX)
  :pass1 2
  :pass2 2
  :pass3 (let ((bit-val (if (type? r1 'native-ref) 
                            (-> r1 .bit_offset)   ;; Если алиас, берем бит из него
                            r1))                  ;; Если число, берем как есть
               (reg-obj (if (type? r2 'native-ref)
                            (-> r2 .reg)          ;; Если алиас, берем физ. регистр
                            r2)))                 ;; Если символ (напр. 'a), берем его
           (list #xCB 
                 (logior #x40 
                         (lshift (logand bit-val 7) 3) 
                         (reg-code reg-obj)))))

;; --- Управление адресом ---

(operand org 0 "Origin: Set Program Counter"
  :arg1 number
  :pass1 (begin (ssegment-set-org! seg r1) 0)
  :pass2 (begin (ssegment-set-org! seg r1) 0)
  :pass3 (begin (ssegment-set-org! seg r1) '()))

;; --- Определение данных (Bytes) ---

(operand db 0 "Define Byte(s)"
  :arg1 variable
  :pass1 (if (list? r1) (length r1) 1)
  :pass2 (let ((vals (get-addr-list r1 seg ctx))) (length vals))
  :pass3 (mapcar lower-byte (get-addr-list r1 seg ctx)))

;; --- Определение данных (Words) ---

(operand dw 0 "Define Word(s)"
  :arg1 variable
  :pass1 (if (list? r1) (* (length r1) 2) 2)
  :pass2 (* (length (get-addr-list r1 seg ctx)) 2)
  :pass3 (let ((output '())
               (vals (get-addr-list r1 seg ctx)))
           ;; Если vals случайно стал ((64)), берем car
           (let ((flat-vals (if (and (list? vals) (list? (car vals))) 
                                (car vals) 
                                vals)))
             (dolist (v flat-vals)
               (let ((addr (if (list? v) (car v) v))) ;; Еще одна страховка
                 (set! output (append output (list (lower-byte addr) (higher-byte addr))))))
             output)))

;; --- Резервирование места ---

(operand ds 0 "Define Space (zeros or fill)"
  :arg1 number :arg2 number
  :pass1 r1 :pass2 r1
  :pass3 (make-list r1 r2))

(operand ds 0 "Define Space (zeros only)"
  :arg1 number
  :pass1 r1 :pass2 r1
  :pass3 (make-list r1 0))

;; --- Строки и Выравнивание ---

(defun string->byte-list (s)
  (let ((res '()))
    (begin
      (string-for-each s (lambda (c) (set! res (cons c res))))
      (reverse res))))

(operand ascii 0 "Define ASCII string"
  :arg1 string
  :pass1 (string-length r1)
  :pass2 (string-length r1)
  :pass3 (string->byte-list r1))
                   
(operand align 0 "Align ILC to N bytes"
  :arg1 number
  :pass1 (let* ((addr (+ (segment-origin seg) (segment-ilc seg)))
                (pad (mod (- r1 (mod addr r1)) r1)))
           pad)
  :pass2 (let* ((addr (+ (segment-origin seg) (segment-ilc seg)))
                (pad (mod (- r1 (mod addr r1)) r1)))
           pad)
  :pass3 (let* ((addr (+ (segment-origin seg) (segment-ilc seg)))
                (pad (mod (- r1 (mod addr r1)) r1)))
           (make-list pad 0)))

(defun get-vtable-size (type-sym)
     (if (symbol? type-sym)
          (* 3 (-> type-sym .methods-max-id))
          (error (fmt #f "Expected type name {}" type-sym) null)))

(defun find-if (pred lst)
  (cond
    ((null? lst) #f)
    ((pred (car lst)) (car lst))
    (else (find-if pred (cdr lst)))))

(defun emit-vtable-slots (type-sym emit-fn &optional ctx)
  (if (not (symbol? type-sym))
     (error (fmt #f "emit-vtable-slots expected symbol got `{}`" type-sym) ctx)
     (let ((max-id (-> type-sym .methods-max-id))
           (methods (-> type-sym .methods))
           (data '()))
       (dotimes (i (+ max-id 1))
          (let ((m (find-if (lambda (x) (= (-> x .id) i)) methods)))
               (if m
                    ;; Вызываем "излучатель" для реального метода
                    (push! (emit-fn (intern (concat (symbol->string type-sym) "::" (-> m .name)))) data )
                    ;; Вызываем "излучатель" для пустой дырки
                    (push! (emit-fn #f) data ))))
        (flatten (reverse  data)))
        ;; else
        null))


(operand ams-vtable  0 "Place v-table to code"
  :arg1 variable ;; name
  :arg2 variable ;; type
  :arg3 variable ;; options
  :pass1 (begin 
       (lab r1)
       (get-vtable-size r2))
  :pass2 (begin 
       (lab r1)
       (get-vtable-size r2))
  :pass3 (begin
            (emit-vtable-slots r2 
                 (lambda (label-name) 
                 (if label-name
                      (let ((addr (get-addr label-name seg ctx)))                         
                          (list #xC3 (lower-byte addr) (higher-byte addr)))
                      (list 0 0 0)))
                      ctx)))

(defmacro vtable (name type &optional (options 'default))
     `(ams-vtable ',name ',type ',options))

(defun ld16 (reg-thing field-expr)
  (let* ((alias (eval field-expr))
         (base (-> alias .reg))
         (offset (-> alias .offset))
         ;; Извлекаем символ из lextoken если нужно:
         (reg-sym (if (lextoken? reg-thing)
                      (lextoken-value reg-thing)
                      reg-thing)))  ;; если уже символ
    (list
      (ld (get-low-reg reg-sym) (+i base offset))
      (ld (get-high-reg reg-sym) (+i base (+ offset 1))))))



;; Добавляем в таблицу опкодов
(operand ld 4 "LD r, (R13+d)"
  :arg1 8-register :arg2 r13-indexed
  :pass3 (list #xDD (logior #x46 (lshift (reg-code r1) 3)) r2))

(operand ld 4 "LD r, (R14+d)"
  :arg1 8-register :arg2 r14-indexed
  :pass3 (list #xFD (logior #x46 (lshift (reg-code r1) 3)) r2))

(operand ld 4 "LD (R13+d), r"
  :arg1 r13-indexed :arg2 8-register
  :pass3 (list #xDD (logior #x70 (reg-code r2)) r1))

(operand ld 4 "LD (R14+d), r"
  :arg1 r14-indexed :arg2 8-register
  :pass3 (list #xFD (logior #x70 (reg-code r2)) r1))

(fmt #t "Loaded asm-z80\n")
