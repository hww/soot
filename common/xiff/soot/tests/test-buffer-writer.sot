(init-types 'z80)

(fmt #t "Test BufferWroter...\n" :color 'yellow)

(deftype inner (basic) (
    (val_i8 int8)
    (val_i16 int16)
    (val_u8 uint8)
    (val_u16 uint16)
)) 

;; 1. Обновляем чертеж: добавляем поле для тега
(deftype outer (basic) (
    (tag  int8  1)  ;; Теперь поле 'tag существует!
    (data inner 1)
))

;; 2. Запускаем запись снова
(define buf (make-buffer "test" 100 0))
        
(buffer-write buf 
                 '((tag  . #x55) 
                   (data  ((val_i8 . #x7F)
                             (val_i16 . #x7FFF)
                             (val_u8 . #x7F)
                             (val_u16 . #x7FFF)))) 
                                 :address 0
                 :type 'outer)
   
(fmt #t "Dump:\n{}\n" (buffer-dump buf))

;; Чтение (слайсинг)
(let ((obj (buffer-read buf :type 'outer :address 0)))
 ;; obj сейчас — это TypePointer, так как 'outer это структура
 
 (let ((val-cell (-> obj 'data 'val_i8)))
    (fmt #t "Value val_i8 is: {}\n" (mem-get val-cell)))
 
 (let ((tag-cell (-> obj 'tag)))
    (fmt #t "Tag is: #x{:x}\n" (mem-get tag-cell)))
    
 (let ((val-cell (-> obj 'data 'val_i8)))
    (setf (-> obj 'data 'val_i8) 45) 
    (fmt #t "Value val_i8 after set 45 is: {}\n" (mem-get val-cell)))
)
;; Запист с переполнением
(let ((obj (buffer-read buf :type 'outer :address 0)))
 ;; obj сейчас — это TypePointer, так как 'outer это структура
    
 (let ((val-cell (-> obj data val_i8)))
    (setf (-> obj data val_i8) #x7F) 
    (fmt #t "Value val_i8 after set #x80 is: {}\n" (mem-get val-cell)))
 (let ((val-cell (-> obj data val_u8)))
    (setf (-> obj data 'val_u8) #x80) 
    (fmt #t "Value val_u8 after set #x80 is: {}\n" (mem-get val-cell)))
 (let ((val-cell (-> obj data val_i16)))
    (setf (-> obj data 'val_i16) #x7FFF) 
    (fmt #t "Value val_i16 after set #x8000 is: {}\n" (mem-get val-cell)))
 (let ((val-cell (-> obj data val_u16)))
    (setf (-> obj data val_u16) #x8000) 
    (fmt #t "Value val_u16 after set #x8000 is: {}\n" (mem-get val-cell)))
)

(fmt #t "Dump:\n{}\n" (buffer-dump buf))
