(init-types 'z80)

(fmt #t "Test Link...\n" :color 'yellow)

;; 1. Создаем буфер для кода Z80 (origin по адресу #x8000)
(define buf (make-buffer "CODE_SEG" 64 #x8000))

(fmt #t "--- Шаг 1: Запись кода с релокациями ---\n")

;; Представим, что мы пишем инструкцию LD HL, (DATA_ADDR)
;; Код для Z80: #x21 <address_low> <address_high>
(buffer-write buf #x21 :address 0 :type 'uint8) 

;; Мы еще не знаем, где будет метка 'app-version', но обещаем её найти
;; Используем нашу новую функцию write-reloc
(buffer-write-reloc buf 1 "app-version")

;; 2. Записываем инструкцию JP (прыжок) на процедуру инициализации
(buffer-write buf #xC3 :address 3 :type 'uint8)
(buffer-write-reloc buf 4 "init-routine")

(fmt #t "Состояние буфера до линковки (ожидаем нули в адресах):\n")
(fmt #t "Dump:\n{}\n" (buffer-dump buf 0 64 #t 8))

(fmt #t "--- Шаг 2: Определение меток ---\n")

;; Теперь ставим метки. 'app-version' будет в конце кода, 'init-routine' чуть раньше.
(buffer-label-set! buf "init-routine" :address #x10)
(buffer-label-set! buf "app-version"  :address #x20)

;; Запишем по этим адресам какие-нибудь данные для наглядности
(buffer-write buf #x0105 :address #x20 :type 'uint16) ; Version 1.5

(fmt #t "--- Шаг 3: Линковка ---\n")

;; Магический момент: проход по таблице релокаций и подстановка адресов
(buffer-link buf)

(fmt #t "Состояние буфера ПОСЛЕ линковки (адреса должны прошиться):\n")
(fmt #t "Dump:\n{}\n" (buffer-dump buf 0 64 #t 8))


;; Проверка конкретных значений
(define target-addr (buffer-read buf :address 1 :type 'uint8))
(fmt #t "Прошитый адрес 'app-version': {:#x} (ожидаем #x8020)\n" target-addr)