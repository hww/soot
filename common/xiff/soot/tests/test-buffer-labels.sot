(fmt #t "Test Labels...\n" :color 'yellow)

;; 1. Описываем типы (чертежи памяти)
(deftype driver-config (basic) (
    (id       uint16)
    (version  uint8)
    (flags    uint8)
))

(deftype device-header (basic) (
    (name     uint8 4) ;; Массив из 4 символов
    (config   driver-config :inline)
    (entry_pt uint16)    ;; Сюда мы запишем адрес метки позже
))

;; 2. Создаем буфер и "писателя"
(define buf (make-buffer "DRV_SEG" 64 0))
(define wr  (make-buffer-writer buf))

(fmt #t "--- Шаг 1: Запись начальных данных ---\n")

;; Ставим метку в самом начале
(buffer-label-set! wr "segment-start")

;; Записываем структуру через alist
(buffer-write wr 
    '((name . (#x41 #x42 #x43 #x00)) ;; "ABC\0"
      (config . ((id . #x1234) 
                 (version . 1) 
                 (flags . #x80))))
    :type 'device-header)
(fmt #t "--- Шаг 2: Использование меток ---\n")
;; Допустим, здесь начинается какой-то код инициализации
;; Мы ставим метку через курсор
(buffer-label-set! wr "init-routine")

;; Пишем пару "пустых" команд (например, NOP = 0)
(buffer-write wr 0 :type 'uint8)
(buffer-write wr 0 :type 'uint8)
;; А теперь ставим метку вручную на фиксированный адрес
;; (например, системный обработчик Z80 на адресе #x0038)
(buffer-label-set! buf 'rst-handler :address #x38)
(fmt #t "--- Шаг 3: Проверка результатов ---\n")
;; Выводим оффсеты меток, чтобы убедиться, что они зацепились
(fmt #t "Метка 'segment-start' на: {}\n" (-> buf 'segment-start))
(fmt #t "Метка 'init-routine'  на: {}\n" (-> buf 'init-routine))
(fmt #t "Метка 'rst-handler'   на: {}\n" (-> buf 'rst-handler))
;; Дамп буфера
(fmt #t "Dump of DRV_SEG:\n{}\n" (buffer-dump buf))
