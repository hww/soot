(init-types 'z80)

(load "common/xiff/soot/tests/zasm.sot")

(deftype vec3s8 (structure)
  ((x int8) 
   (y int8) 
   (z int8))
 (:methods
      (new (int16 int16) none)
      (len () int16)))

(deftype vec3 (structure)
  ((x int16) 
   (y int16) 
   (z int16))
 (:methods
      (new (int16 int16) none)
      (len () int16)))

(deftype mat3 (structure)
  ((r1 vec3)   
   (r2 vec3)   
   (r3 vec3))) 

(defenum eflag
  :type uint8
  :bitfield #t
  (bit0 0)
  (bit1 1)
  (bit2 2)
  (bit3 3))

(segment-reset *current-segment*)
(set! *current-pass* 2)

(defmethod len ((this vec3) (x uint8))
  ;; Первый rlet (информационный) уже добавлен макросом скрыто.
  ;; Теперь программист добавляет свой (машинный) rlet:
  (rlet ((self :reg ix :type uint8)
         (x    :reg a  :type uint8)) 
    (zasm
      (.nop)
      (.ld self 10)
      (.ld self #x0A)  ;; Запишет 10 в (IX+0)
      (.ld a #x55)    ;; Загрузит 85 в A
      ;(ld hl (self x)) ;; Используем типизированное смещение
      (.ret))))

(dump-listing 'default)

