(load "common/xiff/soot/asm.sot")

(init-types 'z80)

(defmodule test-module)

(defenum test-enum
        :type uint8
        (red   0) 
        (green 1)
        (label4e  2))

(defenum test-mask
        :bitfield #t
        :type uint8
        (bit0 1)
        (bit1 2)
        (bit2 4)
        (bit3 8)
        (bit4 #x10)
        (bit5 #x20)
        (bit6 #x40)
        (bit7 #x80)        
        )


(deftype test-struct (basic)
  ((test_i8   int8 1) 
   (test_i16  int16 2)))

(deftype test-vector (basic)
  ((x   int8 1) 
   (y   int8 2))
  (:methods
      (new (int8 int8) object)
      (set (int8 int8) none)
      (len () int8)
      ))

        
(defmacro subroutine (name &rest code)
   `(list (lab ',name) ,@code))


   (zasm 
      (org #x0000)
$zero      
      (org #x8000)
$start
     (jp 'label3)
      (db 22)
      (db (list 22 33 44))
      (dw 64)
      (ds 8)
      (dw 'start)
      (dw '(1 2 3))
      (ascii "Hello World\n")
      (align 16)
$label1
      (jmp 'label1)
      (jmp 'label2)
      (ld @a @b) 
$label2
      (jmp 'label1)
      (jmp 'label3)
      (ld @c (+ 1 3)) 
(subroutine label3
      (ld @a @c))
      (jmp 'label1)
      (jmp 'label2)
      (jmp 'label3)
      (jmp 0)
      (jmp 'zero)
      (ld @a [+ ix 5])    ; Должно быть: DD 7E 05
      (ld [- iy 10] #xAA) ; Должно быть: FD 36 F6 AA
  )

(let* ((test   (begin 
                 (select-segment test-module "MAIN")
                 (module-current-segment test-module))))
  ;; теперь вызывай сборку модуля, а не сегмента
  (assemble-module test-module)

  (cfmt #t "yellow" "\n--- DEBUG CHECK ---\n")
  (let ((seg (hash-table-ref (module-segments my-mod) "MAIN")))
  (begin
    (cfmt #t "yellow" "Segment Name: {}\n" (segment-name seg))
    (cfmt #t "yellow" "Instructions count: {}\n" (length (segment-insts seg)))
    (cfmt #t "yellow" "Raw insts: {}\n" (segment-insts seg))))

  (print-listing my-mod)
  )

