(load "common/xiff/soot/asm.sot")

(defmacro subroutine (name &rest code)
   `(list (lab ',name) ,@code))

(defparameter 
   test 
   (lzasm-z80 

$bla
      (ld @a @b) 
$bli
      (jmp 'blo)
      (ld @c (+ 1 3)) 
$ble
      (ld @c (+ 1 3)) 
      (ld @c (+ 1 3)) 
$blu
      (ld @a @c)
$blo

(subroutine blubber
      (ld @a @c))
  )
)

;(assemble test)


(let* ((result (assemble test))
       (bin-data (cdr (assoc :bin result))))
  (begin
    (write-binary "test.bin" bin-data)
    (fmt #t "Bytes written: {}\n" (length bin-data))
    ;; Если read-binary-file работает:
    (fmt #t "Verified: {}\n" (read-binary "test.bin"))))