(load "common/xiff/soot/asm.sot")

(init-types 'z80)

(defmodule test-module)

(deftype vec3 (structure)
  ((x int16) 
   (y int16) 
   (z int16))
 (:methods
      (new (int16 int16) none)
      (len () int16)))

(deftype mat3 (structure)
  ((r1 vec3)   
   (r2 vec3)   
   (r3 vec3))) 

(defmacro build-vtable (type-sym seg)
  (let* ((type-name-str (symbol->string type-sym))
         (vtable-label (intern (concat type-name-str "-vtable")))
         (methods (-> type-sym methods)))
    `(zasm
       ;; Объявляем метку начала таблицы
       (lab ',vtable-label)
       ,@(map (lambda (m)
                (let* ((m-name (-> m name))
                       (m-id (-> m id))
                       (full-symbol (intern (concat type-name-str "::" m-name))))
                  ;; Вместо того чтобы мучить ассемблер вычислениями в ORG,
                  ;; мы просто генерируем нужные смещения
                  `(begin
                     (org (+ (segment-get-label-addr ',vtable-label ,seg) (* 3 ,m-id)))
                     (jp ',full-symbol))))
              methods))))





(zasm 
      (org #x0000)
$zero      
      (org #x8000)
$start
      (jp 'label3)
      (db 22)
      (db (list 22 33 44))
      (dw 64)
      (ds 8)
      (dw 'start)
      (dw '(1 2 3))
      (ascii "Hello World\n")
      (align 16)
$label1
      (jmp 'label1)
      (jmp 'label2)
      (ld a b) 
$label2
      (jmp 'label1)
      (jmp 'label3)
      (ld c (+ 1 3)) 
      (subroutine label3
            (jmp 'label3)
            (jmp 'label2)
            (jmp 'label1)
            (ld a c)
            (jmp 0)
            (jmp 'zero)
            (ld a [+ ix 5])    ; Должно быть: DD 7E 05
            (ld [- iy 10] #xAA) ; Должно быть: FD 36 F6 AA
      )
      (org #x8000)

$vec3::new
      (ret)
$vec3::len
      (ret)
$begin
      (ld hl (size-of vec3)) ;; offset
      (ld hl (offset-of vec3 x)) ;; offset
      (ld hl (offset-of vec3 y)) ;; offset
      (ld hl (size-of vec3 x)) ;; size
      (ld hl (size-of vec3 y)) ;; size
      (ld [+ iy (offset-of vec3 y)] 10)
      (vtable position vec3)

)

(defmacro defmethod (name-and-type args &body body)
  (let ((name (car name-and-type))
        (type (cadr name-and-type))
        (label (format nil "$~a::~a" type name)))
    `(begin
       ;; 1. Регистрация в метаданных (то, что мы обсуждали)
       (declare-method ',type ',name ',args) 
       
       ;; 2. Генерация кода
       (zasm
         (label ,label)
         ;; Пролог: настраиваем доступ к полям структуры через IX
         (push ix)
         (ld ix sp) 
         
         ;; Вставляем тело метода. 
         ;; Здесь макрос '->' будет знать, что 'this' - это IX
         ,@body 
         
         (pop ix)
         (ret)))))

 (rlet ((m :reg r13 :type mat3))
 
 (zasm
   (fmt #t "(-> m) => {}\n" (-> m))
   (fmt #t "(-> m r1) =>{}\n" (-> m r1 ))
   (fmt #t "(-> m r1 x) =>{}\n" (-> m r1 x))
   (ld a (-> m r1 x))   
  ;(-> m r2 z) 
  ))

;; index
(rlet ((m :reg r13 :type vec3))
        (zasm
          ;; Проверка базового смещения
          (fmt #t "Base: (-> m)     => {}\n" (-> m))       ; Ожидаем offset 0
          
          ;; Проверка индексации (как будто m - это массив векторов)
          ;; Если vec3 занимает 16 байт:
          (fmt #t "Idx 1: (-> m 1)   => {}\n" (-> m 1))     ; Ожидаем offset 16
          (fmt #t "Idx 2: (-> m 2)   => {}\n" (-> m 2))     ; Ожидаем offset 32
          
          ;; Смешанная цепочка: массив -> поле
          ;; Допустим, поле 'y' имеет offset 4 внутри vec3
          (fmt #t "Full: (-> m 1 y)  => {}\n" (-> m 1 y))   ; Ожидаем offset 20 (16 + 4)
        ))


;; 3. Одной командой собираем и выводим отчет
(build test-module)
(module-dump test-module)
(generate-module-listing test-module :print-listing #t)
;; 4. Сохраняем артефакты
(save-module-hex test-module)
(save-symbols test-module)