(load "common/xiff/soot/asm.sot")

(init-types 'z80)

(defmodule test-module)

(deftype vec3s8 (structure)
  ((x int8) 
   (y int8) 
   (z int8))
 (:methods
      (new (int16 int16) none)
      (len () int16)))

(deftype vec3 (structure)
  ((x int16) 
   (y int16) 
   (z int16))
 (:methods
      (new (int16 int16) none)
      (len () int16)))

(deftype mat3 (structure)
  ((r1 vec3)   
   (r2 vec3)   
   (r3 vec3))) 

(defenum eflag
  :type uint8
  :bitfield #t
  (bit0 0)
  (bit1 1)
  (bit2 2)
  (bit3 3))

(defmacro build-vtable (type-sym seg)
  (let* ((type-name-str (symbol->string type-sym))
         (vtable-label (intern (concat type-name-str "-vtable")))
         (methods (-> type-sym methods)))
    `(zasm
       ;; Объявляем метку начала таблицы
       (lab ',vtable-label)
       ,@(map (lambda (m)
                (let* ((m-name (-> m name))
                       (m-id (-> m id))
                       (full-symbol (intern (concat type-name-str "::" m-name))))
                  ;; Вместо того чтобы мучить ассемблер вычислениями в ORG,
                  ;; мы просто генерируем нужные смещения
                  `(begin
                     (org (+ (segment-get-label-addr ',vtable-label ,seg) (* 3 ,m-id)))
                     (jp ',full-symbol))))
              methods))))




#|
(zasm 
      (org #x0000)
$zero      
      (org #x100)
$start
      (jp 'label3)
      (db 22)
      (db (list 22 33 44))
      (dw 64)
      (ds 8)
      (dw 'start)
      (dw '(1 2 3))
      (ascii "Hello World\n")
      (align 16)
$label1
      (jmp 'label1)
      (jmp 'label2)
      (ld a b) 
$label2
      (jmp 'label1)
      (jmp 'label3)
      (ld c (+ 1 3)) 
      (subroutine label3
            (jmp 'label3)
            (jmp 'label2)
            (jmp 'label1)
            (ld a c)
            (jmp 0)
            (jmp 'zero)
            (ld a [+ ix 5])    ; Должно быть: DD 7E 05
            (ld [- iy 10] #xAA) ; Должно быть: FD 36 F6 AA
      )
      (org #x200)

$vec3::new
      (ret)
$vec3::len
      (ret)
$begin
      (ld hl (size-of vec3)) ;; offset
      (ld hl (offset-of vec3 x)) ;; offset
      (ld hl (offset-of vec3 y)) ;; offset
      (ld hl (size-of vec3 x)) ;; size
      (ld hl (size-of vec3 y)) ;; size
      (ld [+ iy (offset-of vec3 y)] 10)
      (vtable position vec3)

)
|#
(defmacro defmethod (name-and-type args &body body)
  (let ((name (car name-and-type))
        (type (cadr name-and-type))
        (label (format nil "$~a::~a" type name)))
    `(begin
       ;; 1. Регистрация в метаданных (то, что мы обсуждали)
       (declare-method ',type ',name ',args) 
       
       ;; 2. Генерация кода
       (zasm
         (label ,label)
         ;; Пролог: настраиваем доступ к полям структуры через IX
         (push ix)
         (ld ix sp) 
         
         ;; Вставляем тело метода. 
         ;; Здесь макрос '->' будет знать, что 'this' - это IX
         ,@body 
         
         (pop ix)
         (ret)))))

(defmacro zasm-if (condition &rest body)
  (let ((label-else (gensym "else"))
        (label-end  (gensym "end")))
    `(begin
       ;; Инвертируем условие: если условие НЕ выполняется, прыгаем в конец
       ;; (Если zasm-if z ..., то прыгаем если NZ)
       (jr ,(invert-condition condition) ',label-end)
       ,@body
       (lab ',label-end))))

;; Вспомогательная функция для инверсии флагов Z80
(defun invert-condition (c)
  (cond
    ((eq? c 'z)  'nz)
    ((eq? c 'nz) 'z)
    ((eq? c 'c)  'nc)
    ((eq? c 'nc) 'c)
    (else c)))

(define r13 'r13)
(define r14 'r14)

(fmt #t "DEBUG: Testing offset calculations:\n")
(fmt #t "  size-of vec3 = {}\n" (size-of vec3))
(fmt #t "  offset-of vec3 x = {}\n" (offset-of vec3 x))
(fmt #t "  offset-of vec3 y = {}\n" (offset-of vec3 y))
(fmt #t "  offset-of vec3 z = {}\n" (offset-of vec3 z))
(fmt #t "  size-of mat3 = {}\n" (size-of mat3))
(fmt #t "  offset-of mat3 r1 = {}\n" (offset-of mat3 r1))
(fmt #t "  offset-of mat3 r2 = {}\n" (offset-of mat3 r2))

(define offset-of-r1-x (+ (offset-of mat3 r1) (offset-of vec3 x)))
(fmt #t "DEBUG: offset-of r1 in mat3 = {}\n" (offset-of mat3 r1))
(fmt #t "DEBUG: offset-of x in vec3 = {}\n" (offset-of vec3 x))
(fmt #t "DEBUG: total offset = {}\n" offset-of-r1-x)


