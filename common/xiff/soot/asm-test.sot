(zasm 
  (org #x0000)
  $start
  (ld a b)                     ; Простая инструкция
  (ld c 10)                    ; Загрузка константы
  (ld a [hl])                  ; Косвенная адресация через HL - с КВАДРАТНЫМИ скобками!
  (jp 'start)                  ; Безусловный переход
)
