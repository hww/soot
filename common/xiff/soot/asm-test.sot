  #|
;; index
(rlet ((m :reg r13 :type vec3))
        (zasm
          ;; Проверка базового смещения
          (fmt #t "Base: (-> m)     => {}\n" (-> m))       ; Ожидаем offset 0
          
          ;; Проверка индексации (как будто m - это массив векторов)
          ;; Если vec3 занимает 16 байт:
          (fmt #t "Idx 1: (-> m 1)   => {}\n" (-> m 1))     ; Ожидаем offset 16
          (fmt #t "Idx 2: (-> m 2)   => {}\n" (-> m 2))     ; Ожидаем offset 32
          
          ;; Смешанная цепочка: массив -> поле
          ;; Допустим, поле 'y' имеет offset 4 внутри vec3
          (fmt #t "Full: (-> m 1 y)  => {}\n" (-> m 1 y))   ; Ожидаем offset 20 (16 + 4)
        ))

;; Automatic Stride
(rlet ((v :reg r10 :type vec3))
  (zasm
    ;; vec3 обычно выравнивается по 16 байт в массиве
    (fmt #t "v[0] offset: {}\n" (-> v 0 .offset)) ; Ожидаем 0
    (fmt #t "v[1] offset: {}\n" (-> v 1 .offset)) ; Ожидаем 16 (не 12!)
    (fmt #t "v[1].y offset: {}\n" (-> v 1 y .offset)) ; Ожидаем 20 (16 + 4)
  ))

;; bitfield
(rlet ((status :reg r14 :type eflag))
  (zasm
    (fmt #t "Full Enum:  {}\n" (-> status))
    (fmt #t "Bit 0:      {}\n" (-> status bit0))
    (fmt #t "Bit 2:      {}\n" (-> status bit2))
    
    ;; Проверка "внутренностей" через точки
    (fmt #t "Bit 2 Shift: {}\n" (-> status bit2 .bit_offset))
    (fmt #t "Bit 2 Size:  {}\n" (-> status bit2 .bit_size))
  ))
