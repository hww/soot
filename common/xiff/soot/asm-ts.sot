(load "common/xiff/soot/asm.sot")

(init-types 'z80)

(defenum test-enum
        :type uint8
        (red   0) 
        (green 1)
        (blue  2))

(defenum test-mask
        :bitfield #t
        :type uint8
        (bit0 1)
        (bit1 2)
        (bit2 4)
        (bit3 8)
        (bit4 #x10)
        (bit5 #x20)
        (bit6 #x40)
        (bit7 #x80)        
        )

(deftype test-struct (basic)
  ((test_i8   int8 1) 
   (test_i16  int16 2)))

(deftype test-vector (basic)
  ((x   int8 1) 
   (y   int8 2))
  (:methods
      (new (int8 int8) object)
      (set (int8 int8) none)
      (len () int8)
      ))
        
(defmacro subroutine (name &rest code)
   `(list (lab ',name) ,@code (ret)))

  
(defparameter 
   test 
   (lzasm-z80 

$start
    (call 'subone)
    (ld @a (@ix (-> test-vector y))) ; Раскроется в (ld a (ix 3))
    (ld @c (-> test-enum blue))     ; Раскроется в (ld c 2)
    (ret)
    (subroutine subone
        (add @a @c))
        (ret))
)

;(assemble test)

(let* ((result (assemble test))
       (bin-data (cdr (assoc :bin result)))
       (lst-data (cdr (assoc :lst result))))
  (begin
    ;; 1. Записываем бинарник
    (write-binary-file "test.bin" bin-data)

    ;; 2. Сохраняем листинг
    (save-listing "test.lst" lst-data)

    ;; 3. Проверка
    ;;(print "--- Verification from file ---")
    ;;(print (read-text-file "test.lst"))
    ))