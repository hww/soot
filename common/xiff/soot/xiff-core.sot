;-*-Scheme-*-

(define null #f)

;; xiff-core.sot
(define *registry* '())

;; Макрос или функция для регистрации RPC
(desfun define-rpc (name &key (params null) &key (return null) &key (desc null))
    (let ((entry (list 'rpc name params)))
      (set! *registry* (cons entry *registry*))
      (fmt #t "RPC Registered: {}\n" name)))

;; Регистрация прерывания или вектора
(define define-vector
  (lambda (addr name)
    (set! *registry* (cons (list 'vector addr name) *registry*))))

;; Функция для получения данных в C++
(define get-xiff-data (lambda () *registry*))

(desfun generate-output (name) (print *registry*))