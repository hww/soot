;; ============================================================================
;; MODULE DECLARATION AND IMPORTS
;; ============================================================================

;(module xiff-core
;  (export x-const x-field x-func x-struct x-begin-vtable x-end-vtable
;          x-vtable-method x-module x-export-h x-export-c x-export-asm x-export-inc
;          x-begin-struct x-end-struct x-enum x-method x-event
