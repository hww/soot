;;; =====================================================================
;;; vectors.sot - Векторы прерываний (#x0000-#x00FF)
;;; =====================================================================

(with-segment vectors

(defblock vectors
  (zasm
    ;; RST 00h (#x0000) - Сброс
    (.org #x0000)
    (.di)
    (.jp 'start)           ; переход в boot/start
    
    (.org #x0005)
    (.jp 'rst_05_handler)

    ;; Остальные RST вектора (8 байт каждый)
    (.org #x0008)
    (.jp 'rst_08_handler)
    
    (.org #x0010)
    (.jp 'rst_10_handler)
    
    (.org #x0018)
    (.jp 'rst_18_handler)
    
    (.org #x0020)
    (.jp 'rst_20_handler)
    
    (.org #x0028)
    (.jp 'rst_28_handler)
    
    (.org #x0030)
    (.jp 'rst_30_handler)
    
    ;; IM1 прерывание (#x0038)
    (.org #x0038)
    (.ei)
    (.reti)
    
    ;; Заполняем до NMI
    ;(.ds (- #x0066 (ilc)))
    
    ;; NMI (#x0066)
    (.org #x0066)
    (.retn)
    ;; Остаток векторов до #x0100
    ;(.ds (- #x0100 (ilc)))
  ))
) ;; end of segment
;;; =====================================================================
;;; Обработчики прерываний (можно в отдельном файле)
;;; =====================================================================

(with-segment code

(defcode interrupt_handlers
  (zasm
    (.label 'rst_05_handler)
    ;; обработчик RST 05h
    (.ret)

    (.label 'rst_08_handler)
    ;; обработчик RST 08h
    (.ret)
    
    (.label 'rst_10_handler)
    ;; обработчик RST 10h (например, вывод символа)
    (.ret)
       
    (.label 'rst_18_handler)
    ;; обработчик RST 18h (например, вывод символа)
    (.ret)

    (.label 'rst_20_handler)
    ;; обработчик RST 20h (например, вывод символа)
    (.ret)
        
    (.label 'rst_28_handler)
    ;; обработчик RST 28h (например, вывод символа)
    (.ret)
        
    (.label 'rst_30_handler)
    ;; обработчик RST 30h (например, вывод символа)
    (.ret) 

  ))
);; end of segment
