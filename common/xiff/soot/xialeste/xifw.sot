;;; =====================================================================
;;; 1. КОНСТАНТЫ LAYOUT
;;; =====================================================================

;;; =====================================================================
;;; Стандартные сегменты
;;; =====================================================================

;; Сегмент для исполняемого кода
(defconstant SEGMENT-CODE 'code)

;; Сегмент для инициализированных данных
(defconstant SEGMENT-DATA 'data)

;; Сегмент для неинициализированных данных (BSS)
(defconstant SEGMENT-BSS 'bss)

;; Сегмент для констант (только чтение)
(defconstant SEGMENT-CONST 'const)

;; Сегмент для векторов прерываний
(defconstant SEGMENT-VECTORS 'vectors)

;; Сегмент для стека
(defconstant SEGMENT-STACK 'stack)

;;; =====================================================================
;;; Firmware Memory Map constants
;;; =====================================================================

(defconstant VECTORS_BASE   #x0000)
(defconstant VECTORS_SIZE   256)

(defconstant BOOT_BASE      #x0100)
(defconstant BOOT_SIZE      256)

(defconstant CODE_BASE      #x0200)
(defconstant STACK_TOP      #x7FFF)  ; Вершина стека
(defconstant STACK_SIZE     256)
(defconstant CODE_SIZE      (- STACK_TOP CODE_BASE STACK_SIZE))

(defconstant FONT_BASE      #x8000)
(defconstant FONT_SIZE      2048)

(defconstant DATA_BASE      #x8800)
(defconstant DATA_SIZE      8192)

(defconstant VTABLES_BASE   (+ DATA_BASE DATA_SIZE))  ; #xA800
(defconstant VTABLES_SIZE   8192)

(defconstant GLOBALS_BASE   (+ VTABLES_BASE VTABLES_SIZE))  ; #xC800
(defconstant GLOBALS_SIZE   2048)

;;; =====================================================================
;;; 2. ИНИЦИАЛИЗАЦИЯ СЕГМЕНТОВ
;;; =====================================================================

(defun init-project-layout ()
  "Инициализирует все сегменты проекта"
  (new-segment :name 'vectors  :module *current-module* 
               :size VECTORS_SIZE :base VECTORS_BASE)
  (new-segment :name 'boot     :module *current-module* 
               :size BOOT_SIZE :base BOOT_BASE)
  (new-segment :name 'code     :module *current-module* 
               :size CODE_SIZE :base CODE_BASE)
  (new-segment :name 'stack    :module *current-module* 
               :size STACK_SIZE :base (- STACK_TOP STACK_SIZE))
  (new-segment :name 'font     :module *current-module* 
               :size FONT_SIZE :base FONT_BASE)
  (new-segment :name 'data     :module *current-module* 
               :size DATA_SIZE :base DATA_BASE)
  (new-segment :name 'vtables  :module *current-module* 
               :size VTABLES_SIZE :base VTABLES_BASE)
  (new-segment :name 'globals  :module *current-module* 
               :size GLOBALS_SIZE :base GLOBALS_BASE))

;;; =====================================================================
;;; 5. ЗАГРУЗКА ИСХОДНИКОВ
;;; =====================================================================
(load "common/xiff/soot/zasm/zasm.sot")

;;; =====================================================================
;;; 3. ОПРЕДЕЛЕНИЕ МОДУЛЯ
;;; =====================================================================
(defmodule xifw
  "Основной модуль прошивки")

;;; =====================================================================
;;; 4. LAYOUT ВЫХОДНЫХ ФАЙЛОВ (что куда сохранять)
;;; =====================================================================
(define *xifw-output-layout* 
  '(
    ;; Несколько сегментов могут идти в один файл
    ("xifw.hex" code)      ;; код
    ("xifw.hex" font)      ;; шрифты (добавляются в тот же hex)
    ("xifw.hex" vectors)   ;; векторы в отдельный файл (опционально)
    ("xifw.hex" boot)      ;; загрузчик отдельно
    ("xifw.hex" data)      ;; данные отдельно
    ("xifw.hex" vtables)   ;; vtable отдельно
   ))

;;; =====================================================================
;;; 5. ЗАГРУЗКА ИСХОДНИКОВ
;;; =====================================================================

(load "common/xiff/soot/zasm/zasm.sot")

;;; =====================================================================
;;; FW Code
;;; =====================================================================

;; Настраиваем layout ДО загрузки остальных файлов
(with-module xifw
  (init-project-layout))

;; Загружаем остальные файлы (они будут использовать настроенные сегменты)
(load "common/xiff/soot/xialeste/boot.sot")
(load "common/xiff/soot/xialeste/vectors.sot")
(load "common/xiff/soot/xialeste/main.sot")
(load "common/xiff/soot/xialeste/crtc-modes.sot")
(load "common/xiff/soot/xialeste/font_win1252.sot")

;;; =====================================================================
;;; 6. КОМПИЛЯЦИЯ
;;; =====================================================================
(assemble-module 'xifw)
(dump-listing 'xifw)

;;; =====================================================================
;;; 7. СОХРАНЕНИЕ РЕЗУЛЬТАТОВ
;;; =====================================================================
(save-module-practical 'xifw *xifw-output-layout*)
(export-symbols-to-emu "xifw.sym" 'xifw)