;;; =====================================================================
;;; boot.sot - Загрузчик (#x0100-#x01FF)
;;; =====================================================================

(with-segment boot

(defblock boot
    (.org #x0100)
    (.label 'start)
    
    ;; Инициализация системы
    (.di)
    (.ld sp #x7F00)        ; стек в безопасном месте
    
    ;; Настройка Aleste ASIC
    (.ld a #x00)
    (.out #xFC a)        ; регистр A
    (.ld a #x01)
    (.out #xFD a)        ; регистр B
    (.ld a #x02)
    (.out #xFE a)        ; регистр C
    (.ld a #x03)
    (.out #xFF a)        ; регистр D
    
    ;; Вызов C main()
    (.call 'main)
    
    ;; Завершение (никогда не должно достигнуться)
    (.label 'halt_loop)
    (.di)
    (.halt)
    (.jp 'halt_loop)
  )
) ;; end of segment
