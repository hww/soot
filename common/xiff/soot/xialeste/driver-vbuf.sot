
; ==============================================================================
; Base VBUF Driver 
; ==============================================================================

;;; Standard driver command supported by all drivers
(defenum vbuf-command
  :type uint8
  (cmd-reset             #x10)) 

(with-segment  code

;;; Basic driver
(deftype vbuf (driver)
  (   
    ;; main information 
    (width  uint16)     ;; pixels width
    (height uint16)     ;; pixels height
    (bpp uint8)         ;; bits per pixel
    (bpl uint8)         ;; how many bytes in line
    (size uint16)       ;; bytes on screen
    ;; colors
    (bg-color uint8)    ;; background color
    (fg-color uint8)    ;; foreground color
    ;; base addres
    (vbuf-base uint16)  ;; base address for the video memory
    (font-base uint16)  ;; base address for the font
    ;; blitter source position
    (src-pos vector2)
    (src-addr-lo uint16)
    (src-addr-hi uint16)
    (src-ptr pixel-ref)
    ;; blitter destination position
    (dst-pos vector2)
    (dst-addr-lo uint16)
    (dst-addr-hi uint16)
    (dst-ptr pixel-ref)
  )
  (:methods
    (new () _type_)
    (set-char-x (_type_ int8) none)
    (set-char-y (_type_ int8) none)
    (set-pixel-x (_type_ int16) none)
    (set-pixel-y (_type_ int8) none)
    ))

(defmethod new vbuf ()
  ;; The dummy constructor
  (declare (asm-func _type_))
  (.ret))

(defmethod set-char-x ((this vbuf) (x int8))
  (declare (asm-func none))
  (.ret))

(defmethod set-char-y ((this vbuf) (y int8))
  (declare (asm-func none))
  (.ret))


(defmethod set-pixel-x ((this vbuf) (x int16))
  (declare (asm-func none))
  (.ret))

(defmethod set-pixel-y ((this vbuf) (y int8))
  (declare (asm-func none))
  (.ret))

(defblock vbuf-block 
      ;; дескриптор типа
      (.type-descriptor vbuf)   
  ) ;; end of block
) ;; end of segment

