
; ==============================================================================
; Base Driver 
; ==============================================================================

;;; FLags of all drivers
(defenum drvflags
  :type uint8
  :bitfield #t
  (api-has-irq_bit       0)       ; Использует прерывания
  (api-static-bit        1)       ; Статическое устройство (встроенное)
  (api-uses-dma_bit      2)       ; Использует DMA
  (api-banked-bit        3)       ; Работает с банковой памятью
  (api-power-save-bit    4)       ; Поддерживает энергосбережение
  (api-hotplug-bit       5)       ; Поддерживает горячее подключение
  (api-needs-context-bit 6)       ; Требует контекст (для MMU)
  (api-thread-safe-bit   7))      ; Потокобезопасный

;;; Standard driver command supported by all drivers
(defenum vbuf-command
  :type uint8
  (cmd-reset             #x10)) 

;;; Driver information
(deftype vbuf-info (driver-info)
  (
    (width  uint16) ;; pixels width
    (height uint16) ;; pixels height
    (bpp uint8)     ;; bits per pixel
    (bpl uint8)     ;; how many bytes in line
    (size uint16)   ;; bytes on screen
  )
)

;;; Basic driver
(deftype vbuf (driver)
  (
    (bg-color uint8)
    (fg-color uint8)
  )
 (:methods
   
    ))


(with-segment  code
  (defblock vbuf_16k1b 
    (zasm
      (.static-new fvbuf-16k1b-info vbuf-info 
          :width 640
          :height 200
          :bpp 1
          :bpl 80
          :size 16000
          )

      ) ;; end of zasm
  ) ;; end of block


) ;; end of segment