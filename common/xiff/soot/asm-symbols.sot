;; Маленький помощник для динамического разыменования через ->
(defun baz (n) n)

(defun format-label-meta (m)
  (if (or (null? m) (eq? m '(ctx)))
      '()  ;; Убираем ctx или null
      m))  ;; Оставляем полезные данные

(defun module-segments-list (mod)
  (let ((lst '()))
    (begin
      (hash-table-for-each (module-segments mod)
        (lambda (name obj) (set! lst (cons obj lst))))
      lst)))

(defun get-label-info (buffer label-name)
  "Извлекает данные конкретной метки."
  ;; baz заставляет интерпретатор вычислить переменную label-name
  (let ((label (-> buffer (baz label-name))))
    (list 
      :address              
      (string->symbol (fmt #f "#x{:04X}" (-> label addr)))      
      :name
      label-name           
      :segment               
      (-> label segment)   
      :meta
      (format-label-meta (-> label meta)))))   

(defun collect-segment-symbols (seg)
  "Собирает список всех меток сегмента."
  (let* ((buffer (segment-buffer seg))
         (names  (-> buffer labels)))
    (map (lambda (name) (get-label-info buffer name))
         names)))

(defun save-module-symbols (path mod &optional (target-segments '()))
  (let* ((segs (module-segments-list mod))
         (all-symbols '()))
    (begin
      (for-each segs
        (lambda (seg)
          (let ((s-name (segment-name seg)))
            (if (or (null? target-segments) (member s-name target-segments))
                (set! all-symbols (append all-symbols (collect-segment-symbols seg)))))))

      (let* ((exports (map (lambda (s) (list (nth 3 s) (nth 1 s))) 
                          (filter (lambda (s) (eq? (car s) :public)) all-symbols)))
             (output  (list (string->symbol (module-name mod))
                            (cons :symbols all-symbols))))
        (begin
          (write-text-file path (pfmt #f "{}" output))
          (fmt #t "Passport saved: {} symbols in {}\n" (length all-symbols) path))))))