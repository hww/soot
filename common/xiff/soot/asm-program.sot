;; Helpers

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Utilities
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun lower-byte (bla)
   "Get the lower byte of the integer"
   (logand bla #b11111111))

(defun higher-byte (bla)
   "Get the higher byte of the integer"
   (logand (rshift bla 8) #b11111111))

(defun substitute (new old lst)
  "Replace all occurrences of OLD with NEW in list LST.
   Returns a new list with the replacements made.
   
   Example:
   (substitute 'x 'y '(a y b y c)) 
   => (a x b x c)"
  (cond ((null? lst) '())
        ((eq? (car lst) old) 
         (cons new (substitute new old (cdr lst))))
        (#t (cons (car lst) (substitute new old (cdr lst))))))

(defun recsubstitute (dest source lis)
  "Recursively replace SOURCE with DEST throughout LIS.
   Works on nested lists and any level of structure.
   
   Arguments:
   - DEST:  The replacement value
   - SOURCE: The value to replace  
   - LIS: The input (list or atom)
   
   Returns: Structure with all SOURCE replaced by DEST.
   Note: Uses EQ for comparison at all levels."
   (cond
      ((eq? lis source)
         dest)
      ((list? lis)
         (cond
            ((null? lis) lis)
            (#t (mapcar (lambda (lis) (recsubstitute dest source lis))
                       lis))))
      (#t lis)))

(defun nsubstitute (new old lst)
  "Destructively replace OLD with NEW in list LST (modifies original).
   Uses SET-CAR! to mutate list cells in place.
   
   Arguments:
   - NEW: Replacement value
   - OLD: Value to replace
   - LST: List to modify (will be changed!)
   
   Returns: The modified list (same as input LST).
   Warning: Mutates the original list structure."
  (let ((current lst))
    (while (not (null? current))
      (if (eq? (car current) old)
          (set-car! current new)) 
      (set! current (cdr current)))
    lst)) 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lextoken - assembler lexical token container
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct lextoken (type null) (value null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Opcode - assembler instruction data container  
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct opcode
   "Assembler opcode"
   (documentation "")
   (op null)
   (arg1 null)
   (arg2 null)
   (arg3 null)
   (size 0)
   (pass1 null)
   (pass2 null)
   (pass3 null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Valid assembler instructions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; List of all assembler instructions
(defparameter
  *optable* (make-hash-table '() 200)
  "Opcode table for the assembler")

(defun hash-opcode (opc)
  "Enter an opcode into the assembler opcode table"
  (check-type opc opcode?)
  (let ((key (fmt #f "{} {} {} {}"  (opcode-op opc)
                                 (opcode-arg1 opc)
                                 (opcode-arg2 opc)
                                 (opcode-arg3 opc))))
    ;(fmt #t "hash-opcode :key {} :opc {}\n" key opc)                       
    (hash-table-set! *optable* key opc)))

(defun get-opc (opc &optional (arg1 null) (arg2 null) (arg3 null))
  "Get the hash-table entry for the corresponding opcode"
  (let* ((key (fmt #f "{} {} {} {}" opc  arg1 arg2 arg3)) 
         (val (hash-table-try-ref *optable* key)))
         ;(fmt #t "get-opc  :key {}\n" key)                       
         (if (car val)
          (cdr val)
          (error (fmt #f "Can't find opcode {}" key (source-info opc))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Instruction это инструкция ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct inst
   "Assembler instruction"
  (op null)
  (arg1 (make-lextoken :type null))
  (arg2 (make-lextoken :type null))
  (arg3 (make-lextoken :type null)))

;; Найти opcode для инструкции
(defun get-inst (inst)
  "Get the hash-table entry for the corresponding instruction"
  (check-type inst inst?)  
  ;(print `(get-inst ,(inspect inst)))
  (get-opc (inst-op inst) 
           (lextoken-type (inst-arg1 inst))
           (lextoken-type (inst-arg2 inst))
           (lextoken-type (inst-arg3 inst))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Asm Prog контейнер програмы
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct asm-prog
  "Assembler program, made of a list of instructions, a list of
   functions created by the instructions a symbol table, and an ilc"
  (insts null)
  ;(ifuncs null)
  (labs null)                 ;; Метки
  (ltable (make-hash-table))  ;;
  (ilc 0))                    ;;

(defun get-label (label prog)
  (let ((val (hash-table-try-ref (asm-prog-ltable prog) label)))
    ;(fmt #t "LOOKUP LABEL: name={} found-val={}\n" label val)
    (if (car val)
      (cdr val)
      (error (fmt #f "Can't find label {} in {}" label in (source-info label)))
    )))

(defun shift-label (label value prog)
  "Shift a label from program prog by the specified value"
  (let ((bla (get-label label prog)))
       (setf (gethash label (asm-prog-ltable prog))
             (+ bla value))))

(defun shift-following-labels (value prog)
  "Shift all the following labels stored in the label list of the
   specified program"
  (mapcar (lambda (label)
             (shift-label label value prog))
          (asm-prog-labs prog)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Обновление адресов и меток
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun update-addresses-and-labels (prog pass-num)
  (let ((current-ilc 0)
        (changed #f))
    (begin
      (asm-prog-ilc! prog 0)
      (mapcar (lambda (inst)
                (let ((opc (get-inst inst)))
                  (if (eq? (inst-op inst) 'lab)
                      ;; МЕТКА: фиксируем её текущий адрес
                      (let ((label-name (lextoken-value (inst-arg1 inst))))
                        (setf (gethash label-name (asm-prog-ltable prog)) current-ilc))
                      
                      ;; ИНСТРУКЦИЯ: берем размер из pass1 или pass2
                      (if opc
                          (let* ((old-op (inst-op inst))
                                 ;; Вызываем pass-функцию (pass1 или pass2)
                                 (res (if (= pass-num 1)
                                          ((opcode-pass1 opc) inst prog)
                                          ((opcode-pass2 opc) inst prog))))
                            (begin
                              ;; Если в Pass 2 инструкция вернула #t или сменила тип — флаг changed
                              (if (and (= pass-num 2) (not (eq? old-op (inst-op inst))))
                                  (set! changed #t))
                              
                              ;; Увеличиваем ILC на размер (для jmp/jr это будет 3 или 2)
                              (let ((size (if (integer? res) res (opcode-size opc))))
                                (set! current-ilc (+ current-ilc size)))))))))
              (asm-prog-insts prog))
      (asm-prog-ilc! prog current-ilc)
      changed)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Утилиты для сохранения в list файл
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun arg->string (arg)
  "Конвертировать агрумнт в строку для записи в листинг файл"
  (if (lextoken? arg)
      (let ((val (lextoken-value arg)))
        (if (or (null? val) (eq? val 'null))
            ""
            (fmt #f "{}" val)))
      ""))

(defun inst->string (inst)
  "Конвертировать инструкцию в строку для записи в листинг файл"
  (let ((op (inst-op inst))
        (a1 (arg->string (inst-arg1 inst)))
        (a2 (arg->string (inst-arg2 inst)))
        (a3 (arg->string (inst-arg3 inst))))
    (if (eq? op 'lab)
        (concat "label: " a1)
        (concat (fmt #f "{}" op)
                (if (not (string-empty? a1)) (concat " " a1) "")
                (if (not (string-empty? a2)) (concat ", " a2) "")
                (if (not (string-empty? a3)) (concat ", " a3) "")
                ;"   "
                ;(fmt #f "{}" (inspect inst))
                ))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Компиляция программы
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun assemble (prog)
  "Assemble an assembler program, go through pass 1, pass2 and then call
   all the functions returned by the instruction."
  (let ((bin-list '())
        (listing '()))
    (begin
      ;; --- Pass 1: Начальная разметка ---
      (update-addresses-and-labels prog 1)

      ;; --- Pass 2: Итеративная стабилизация ---
      (let ((is-changed #t)
            (max-iters 10)
            (i 0))
        (while (and is-changed (< i max-iters))
          (begin
            (set! is-changed (update-addresses-and-labels prog 2))
            (set! i (+ i 1)))))
      ;; --- Pass 2.5: Финальная расстановка меток ---
      (let ((current-ilc 0))
        (mapcar (lambda (inst)
                  (if (eq? (struct-ref inst :op) 'lab)
                      ;; Метка: записываем её ЖЕЛЕЗНЫЙ адрес в таблицу
                      (let ((name (lextoken-value (struct-ref inst :arg1))))
                        (setf (gethash name (asm-prog-ltable prog)) current-ilc))
                      ;; Инструкция: просто наращиваем ILC на её текущий размер
                      (let* ((opc (get-inst inst))
                            ;; Если jmp уже в режиме short, прибавляем 2, иначе 3
                            (size (if (and (eq? (struct-ref inst :op) 'jmp) 
                                            (eq? (struct-ref inst :mode) 'short))
                                      2 
                                      (opcode-size opc))))
                        (set! current-ilc (+ current-ilc size)))))
                (asm-prog-insts prog)))
      ;; --- Pass 3: Генерация кода ---
      (asm-prog-ilc! prog 0)
      (mapcar (lambda (inst)
                (let* ((opc (get-inst inst))
                       (addr (asm-prog-ilc prog))
                       (is-label (eq? (inst-op inst) 'lab))
                       (bytes (if (and opc (not is-label))
                                 ((opcode-pass3 opc) inst prog)
                                 '()))
                       (len 0))
                  (begin
                    (if (and opc (not is-label))
                        (begin
                          (cond 
                            ((vector? bytes) (set! len (vector-length bytes)))
                            ((pair? bytes) (set! len (length bytes)))
                            ((integer? bytes) (set! len 1))
                            (else (set! len 0)))
                          
                          ;; Сборка бинарника
                          (cond 
                            ((vector? bytes) (set! bin-list (append bin-list (vector->list bytes))))
                            ((pair? bytes) (set! bin-list (append bin-list bytes)))
                            ((integer? bytes) (set! bin-list (append bin-list (list bytes)))))
                          
                          (set! listing (append listing (list (list addr bytes (inst->string inst)))))
                          (asm-prog-ilc! prog (+ addr len)))
                        ;; Обработка метки в листинге
                        (set! listing (append listing (list (list addr '() (inst->string inst)))))))))
              (asm-prog-insts prog))
      
      (list (cons :bin bin-list) (cons :lst listing)))))

(defun save-listing (path lst-data)
  (let ((out ""))
    (begin
      (mapcar (lambda (row)
                (let* ((addr   (car row))
                       (bytes  (cadr row))
                       (src    (caddr row))
                       (is-lab (string-starts-with? src "label: "))
                       (b-str  ""))
                  
                  (if is-lab
                      ;; 1. МЕТКА: помещаем имя во вторую колонку
                      (let ((label-name (string-substr src 7 (string-length src))))
                        (set! b-str (concat label-name ":"))
                        (set! out 
                              (concat out 
                                      (fmt #f "{:04X} | {:15} | \n" 
                                           addr b-str))))
                      
                      ;; 2. ИНСТРУКЦИЯ: байты во второй, код в третьей
                      (begin
                        (if (and (not (null? bytes)) (not (eq? bytes 'null)))
                            (let ((b-list (if (list? bytes) bytes (list bytes))))
                              (mapcar (lambda (b) 
                                        (set! b-str (concat b-str (fmt #f "{:02X} " b))))
                                      b-list)))
                        (set! out 
                              (concat out 
                                      (fmt #f "{:04X} |   {:13} | {}\n" 
                                           addr b-str src)))))))
              lst-data)
      (write-text-file path out)
      (fmt #t "{}" out)
      null)))

(defun assemble-to-file (prog bin-path lst-path)
  (let* ((res (assemble prog))
         (bin-data (cdr (assoc :bin res)))
         (lst-data (cdr (assoc :lst res))))
    (begin
      ;; Записываем бинарный файл
      (write-binary-file bin-path bin-data)
      ;; Генерируем и записываем текстовый листинг
      (save-listing lst-path lst-data)
      (fmt #t "\nAssembly finished. Binary: {}, Listing: {}\n" bin-path lst-path)
      get_true)))

(defun assemble-raw-byte (prog file)
  (let ((bos (open file :direction :output
                        :if-does-not-exist :create
                        :element-type 'unsigned-byte
                        :if-exists :overwrite)))
       (if bos
           (begin 
             (assemble prog (lambda (byte) (write-byte byte bos)))
             (close bos)
             (fmt t "Program written to file {}\n" file))
           (fmt t "Program could not be written to file {}\n" file))))

(defun assemble-raw-byte (prog file)
   (begin 
      (assemble prog (lambda (byte) (write-byte byte bos)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Макросы для описания комманд ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Дополнительная интсрукция для отображения параметров
(defun inspect-inst (msg inst size r1 r2 r3) 
  (fmt #t "<inst {}  :op {}\n  :size {} \n  :r1 {}\n  :r2 {}\n  :r3 {}\n" msg (inspect inst-op) size msg r1 r2 r3))

;; Parse function for the appropriate assembler type
(defparameter *parse* null 
   "Parse function for the appropriate assembler type")

(defmacro operand (sym size documentation
                   &key (pass1 0) 
                        (pass2 0)
                        (pass3 '()) 
                        (arg1 null)
                        (arg2 null)
                        (arg3 null))
  `(begin
     (hash-opcode (make-opcode 
                    :documentation ,documentation
                    :op ',sym 
                    :size ,size 
                    :arg1 ',arg1
                    :arg2 ',arg2
                    :arg3 ',arg3
                    :pass1 (lambda (inst prog) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   ;; МАГИЯ: связываем имя геттера с самим объектом
                                   (inst-op inst)
                                   (size ,size)) 
                                   ;(inspect-inst "pass1" inst-op size r1 r2 r3)                                   
                               ,pass1))
                    :pass2 (lambda (inst prog) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   ;; МАГИЯ: теперь (struct-set! inst-op ...) сработает
                                   (inst-op inst)
                                   (size ,size))  
                                   ;(inspect-inst "pass2" inst-op size r1 r2 r3)                                 
                               ,pass2))
                    :pass3 (lambda (inst prog) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (inst-op inst)
                                   (size ,size))
                                   ;(inspect-inst "pass3" inst-op size r1 r2 r3)
                               ,pass3))))

     (defun ,sym (&optional (a1 (make-lextoken :type null))
                            (a2 (make-lextoken :type null))
                            (a3 (make-lextoken :type null)))
       (let ((bla1 (*parse* a1))
             (bla2 (*parse* a2))
             (bla3 (*parse* a3)))
         (make-inst :op ',sym :arg1 bla1
                              :arg2 bla2
                              :arg3 bla3)))))

;; Es ist immer ein bisschen laestig, alles doppelt hinzuschreiben, wenn
;; ein Opcode eine Adresse als Argument annimmt (symbol oder numerischer
;; Wert). Die Soperand Macro ersetzt sowas automatisch.
(defmacro soperand (sym size documentation
                    &key (pass1 size) (pass2 size) (pass3 '()) 
                         (arg1 null) (arg2 null) (arg3 null) (relative #f))
   (let* ((arg-list (list arg1 arg2 arg3))
          (arglis  (nsubstitute 'asmsym-indirect 'var-indirect
                    (nsubstitute 'asmsym 'variable (copy-list arg-list))))
          (arglis1 (nsubstitute 'imm-indirect 'var-indirect
                    (nsubstitute 'number 'variable (copy-list arg-list)))))
               
        `(begin
            ;; ВАРИАНТ ДЛЯ МЕТОК
            (operand ,sym ,size ,documentation
                     :pass1 ,pass1 :pass2 ,pass2
                     :arg1 ,(car arglis) :arg2 ,(cadr arglis) :arg3 ,(caddr arglis)
                     :pass3 (let* ((r1-raw (get-label r1 prog))
                                   (r2-raw (if (or (eq? ',arg2 'variable) (eq? ',arg2 'var-indirect)) (get-label r2 prog) r2))
                                   (r3-raw (if (or (eq? ',arg3 'variable) (eq? ',arg3 'var-indirect)) (get-label r3 prog) r3))
                                   ;; ПЕРЕОПРЕДЕЛЯЕМ r1, r2, r3 для твоего кода
                                   (r1 ,(if relative 
                                            `(logand (- r1-raw (+ (asm-prog-ilc prog) ,size)) 255)
                                            'r1-raw))
                                   (r2 r2-raw)
                                   (r3 r3-raw))
                              ,pass3))

            ;; ВАРИАНТ ДЛЯ ЧИСЕЛ
            (operand ,sym ,size ,documentation
                     :pass1 ,pass1 :pass2 ,pass2
                     :arg1 ,(car arglis1) :arg2 ,(cadr arglis1) :arg3 ,(caddr arglis1)
                     :pass3 ,pass3))))

(operand lab 0
     "Label in the assembler program"
     :pass1 
        (begin
           (push! r1 (asm-prog-labs prog))
           (setf (gethash r1 (asm-prog-ltable prog))
                 (asm-prog-ilc prog))
        0)
     :pass3
        (begin 
           (fmt #t "Label `{}` at ILC `{}`.\n" r1 (asm-prog-ilc prog))
           (get-label r1 prog)
           '())
     :arg1 asmsym)

(define *asm-program-loader* #t)

(fmt #t "Loaded asm-program-loader\n")
