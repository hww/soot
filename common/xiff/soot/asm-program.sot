;; Helpers

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Utilities
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun lower-byte (bla)
   "Get the lower byte of the integer"
   (logand bla #b11111111))

(defun higher-byte (bla)
   "Get the higher byte of the integer"
   (logand (rshift bla 8) #b11111111))

(defun substitute (new old lst)
  "Replace all occurrences of OLD with NEW in list LST.
   Returns a new list with the replacements made.
   
   Example:
   (substitute 'x 'y '(a y b y c)) 
   => (a x b x c)"
  (cond ((null? lst) '())
        ((eq? (car lst) old) 
         (cons new (substitute new old (cdr lst))))
        (#t (cons (car lst) (substitute new old (cdr lst))))))

(defun recsubstitute (dest source lis)
  "Recursively replace SOURCE with DEST throughout LIS.
   Works on nested lists and any level of structure.
   
   Arguments:
   - DEST:  The replacement value
   - SOURCE: The value to replace  
   - LIS: The input (list or atom)
   
   Returns: Structure with all SOURCE replaced by DEST.
   Note: Uses EQ for comparison at all levels."
   (cond
      ((eq? lis source)
         dest)
      ((list? lis)
         (cond
            ((null? lis) lis)
            (#t (mapcar (lambda (lis) (recsubstitute dest source lis))
                       lis))))
      (#t lis)))

(defun nsubstitute (new old lst)
  "Destructively replace OLD with NEW in list LST (modifies original).
   Uses SET-CAR! to mutate list cells in place.
   
   Arguments:
   - NEW: Replacement value
   - OLD: Value to replace
   - LST: List to modify (will be changed!)
   
   Returns: The modified list (same as input LST).
   Warning: Mutates the original list structure."
  (let ((current lst))
    (while (not (null? current))
      (if (eq? (car current) old)
          (set-car! current new)) 
      (set! current (cdr current)))
    lst)) 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lextoken - assembler lexical token container
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct lextoken (type null) (value null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Opcode - assembler instruction data container  
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct opcode
   "Assembler opcode"
   (documentation "")
   (op null)
   (arg1 null)
   (arg2 null)
   (arg3 null)
   (size 0)
   (pass1 null)
   (pass2 null)
   (pass3 null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Valid assembler instructions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; List of all assembler instructions
(defparameter *optable* (make-hash-table '() 200)
  "Opcode table for the assembler")

(defun %make-raw-key (op-name a1 a2 a3)
  "Создает строку ключа из названия и типов аргументов"
  (fmt #f "{} {} {} {}" op-name a1 a2 a3))

(defun %make-opcode-key (opc)
  "Генерация строкового ключа для таблицы опкодов"
  ;; Добавляем открывающую скобку перед fmt
  (%make-raw-key 
       (opcode-op opc)
       (opcode-arg1 opc)
       (opcode-arg2 opc)
       (opcode-arg3 opc))) 

(defun %normalize-type (type)
  (cond
    ((eq? type 'number)   'variable)
    ((eq? type 'asmsym)   'variable)
    ((eq? type 'list)     'variable) ;; <-- Вот этот парень спасет ситуацию
    ((eq? type 'string)   'variable)
    (else type))) ;; Регистры (a, hl, и т.д.) остаются как есть

(defun set-opcode (opc)
  "Enter an opcode into the assembler opcode table"
  (check-type opc opcode?)
  (let ((key (%make-opcode-key opc)))
    ;(fmt #t "set-opcode :key {} :opc {}\n" key opc)                       
    (hash-table-set! *optable* key opc)))

(defun get-opcode (op-name &optional (arg1 null) (arg2 null) (arg3 null))
  "Умный поиск: сначала Exact Match, затем Fallback к 'variable'"
  (let* ((exact-key (%make-raw-key op-name arg1 arg2 arg3))
         (val       (hash-table-try-ref *optable* exact-key)))
    
    (cond 
      ;; 1. Нашли точное совпадение (например, LD A number)
      ((car val) (cdr val))
      
      ;; 2. Если не нашли, пробуем нормализовать типы в 'variable
      (#t 
       (let* ((n-key (%make-raw-key op-name 
                                   (%normalize-type arg1)
                                   (%normalize-type arg2)
                                   (%normalize-type arg3)))
              (n-val (hash-table-try-ref *optable* n-key)))
         
         (if (car n-val)
             (cdr n-val) ;; Нашли обобщенную версию
             ;; 3. Ошибка, если вообще ничего не подошло
             (error (fmt #f "Can't find opcode. Tried: '{}' and '{}'" 
                         exact-key n-key) 
                    (source-info op-name))))))))
                    
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Instruction это инструкция ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct inst
   "Assembler instruction"
  (op null)
  (arg1 (make-lextoken :type null))
  (arg2 (make-lextoken :type null))
  (arg3 (make-lextoken :type null))
  (ctx null)
  (ilc 0)
  (bin null)
  (size 0))

(defun get-inst (inst)
  "Найти opcode для конкретной инструкции в программе"
  (check-type inst inst?)  
  (get-opcode (inst-op inst) 
              (lextoken-type (inst-arg1 inst))
              (lextoken-type (inst-arg2 inst))
              (lextoken-type (inst-arg3 inst))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Asm Segment контейнер 
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct segment
  "Assembler program container"
  (name "undefined-segment-name")
  (insts null)
  (labs null)
  (ltable (make-hash-table))
  (ilc 0)          ;; Текущий ILC внутри прохода
  (origin 0)       ;; Локальный origin (если есть ORG внутри)
  (base-addr 0)    ;; Начальный адрес сегмента в модуле
  (parent-module null))

(defun emit (mod inst)
  "Добавляет инструкцию в текущий сегмент модуля"
  (let ((seg (module-current-segment mod)))
    (if (not (null? seg))
        (setf (segment-insts seg) (cons inst (segment-insts seg)))
        (error "No segment selected! Use (select-segment mod name) first."))))

(defun set-org! (seg addr) 
    (segment-origin! seg addr) 
    (segment-ilc!    seg addr))

;;; ------------------------------------------------------------------
;;; Внутренние утилиты (Private)
;;; ------------------------------------------------------------------

(defun %asm-extract-name (input ctx)
  (cond 
    ;; Если это уже число (прямой адрес), просто возвращаем его
    ((integer? input) input)
    ;; Если это строка — как есть
    ((string? input) input)
    ;; Если это символ (цитата 'blo) — в строку
    ((symbol? input) (symbol->string input))
    ;; Если это структура (токен)
    ((hash-table? input)
     (cond 
       ((hash-table-contains? input :value) 
        (%asm-extract-name (hash-table-ref input :value) ctx))
       (else 
        (error (fmt #f "Cannot extract name/address from struct. Keys: {}" 
                    (hash-table->keys input)) ctx))))
    (else 
     (error (fmt #f "Expected label, name or address, got: {}" input) ctx))))



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Asm Module контейнер 
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct module
  (name "unnamed")
  (segments (make-hash-table))  ;; Хэш-таблица: имя-строка -> объект segment
  (segment-order '())           ;; Список имен сегментов в порядке их появления
  (symbols (make-hash-table))   ;; Глобальная таблица символов (имя -> адрес)
  (current-segment null))       ;; Ссылка на активный в данный момент segment

(defun make-new-module (name)
  "Создает новый модуль и инициализирует его"
  (make-module :name name
               :segments (make-hash-table '() 20)
               :symbols (make-hash-table '() 200)
               :segment-order '()
               :current-segment null))

(defun select-segment (mod seg-name)
  "Переключает активный сегмент в модуле. Создает новый, если нужно."
  ;; Используем try-ref, чтобы безопасно проверить наличие ключа
  (let* ((segments-map (module-segments mod))
         (val-pair (hash-table-try-ref segments-map seg-name)))
    
    (if (car val-pair)
        ;; 1. Нашли! Просто делаем его активным
        (setf (module-current-segment mod) (cdr val-pair))
        
        ;; 2. Не нашли — создаем с нуля
        (let ((new-seg (make-segment :name seg-name 
                                     :parent-module mod
                                     :ltable (make-hash-table)))) ;; Не забываем инициализировать таблицу
          (begin
            (hash-table-set! segments-map seg-name new-seg)
            ;; Добавляем в список порядка, чтобы знать, кто за кем идет
            (setf (module-segment-order mod) 
                  (append (module-segment-order mod) (list seg-name)))
            (setf (module-current-segment mod) new-seg))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Метки
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct asmsym-info
  (address 0)
  (scope :private)  ;; :public или :private
  (type :label)     ;; :function, :variable, :const
  (signature '())   ;; (int int) и т.д.
  (segment-name ""))

(defun set-label-full! (name seg scope type sig ctx)
  (let* ((mod (segment-parent-module seg))
         (info (make-asmsym-info 
                 :address (get-abs-pc seg)
                 :scope scope
                 :type type
                 :signature sig
                 :segment-name (segment-name seg))))
    (cond
      ;; Если модуль есть — пишем в глобальную таблицу
      ((not (null? mod))
       (hash-table-set! (module-symbols mod) name info))
      ;; Если модуля нет (тестовый режим) — пишем в локальную таблицу сегмента
      (#t 
       (hash-table-set! (segment-ltable seg) name info)))))

(defun get-meta (lst key)
  "Ищет значение ключа в списке метаданных метки.
   Пример: (get-meta '(my-func :scope :public) :scope) => :public"
  (let ((found (member key lst)))
    (if (and found (not (null? (cdr found))))
        (cadr found)
        null)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; управление метками
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun get-abs-pc (seg)
  "Возвращает текущий виртуальный адрес (только ILC)."
  (segment-ilc seg))

(defun set-label-addr! (label seg ctx)
  "Регистрирует метку в глобальной таблице модуля через текущий сегмент."
  (let* ((name (%asm-extract-name label ctx))
         (addr (get-abs-pc seg))
         (mod  (segment-parent-module seg)))
    (if (not (null? mod))
        (setf (gethash name (module-symbols mod)) addr)
        ;; Фолбек для тестов, если модуль не задан
        (setf (gethash name (segment-ltable seg)) addr))))

(defun get-label-addr (label seg &optional ctx)
  (let* ((name (%asm-extract-name label ctx))
         (mod  (segment-parent-module seg))
         ;; Выбираем таблицу: либо модуля, либо сегмента
         (sym-table (if (not (null? mod)) 
                        (module-symbols mod) 
                        (segment-ltable seg))))
    (let ((val (hash-table-try-ref sym-table name)))
      (if (car val)
          (let ((info (cdr val)))
            (if (asmsym-info? info) 
                (asmsym-info-address info) 
                info)) ;; возвращаем как есть, если это просто число
          (error (fmt #f "Undefined label: {}" name) ctx)))))



(defun get-label-addr-optional (label seg ctx)
  "Мягкое получение адреса: достает число из структуры asmsym-info, если она там есть."
  (if (number? label)
      label
      (let* ((name (%asm-extract-name label ctx))
             (mod  (segment-parent-module seg))
             (sym-table (if (not (null? mod)) (module-symbols mod) (segment-ltable seg)))
             (val (hash-table-try-ref sym-table name)))
        (if (car val) 
            (let ((info (cdr val)))
              (cond 
                ;; Если это наша новая структура — вынимаем поле address
                ((asmsym-info? info) (asmsym-info-address info))
                ;; Если там просто число (старый формат) — возвращаем как есть
                ((number? info) info)
                (else #f)))
            #f))))


(defun get-rel-offset (label seg ctx &optional (pc-offset 2))
  "Расчет относительного смещения для Z80 (Target - (PC + offset)).
   Использует строгое получение адреса для генерации кода."
  (let ((target (get-label-addr label seg ctx))
        (current-pc (get-abs-pc seg)))
    ;(cfmt #t 'yellow "get-rel-offset :target {} :current-pc {}\n" target current-pc) 
    (- target (+ current-pc pc-offset))))



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Выполняет проход с номером 1, 2 или 3
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun assemble-segment-pass (seg pass-num)
  (let ((bin-list '()))
    (begin
      ;; Инициализируем ILC перед началом прохода
      (segment-ilc! seg (segment-base-addr seg))
      (segment-origin! seg (segment-base-addr seg))

      (for-each (segment-insts seg)
        (lambda (inst)
          (cond 
            ;; 1. Обработка инструкции
            ((inst? inst)
             (let* ((opc (get-inst inst))
                    (pass-f (case pass-num 
                              (1 (opcode-pass1 opc)) 
                              (2 (opcode-pass2 opc)) 
                              (3 (opcode-pass3 opc))))
                    ;; Вызываем функцию прохода
                    (res (if (procedure? pass-f) (pass-f inst seg) null)))
               (begin
                  (inst-ilc! inst (segment-ilc seg))
                  ;(cfmt #t "red" " 0x{:04X} \n" (inst-ilc inst))
                  ;; На 3-м проходе собираем бинарник, если функция что-то родила
                  (if (and (eq? pass-num 3) (not (null? res)))
                      (begin
                        ;; 1. Сохраняем байты (БЕЗ ELSE, это должно работать всегда)
                        (inst-bin! inst res)
                        (set! bin-list (append bin-list (if (list? res) res (list res))))
                        ;; 2. Печатаем лог для отладки
                        ;(cfmt #t "blue" "assemble-segment-pass {} ilc 0x{:04X} op {} result {}\n" pass-num (segment-ilc seg)  (inst-op inst) res)
                        ))
                 
                 ;; ЛОГИКА ОПРЕДЕЛЕНИЯ ДЛИНЫ (sz):
                 (let ((sz (cond 
                             ;; Если функция вернула число (дельту)
                             ((number? res) res)
                             ;; Если функция вернула список байт — считаем их
                             ((and (list? res) (not (null? res))) (length res))
                             ;; ЕСЛИ ФУНКЦИЯ ВЕРНУЛА NULL ИЛИ НИЧЕГО:
                             ;; Берем константу :size из самого операнда!
                             (else (opcode-size opc)))))
                   (begin
                     ;(cfmt #t "blue" "assemble-segment-pass {} ilc 0x{:04X} op {} result {} normalized {}\n" pass-num (segment-ilc seg)  (inst-op inst) res sz)                 
                     ;; Сохраняем вычисленную длину в саму инструкцию (для листинга/отладки)
                     (struct-set! inst :size sz)
                     ;; Двигаем ILC сегмента
                     (segment-ilc! seg (+ (segment-ilc seg) sz)))))))
            
            ;; 2. Обработка метки
            ((asmsym? inst) 
             (if (eq? pass-num 1)
                 (register-label (asmsym-name inst) (segment-ilc seg) seg)))

            (else null))))
      
      ;; Возвращаем результат: для Pass 3 — байты, для остальных — финальный ILC
      (if (eq? pass-num 3) bin-list (segment-ilc seg)))))

(defun assemble-module (mod)
  (let ((current-addr 0)
        (final-bin '()))
    (begin
      ;; 1. PASS 1: Сбор меток (Глобально)
      (set! current-addr 0)
      (for-each (module-segment-order mod)
        (lambda (name)
          (let ((seg (hash-table-ref (module-segments mod) name)))
            (begin
              (segment-base-addr! seg current-addr)
              (set! current-addr (assemble-segment-pass seg 1))))))

      ;; 2. PASS 2: Мутации и расчет смещений (Глобально)
      (set! current-addr 0)
      (for-each (module-segment-order mod)
        (lambda (name)
          (let ((seg (hash-table-ref (module-segments mod) name)))
            (begin
              (segment-base-addr! seg current-addr)
              (set! current-addr (assemble-segment-pass seg 2))))))

      ;; 3. PASS 3: Генерация байт
      (for-each (module-segment-order mod)
        (lambda (name)
          (let* ((seg (hash-table-ref (module-segments mod) name))
                 (seg-bytes (assemble-segment-pass seg 3)))
            (set! final-bin (append final-bin seg-bytes)))))

      (save-module-symbols (fmt #f "{}.sym.sot" (module-name mod)) mod)
      final-bin)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Запись результата
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(load "common/xiff/soot/asm-save-list.sot")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Запись результата
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun assemble-to-file (seg bin-path lst-path)
  (let* ((res (assemble seg))
         (bin-data (cdr (assoc :bin res)))
         (lst-data (cdr (assoc :lst res))))
    (begin
      ;; Записываем бинарный файл
      (write-binary-file bin-path bin-data)
      ;; Генерируем и записываем текстовый листинг
      (save-listing lst-path lst-data)
      (fmt #t "\nAssembly finished. Binary: {}, Listing: {}\n" bin-path lst-path)
      get_true)))

(defun assemble-raw-byte (seg file)
  (let ((bos (open file :direction :output
                        :if-does-not-exist :create
                        :element-type 'unsigned-byte
                        :if-exists :overwrite)))
       (if bos
           (begin 
             (assemble seg (lambda (byte) (write-byte byte bos)))
             (close bos)
             (fmt t "Program written to file {}\n" file))
           (fmt t "Program could not be written to file {}\n" file))))

(defun assemble-raw-byte (seg file)
   (begin 
      (assemble seg (lambda (byte) (write-byte byte bos)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Symbol Table Export
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun %calculate-module-size (mod)
  "Считает суммарный размер всех сегментов модуля."
  (let ((total 0))
    (begin
      (for-each (module-segment-order mod)
        (lambda (name)
          (let ((seg (hash-table-ref (module-segments mod) name)))
            ;; Размер сегмента — это разница между финальным ILC и базовым адресом
            (set! total (+ total (- (segment-ilc seg) (segment-base-addr seg)))))))
      total)))

(load "common/xiff/soot/asm-save-symbols.sot")

(defun get-module-binary (mod)
  (let ((total-bin '()))
    (begin
      ;; Проходим по именам сегментов в правильном порядке
      (vector-for-each (module-segment-order mod)
        (lambda (seg-name)
          (let* ((seg (hash-table-ref (module-segments mod) seg-name))
                 (seg-bin (segment-binary-data seg))) ;; Тут лежат данные из pass3
            (set! total-bin (append total-bin seg-bin)))))
      total-bin)))
      
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; эти методы используются внутри макросов
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Получить адрес (число или адрес метки)
(defun get-addr (v seg ctx)
 (cond 
  ((integer? v) v) 
  ((symbol? v) (get-label-addr v seg ctx)) 
  (else (error (fmt #f "Invalid address: {}" v) ctx))))

(defun get-addr-list (v seg ctx)
  (cond 
    ((null? v) '())
    ((list? v) (mapcar (lambda (item) (get-addr item seg ctx)) v))
    (#t (list (get-addr v seg ctx))))) ;; Используй t или else
     
;; Получить относительное смещение для JR
(defun get-rel-offset (label seg ctx inst-size)
  (let* ((target (get-addr label seg ctx))
         (current-pc (get-abs-pc seg))
         ;; Вычисляем дельту относительно адреса следующей инструкции
         (offset (- target (+ current-pc inst-size))))
    
    ;; --- ПРОВЕРКА НА ПЕРЕПОЛНЕНИЕ ---
    (if (or (< offset -128) (> offset 127))
        (error (fmt #f "Relative jump to '{}' is out of range. Offset is {} bytes, but must be between -128 and 127." label offset) ctx)
        
        ;; Если всё ок, возвращаем байт (маскируем отрицательное число)
        (logand offset #xFF))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Макросы для описания комманд ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Дополнительная интсрукция для отображения параметров
(defun inspect-inst (msg inst size r1 r2 r3) 
  (fmt #t "<inst {}  :op {}\n  :size {} \n  :r1 {}\n  :r2 {}\n  :r3 {}\n" msg (inspect inst-op) size msg r1 r2 r3))

;; Parse function for the appropriate assembler type
(defparameter *parse* null 
   "Parse function for the appropriate assembler type")

(defmacro operand (sym size documentation
                   &key (pass1 null) 
                        (pass2 null)
                        (pass3 '()) 
                        (arg1 null) (arg2 null) (arg3 null)
                        (relative #f))
  `(begin
     (set-opcode (make-opcode 
                    :documentation ,documentation
                    :op ',sym :size ,size 
                    :arg1 ',arg1 :arg2 ',arg2 :arg3 ',arg3
                    :pass1 (lambda (inst seg) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst))) 
                               ,pass1))
                    :pass2 (lambda (inst seg) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst))) 
                               ,pass2))
                    :pass3 (lambda (inst seg) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst)))
                               ,pass3))))

     (defun ,sym (&optional (a1 (make-lextoken :type null))
                            (a2 (make-lextoken :type null))
                            (a3 (make-lextoken :type null)))
       (let ((bla1 (*parse* a1)) (bla2 (*parse* a2)) (bla3 (*parse* a3)))
         (make-inst :op ',sym :arg1 bla1 :arg2 bla2 :arg3 bla3 :ctx (get-context 3))))))


(operand lab 0 "Enhanced Label with Metadata"
  :arg1 variable ;; r1 теперь может быть именем или списком (имя :scope :type :sig)
  :pass1 (let* ((meta (if (list? r1) r1 (list r1))) ;; нормализуем к списку
                (name (car meta))
                (scope (or (get-meta meta :scope) :private))
                (type  (or (get-meta meta :type)  :label))
                (sig   (or (get-meta meta :sig)   '())))
           (begin 
             (set-label-full! name seg scope type sig ctx) 
             0))
  :pass2 (let ((name (if (list? r1) (car r1) r1)))
           (begin 
             (set-label-addr! name seg ctx) ;; Обновляем адрес на 2-м проходе
             0))
  :pass3 '())

(defmacro subroutine (name &rest code)
   `(list (lab ',name) ,@code))




(defparameter *current-module* null)

(defmacro defmodule (name)
  `(begin 
    (define ,name (make-new-module ,(symbol->string name)))
    (set! *current-module* ,name)))

(defmacro in-module (name)
  ;; Здесь можно добавить логику поиска модуля в глобальном реестре
  `(set! *current-module* (find-module ,(symbol->string name))))

(defmacro zasm (&rest body)
  `(begin
     (if (null? *current-module*) (error "No module selected! Use (defmodule ...)"))
     ;; По умолчанию льем в "MAIN", если внутри нет директивы segment
     (let ((current-seg-name "MAIN"))
       (let ((insts (flatten (list ,@body))))
         (begin
           (if (not (hash-table-contains? (module-segments *current-module*) current-seg-name))
               (select-segment *current-module* current-seg-name))
           (let ((seg (hash-table-ref (module-segments *current-module*) current-seg-name)))
             (setf (segment-insts seg) insts)
             seg))))))

(defun save-binary (mod &optional (seg-name null))
  (if (null? seg-name)
      ;; Сохраняем весь модуль (все сегменты подряд)
      (write-binary-file (fmt #f "{}.bin" (module-name mod)) (assemble-module mod))
      ;; Сохраняем конкретный сегмент
      (let ((seg (hash-table-ref (module-segments mod) seg-name)))
        (write-binary-file (fmt #f "{}-{}.bin" (module-name mod) seg-name) 
                           (assemble-segment-pass seg 3)))))

(defun save-symbols (mod)
  (let ((filename (fmt #f "{}.sym.sot" (module-name mod))))
    (begin
      (save-module-symbols filename mod)
      (cfmt #t "green" "Symbols saved: {}\n" filename))))

(defmacro build (mod &key (with-listing #f) (print-listing #f))
  `(begin
     (assemble-module ,mod)
     (cfmt #t "yellow" "\n──────────────────────────────────────────\n")
     (cfmt #t "white"  " BUILD SUCCESSFUL: {:15} \n" (module-name ,mod))
     (cfmt #t "yellow" "──────────────────────────────────────────\n")
     (for-each (module-segment-order ,mod)
       (lambda (name)
         (let ((seg (hash-table-ref (module-segments ,mod) name)))
           (cfmt #t "cyan" " Segment: {:10} | Base: #{:04X} | Size: {} bytes\n" 
                 name (segment-base-addr seg) (segment-ilc seg)))))
     (cfmt #t "yellow" "──────────────────────────────────────────\n")
     ;; Добавляем запятые перед аргументами макроса:
     (if ,with-listing
       (generate-module-listing ,mod :print-listing ,print-listing))))

(define *segmentram-loader* #t)

(fmt #t "Loaded segmentram-loader\n")
