;; Helpers

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Utilities
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun lower-byte (bla)
   "Get the lower byte of the integer"
   (logand bla #b11111111))

(defun higher-byte (bla)
   "Get the higher byte of the integer"
   (logand (rshift bla 8) #b11111111))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lextoken - assembler lexical token container
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct lextoken (type null) (value null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Opcode - assembler instruction data container  
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct opcode
   "Assembler opcode"
   (documentation "")
   (op null)
   (arg1 null)
   (arg2 null)
   (arg3 null)
   (size 0)
   (pass1 null)
   (pass2 null)
   (pass3 null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Valid assembler instructions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; List of all assembler instructions
(defparameter *optable* (make-hash-table '() 200)
  "Opcode table for the assembler")

(defun %make-raw-key (op-name a1 a2 a3)
  "Создает строку ключа из названия и типов аргументов"
  (fmt #f "{} {} {} {}" op-name a1 a2 a3))

(defun %make-opcode-key (opc)
  "Генерация строкового ключа для таблицы опкодов"
  ;; Добавляем открывающую скобку перед fmt
  (%make-raw-key 
       (opcode-op opc)
       (opcode-arg1 opc)
       (opcode-arg2 opc)
       (opcode-arg3 opc))) 

(defun %normalize-type (type)
  (cond
    ((eq? type 'number)   'variable)
    ((eq? type 'asmsym)   'variable)
    ((eq? type 'list)     'variable) ;; <-- Вот этот парень спасет ситуацию
    ((eq? type 'string)   'variable)
    (else type))) ;; Регистры (a, hl, и т.д.) остаются как есть

(defun set-opcode (opc)
  "Enter an opcode into the assembler opcode table"
  (check-type opc opcode?)
  (let ((key (%make-opcode-key opc)))
    ;(fmt #t "set-opcode :key {} :opc {}\n" key opc)                       
    (hash-table-set! *optable* key opc)))

(defun get-opcode (op-name &optional (arg1 null) (arg2 null) (arg3 null))
  "Умный поиск: сначала Exact Match, затем Fallback к 'variable'"
  (let* ((exact-key (%make-raw-key op-name arg1 arg2 arg3))
         (val       (hash-table-try-ref *optable* exact-key)))
    
    (cond 
      ;; 1. Нашли точное совпадение (например, LD A number)
      ((car val) (cdr val))
      
      ;; 2. Если не нашли, пробуем нормализовать типы в 'variable
      (#t 
       (let* ((n-key (%make-raw-key op-name 
                                   (%normalize-type arg1)
                                   (%normalize-type arg2)
                                   (%normalize-type arg3)))
              (n-val (hash-table-try-ref *optable* n-key)))
         
         (if (car n-val)
             (cdr n-val) ;; Нашли обобщенную версию
             ;; 3. Ошибка, если вообще ничего не подошло
             (error (fmt #f "Can't find opcode. Tried: '{}' and '{}'" 
                         exact-key n-key) 
                    (source-info op-name))))))))
                    
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Instruction это инструкция ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct inst
   "Assembler instruction"
  (op null)
  (arg1 (make-lextoken :type null))
  (arg2 (make-lextoken :type null))
  (arg3 (make-lextoken :type null))
  (ctx null)
  (ilc 0)
  (bin null)
  (size 0))

(defun get-inst (inst)
  "Найти opcode для конкретной инструкции в программе"
  (check-type inst inst?)  
  (get-opcode (inst-op inst) 
              (lextoken-type (inst-arg1 inst))
              (lextoken-type (inst-arg2 inst))
              (lextoken-type (inst-arg3 inst))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Asm Segment контейнер 
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct segment
  "Assembler program container"
  (name "undefined-segment-name")
  (insts null)
  (labs null)
  (ilc 0)          ;; Текущий ILC внутри прохода
  (origin 0)       ;; Локальный origin (если есть ORG внутри)
  (base-addr 0)    ;; Начальный адрес сегмента в модуле
  (parent-module null)
  (buffer null))

(defun make-new-segment (&key name parent-module)
  (let ((seg (make-segment :name name 
                           :parent-module parent-module 
                           :buffer (make-buffer name 65536 0)))) ;; Создаем C++ объект
    seg))

(defun emit (mod inst)
  "Добавляет инструкцию в текущий сегмент модуля"
  (let ((seg (module-current-segment mod)))
    (if (not (null? seg))
        (setf (segment-insts seg) (cons inst (segment-insts seg)))
        (error "No segment selected! Use (select-segment mod name) first."))))

(defun set-org! (seg addr) 
  (begin
    ;; 1. Синхронизируем Lisp
    (segment-origin! seg addr) 
    (segment-ilc!    seg addr)
    ;; 2. Синхронизируем C++ объект
    ;; Предполагаю, у тебя есть метод (buffer-set-origin buf addr)
    (let ((cell (-> (segment-buffer seg) origin)))
    (set! cell addr))))

;;; ------------------------------------------------------------------
;;; Внутренние утилиты (Private)
;;; ------------------------------------------------------------------

(defun %asm-extract-name (input ctx)
  (cond 
    ;; Если это уже число (прямой адрес), просто возвращаем его
    ((integer? input) input)
    ;; Если это строка — как есть
    ((string? input) input)
    ;; Если это символ (цитата 'blo) — в строку
    ((symbol? input) (symbol->string input))
    ;; Если это структура (токен)
    ((hash-table? input)
     (cond 
       ((hash-table-contains? input :value) 
        (%asm-extract-name (hash-table-ref input :value) ctx))
       (else 
        (error (fmt #f "Cannot extract name/address from struct. Keys: {}" 
                    (hash-table->keys input)) ctx))))
    (else 
     (error (fmt #f "Expected label, name or address, got: {}" input) ctx))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Asm Module контейнер 
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct module
  (name "unnamed")
  (segments (make-hash-table))  ;; Хэш-таблица: имя-строка -> объект segment
  (segment-order '())           ;; Список имен сегментов в порядке их появления
  (symbols (make-hash-table))   ;; Глобальная таблица символов (имя -> адрес)
  (current-segment null))       ;; Ссылка на активный в данный момент segment

(defun make-new-module (name)
  "Создает новый модуль и инициализирует его"
  (make-module :name name
               :segments (make-hash-table '() 20)
               :symbols (make-hash-table '() 200)
               :segment-order '()
               :current-segment null))

(defun select-segment (mod seg-name)
  "Переключает активный сегмент в модуле. Создает новый, если нужно."
  ;; Используем try-ref, чтобы безопасно проверить наличие ключа
  (let* ((segments-map (module-segments mod))
         (val-pair (hash-table-try-ref segments-map seg-name)))
    
    (if (car val-pair)
        ;; 1. Нашли! Просто делаем его активным
        (setf (module-current-segment mod) (cdr val-pair))
        
        ;; 2. Не нашли — создаем с нуля
        (let ((new-seg (make-new-segment :name seg-name 
                                     :parent-module mod))) ;; Не забываем инициализировать таблицу
          (begin
            (hash-table-set! segments-map seg-name new-seg)
            ;; Добавляем в список порядка, чтобы знать, кто за кем идет
            (setf (module-segment-order mod) 
                  (append (module-segment-order mod) (list seg-name)))
            (setf (module-current-segment mod) new-seg))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; DUMP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun segment-dump (seg)
  (let* ((buf (segment-buffer seg))
         (start (-> buf start-addr))
         (end (-> buf end-addr))
         (origin (segment-base-addr seg)))
    
    (fmt #t "\nSegment: {} | Origin: #{:04X}\n" (segment-name seg) origin)
    (fmt #t "Range: #{:04X} - #{:04X} ({} bytes used)\n" 
            (+ origin start) (+ origin end) (-> buf filled-size))
    (fmt #t "--------------------------------------------------\n")
    
    ;; Вызываем нативный дамп буфера
    ;; Параметры: (buffer, start_offset, length, show_ascii, bytes_per_line)
    (buffer-dump buf start (-> buf filled-size) #t 16)))

(defun module-dump (mod)
  (fmt #t "\n=== MODULE DUMP: {} ===\n" (module-name mod))
  (for-each (module-segment-order mod)
    (lambda (seg-name)
      (let ((seg (hash-table-ref (module-segments mod) seg-name)))
        (segment-dump seg))))
  (fmt #t "==================================\n"))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Метки
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; ------------------------------------------------------------------
;;; 1. Регистрация меток (Pass 1 & 2)
;;; ------------------------------------------------------------------

(defun set-label-full! (name seg scope type sig ctx)
  "Основная регистрация метки в C++ буфере сегмента."
  (let ((addr (get-abs-pc seg)))
    (buffer-label-set! (segment-buffer seg) name 
                      :address addr 
                      :segment (segment-name seg)
                      :meta (list :scope scope :type type :sig sig))))

(defun set-label-addr! (label seg ctx)
  "Обновление адреса существующей метки (обычно на Pass 2)."
  (let ((name (%asm-extract-name label ctx))
        (addr (get-abs-pc seg))
        (buf (segment-buffer seg))
        (seg-name (segment-name seg)))
    ;; Вместо setf используем твой примитив. 
    ;; Он увидит, что метка 'name' уже есть, и обновит ей :address.
    (buffer-label-set! buf name :address addr :segment seg-name :meta '(ctx))))

;;; ------------------------------------------------------------------
;;; 2. Поиск меток (Pass 2 & 3)
;;; ------------------------------------------------------------------

(defun %get-label-obj-global (mod name)
  "Ищет объект BufferLabel, перебирая все сегменты модуля."
  (if (null? mod) 
      null
      (let ((result null))
        (begin
          (for-each (module-segment-order mod)
            (lambda (seg-name)
              (let* ((seg (hash-table-ref (module-segments mod) seg-name))
                     (lab (buffer-get-label (segment-buffer seg) name)))
                (if (not (null? lab)) (set! result lab)))))
          result))))

(defun get-label-addr (label seg &optional ctx)
  "Строгое получение адреса. Выбрасывает ошибку, если метка не найдена."
  (let* ((name (%asm-extract-name label ctx))
         (mod  (segment-parent-module seg))
         ;; Сначала ищем в текущем сегменте (локальный поиск — быстрый)
         (lab  (buffer-label-get (segment-buffer seg) name)))
    (if (not (null? lab))
        (-> lab addr)
        ;; Если не нашли локально, ищем во всем модуле
        (let ((global-lab (%get-label-obj-global mod name)))
          (if (not (null? global-lab))
              (-> global-lab addr)
              (error (fmt #f "Undefined label: {}" name) ctx))))))

(defun get-label-addr-optional (label seg ctx)
  "Мягкое получение адреса. Возвращает #f вместо ошибки."
  (if (number? label)
      label
      (let* ((name (%asm-extract-name label ctx))
             (mod  (segment-parent-module seg))
             (lab  (buffer-label-get (segment-buffer seg) name)))
        (cond 
          ((not (null? lab)) (-> lab addr))
          ((not (null? mod)) 
           (let ((global-lab (%get-label-obj-global mod name)))
             (if (not (null? global-lab)) (-> global-lab addr) #f)))
          (else #f)))))

;;; ------------------------------------------------------------------
;;; 3. Расчеты
;;; ------------------------------------------------------------------

(defun get-rel-offset (label seg ctx &optional (pc-offset 2))
  "Расчет относительного смещения для Z80 (Target - (PC + offset))."
  (let ((target (get-label-addr label seg ctx))
        (current-pc (get-abs-pc seg)))
    (- target (+ current-pc pc-offset))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; управление метками
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun get-abs-pc (seg)
  "Возвращает текущий виртуальный адрес (только ILC)."
  (segment-ilc seg))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Выполняет проход с номером 1, 2 или 3
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun assemble-segment-pass (seg pass-num)
  (let ((bin-list '()))
    (begin
      ;; Инициализируем ILC перед началом прохода
      (segment-ilc! seg (segment-base-addr seg))
      (segment-origin! seg (segment-base-addr seg))

      (for-each (segment-insts seg)
        (lambda (inst)
          (cond 
            ;; 1. Обработка инструкции
            ((inst? inst)
             (let* ((opc (get-inst inst))
                    (pass-f (case pass-num 
                              (1 (opcode-pass1 opc)) 
                              (2 (opcode-pass2 opc)) 
                              (3 (opcode-pass3 opc))))
                    ;; Вызываем функцию прохода
                    (res (if (procedure? pass-f) (pass-f inst seg) null)))
               (begin
                  (inst-ilc! inst (segment-ilc seg))
                  ;(cfmt #t "red" " 0x{:04X} \n" (inst-ilc inst))
                  ;; На 3-м проходе собираем бинарник, если функция что-то родила
                  (if (and (eq? pass-num 3) (not (null? res)))
                      (let ((buf (segment-buffer seg))
                            (addr (segment-ilc seg)))
                        (begin
                          (inst-bin! inst res)
                          ;; Прямая запись в C++ буфер!
                          (if (list? res)
                              (for-each res (lambda (b) (buffer-write buf b :as 'uint8 :at addr)))
                              (buffer-write buf res :as 'uint8 :at addr))
                          (set! bin-list (append bin-list (if (list? res) res (list res))))
                          ;(cfmt #t "blue" "assemble-segment-pass {} ilc 0x{:04X} op {} result {}\n" pass-num (segment-ilc seg)  (inst-op inst) res)
                          )))                        
                 
                 ;; ЛОГИКА ОПРЕДЕЛЕНИЯ ДЛИНЫ (sz):
                 (let ((sz (cond 
                             ;; Если функция вернула число (дельту)
                             ((number? res) res)
                             ;; Если функция вернула список байт — считаем их
                             ((and (list? res) (not (null? res))) (length res))
                             ;; ЕСЛИ ФУНКЦИЯ ВЕРНУЛА NULL ИЛИ НИЧЕГО:
                             ;; Берем константу :size из самого операнда!
                             (else (opcode-size opc)))))
                   (begin
                     ;(cfmt #t "blue" "assemble-segment-pass {} ilc 0x{:04X} op {} result {} normalized {}\n" pass-num (segment-ilc seg)  (inst-op inst) res sz)                 
                     ;; Сохраняем вычисленную длину в саму инструкцию (для листинга/отладки)
                     (inst-size! inst sz)
                     ;; Двигаем ILC сегмента
                     (segment-ilc! seg (+ (segment-ilc seg) sz)))))))
            
            ;; 2. Обработка метки
            ((asmsym? inst) 
             (if (eq? pass-num 1)
                 (register-label (asmsym-name inst) (segment-ilc seg) seg)))

            (else null))))
      
      ;; Возвращаем результат: для Pass 3 — байты, для остальных — финальный ILC
      (if (eq? pass-num 3) bin-list (segment-ilc seg)))))

(defun assemble-module (mod)
  (let ((current-addr 0)
        (final-bin '()))
    (begin
      ;; 1. PASS 1: Сбор меток (Глобально)
      (set! current-addr 0)
      (for-each (module-segment-order mod)
        (lambda (name)
          (let ((seg (hash-table-ref (module-segments mod) name)))
            (begin
              (segment-base-addr! seg current-addr)
              (set! current-addr (assemble-segment-pass seg 1))))))

      ;; 2. PASS 2: Мутации и расчет смещений (Глобально)
      (set! current-addr 0)
      (for-each (module-segment-order mod)
        (lambda (name)
          (let ((seg (hash-table-ref (module-segments mod) name)))
            (begin
              (segment-base-addr! seg current-addr)
              (set! current-addr (assemble-segment-pass seg 2))))))

      ; 2. PASS 2.5: Мутации и расчет смещений (Глобально)
      (set! current-addr 0)
      (for-each (module-segment-order mod)
        (lambda (name)
          (let ((seg (hash-table-ref (module-segments mod) name)))
            (begin
              (segment-base-addr! seg current-addr)
              (set! current-addr (assemble-segment-pass seg 2))))))

      ;; 3. PASS 3: Генерация байт
      (for-each (module-segment-order mod)
        (lambda (name)
          (let* ((seg (hash-table-ref (module-segments mod) name))
                 (seg-bytes (assemble-segment-pass seg 3)))
            (set! final-bin (append final-bin seg-bytes)))))

      (save-module-symbols (fmt #f "{}.sym.sot" (module-name mod)) mod)
      final-bin)))

