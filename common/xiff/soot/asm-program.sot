;; Helpers

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Utilities
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun lower-byte (bla)
   "Get the lower byte of the integer"
   (logand bla #b11111111))

(defun higher-byte (bla)
   "Get the higher byte of the integer"
   (logand (rshift bla 8) #b11111111))

(defun substitute (new old lst)
  "Replace all occurrences of OLD with NEW in list LST.
   Returns a new list with the replacements made.
   
   Example:
   (substitute 'x 'y '(a y b y c)) 
   => (a x b x c)"
  (cond ((null? lst) '())
        ((eq? (car lst) old) 
         (cons new (substitute new old (cdr lst))))
        (#t (cons (car lst) (substitute new old (cdr lst))))))

(defun recsubstitute (dest source lis)
  "Recursively replace SOURCE with DEST throughout LIS.
   Works on nested lists and any level of structure.
   
   Arguments:
   - DEST:  The replacement value
   - SOURCE: The value to replace  
   - LIS: The input (list or atom)
   
   Returns: Structure with all SOURCE replaced by DEST.
   Note: Uses EQ for comparison at all levels."
   (cond
      ((eq? lis source)
         dest)
      ((list? lis)
         (cond
            ((null? lis) lis)
            (#t (mapcar (lambda (lis) (recsubstitute dest source lis))
                       lis))))
      (#t lis)))

(defun nsubstitute (new old lst)
  "Destructively replace OLD with NEW in list LST (modifies original).
   Uses SET-CAR! to mutate list cells in place.
   
   Arguments:
   - NEW: Replacement value
   - OLD: Value to replace
   - LST: List to modify (will be changed!)
   
   Returns: The modified list (same as input LST).
   Warning: Mutates the original list structure."
  (let ((current lst))
    (while (not (null? current))
      (if (eq? (car current) old)
          (set-car! current new)) 
      (set! current (cdr current)))
    lst)) 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lextoken - assembler lexical token container
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct lextoken (type null) (value null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Opcode - assembler instruction data container  
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct opcode
   "Assembler opcode"
   (documentation "")
   (op null)
   (arg1 null)
   (arg2 null)
   (arg3 null)
   (size 0)
   (pass1 null)
   (pass2 null)
   (pass3 null))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Valid assembler instructions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; List of all assembler instructions
(defparameter *optable* (make-hash-table '() 200)
  "Opcode table for the assembler")

(defun %make-raw-key (op-name a1 a2 a3)
  "Создает строку ключа из названия и типов аргументов"
  (fmt #f "{} {} {} {}" op-name a1 a2 a3))

(defun %make-opcode-key (opc)
  "Генерация строкового ключа для таблицы опкодов"
  ;; Добавляем открывающую скобку перед fmt
  (%make-raw-key 
       (opcode-op opc)
       (opcode-arg1 opc)
       (opcode-arg2 opc)
       (opcode-arg3 opc))) 

(defun %normalize-type (type)
  (cond
    ((eq? type 'number)   'variable)
    ((eq? type 'asmsym)   'variable)
    ((eq? type 'list)     'variable) ;; <-- Вот этот парень спасет ситуацию
    ((eq? type 'string)   'variable)
    (else type))) ;; Регистры (a, hl, и т.д.) остаются как есть

(defun set-opcode (opc)
  "Enter an opcode into the assembler opcode table"
  (check-type opc opcode?)
  (let ((key (%make-opcode-key opc)))
    ;(fmt #t "set-opcode :key {} :opc {}\n" key opc)                       
    (hash-table-set! *optable* key opc)))

(defun get-opcode (op-name &optional (arg1 null) (arg2 null) (arg3 null))
  "Умный поиск: сначала Exact Match, затем Fallback к 'variable'"
  (let* ((exact-key (%make-raw-key op-name arg1 arg2 arg3))
         (val       (hash-table-try-ref *optable* exact-key)))
    
    (cond 
      ;; 1. Нашли точное совпадение (например, LD A number)
      ((car val) (cdr val))
      
      ;; 2. Если не нашли, пробуем нормализовать типы в 'variable
      (#t 
       (let* ((n-key (%make-raw-key op-name 
                                   (%normalize-type arg1)
                                   (%normalize-type arg2)
                                   (%normalize-type arg3)))
              (n-val (hash-table-try-ref *optable* n-key)))
         
         (if (car n-val)
             (cdr n-val) ;; Нашли обобщенную версию
             ;; 3. Ошибка, если вообще ничего не подошло
             (error (fmt #f "Can't find opcode. Tried: '{}' and '{}'" 
                         exact-key n-key) 
                    (source-info op-name))))))))
                    
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Instruction это инструкция ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct inst
   "Assembler instruction"
  (op null)
  (arg1 (make-lextoken :type null))
  (arg2 (make-lextoken :type null))
  (arg3 (make-lextoken :type null))
  (ctx null)
  (size 0))

(defun get-inst (inst)
  "Найти opcode для конкретной инструкции в программе"
  (check-type inst inst?)  
  (get-opcode (inst-op inst) 
              (lextoken-type (inst-arg1 inst))
              (lextoken-type (inst-arg2 inst))
              (lextoken-type (inst-arg3 inst))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Asm Prog контейнер програмы
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstruct asm-prog
  "Assembler program, made of a list of instructions, a list of
   functions created by the instructions a symbol table, and an ilc"
  (insts null)
  ;(ifuncs null)
  (labs null)                 ;; Метки
  (ltable (make-hash-table))  ;;
  (ilc 0)
  (origin 0))                    ;;
;;; ------------------------------------------------------------------
;;; Внутренние утилиты (Private)
;;; ------------------------------------------------------------------

(defun %asm-extract-name (input ctx)
  (cond 
    ;; Если это уже число (прямой адрес), просто возвращаем его
    ((integer? input) input)
    ;; Если это строка — как есть
    ((string? input) input)
    ;; Если это символ (цитата 'blo) — в строку
    ((symbol? input) (symbol->string input))
    ;; Если это структура (токен)
    ((hash-table? input)
     (cond 
       ((hash-table-contains? input :value) 
        (%asm-extract-name (hash-table-ref input :value) ctx))
       (else 
        (error (fmt #f "Cannot extract name/address from struct. Keys: {}" 
                    (hash-table->keys input)) ctx))))
    (else 
     (error (fmt #f "Expected label, name or address, got: {}" input) ctx))))

;;; ------------------------------------------------------------------
;;; Публичное API (Public)
;;; ------------------------------------------------------------------

(defun get-abs-pc (prog)
  "Возвращает текущий виртуальный адрес (только ILC)."
  (asm-prog-ilc prog))

(defun set-label-addr! (label prog ctx)
  "Регистрирует метку по текущему виртуальному адресу."
  (let ((name (%asm-extract-name label ctx))
        (addr (get-abs-pc prog)))
    ;(cfmt #t 'yellow "set-label-addr! :target {} :current-pc {:04X}" label addr) 
    (setf (gethash name (asm-prog-ltable prog)) addr)))

(defun get-label-addr (label prog &optional ctx)
  (let ((name (%asm-extract-name label ctx)))
    (cond
      ;; 1. Если это число (уже готовый адрес), возвращаем его сразу
      ((integer? name) name)
      
      ;; 2. Если это имя, ищем в таблице меток
      ((or (string? name) (symbol? name))
       (let ((val (hash-table-try-ref (asm-prog-ltable prog) name)))
         (if (car val)
             (cdr val)
             (error (fmt #f "Undefined label: {}" name) ctx))))
      
      ;; 3. Если что-то иное — это ошибка типа
      (else (error (fmt #f "Invalid label type: {}" name) ctx)))))

(defun get-label-addr-optional (label prog ctx)
  "Мягкое получение адреса. Возвращает #f, если метка еще не определена.
   Используется для предварительных расчетов в Pass 2."
  (if (number? label)
    label ; вероятно уже число
    (let* ((name (%asm-extract-name label ctx))
          (val (hash-table-try-ref (asm-prog-ltable prog) name)))
      (if (car val) (cdr val) #f))))

(defun get-rel-offset (label prog ctx &optional (pc-offset 2))
  "Расчет относительного смещения для Z80 (Target - (PC + offset)).
   Использует строгое получение адреса для генерации кода."
  (let ((target (get-label-addr label prog ctx))
        (current-pc (get-abs-pc prog)))
    ;(cfmt #t 'yellow "get-rel-offset :target {} :current-pc {}" target current-pc) 
    (- target (+ current-pc pc-offset))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Утилиты для сохранения в list файл
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun arg->string (arg)
  "Конвертировать аргумент в строку для записи в листинг файл"
  (if (lextoken? arg)
      (let ((val  (lextoken-value arg))
            (type (lextoken-type arg)))
        (cond 
          ;; 1. Пустые аргументы
          ((or (null? val) (eq? val 'null)) "")
          
          ;; 2. Индексная адресация (IX+d) / (IY+d)
          ((eq? type 'ix-indexed) (fmt #f "(ix{:+})" val))
          ((eq? type 'iy-indexed) (fmt #f "(iy{:+})" val))
          
          ;; 3. Косвенная адресация (HL), (BC) и т.д.
          ((eq? type 'hl-indirect) "(hl)")
          ((eq? type 'bc-indirect) "(bc)")
          ((eq? type 'de-indirect) "(de)")
          ((eq? type 'sp-indirect) "(sp)")
          
          ;; 4. Косвенная адресация по адресу (nn)
          ((eq? type 'imm-indirect) (fmt #f "({:04X}h)" val))
          ((eq? type 'asmsym-indirect) (fmt #f "({})" val))
          
          ;; 5. Обычные числа (в hex для красоты)
          ((integer? val) (fmt #f "{:02X}h" val))
          
          ;; 6. Всё остальное (регистры, метки)
          (#t (fmt #f "{}" val))))
      ""))

(defun inst->string (inst)
  "Конвертировать инструкцию в строку для записи в листинг файл"
  (let ((op (inst-op inst))
        (a1 (arg->string (inst-arg1 inst)))
        (a2 (arg->string (inst-arg2 inst)))
        (a3 (arg->string (inst-arg3 inst))))
    (if (eq? op 'lab)
        (concat "label: " a1)
        (concat (fmt #f "{}" op)
                (if (not (string-empty? a1)) (concat " " a1) "")
                (if (not (string-empty? a2)) (concat ", " a2) "")
                (if (not (string-empty? a3)) (concat ", " a3) "")
                ;"   "
                ;(fmt #f "{}" (inspect inst))
                ))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Выполняет проход с номером 1, 2 или 3
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun assemble-pass (prog pass-num)
  (begin
    (asm-prog-ilc! prog (asm-prog-origin prog))
    ;(cfmt #t 'cyan "Start pass {}\n" pass-num)
    
    (mapcar (lambda (inst)
              (let* ((opc      (get-inst inst))
                     (old-size (struct-ref opc :size))
                     ;; Берем лямбду прохода, если она есть
                     (pass-f   (case pass-num
                                 (1 (opcode-pass1 opc))
                                 (2 (opcode-pass2 opc))
                                 (t null)))
                     ;; Вычисляем размер: либо через лямбду, либо берем default size
                     (new-size (if (procedure? pass-f) 
                                   (pass-f inst prog) 
                                   old-size))
                     ;; Если лямбда вернула что-то странное (null), страхуемся
                     (final-sz (or new-size old-size)))

                (begin
                  ;(cfmt #t 'red "pass {}: ilc {:04X} | size {}->{} | opcode {}\n" 
                  ;      pass-num (asm-prog-ilc prog) old-size final-sz (opcode-op opc))
                  
                  (asm-prog-ilc! prog (+ (asm-prog-ilc prog) final-sz))
                  final-sz)))
            (asm-prog-insts prog))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Компиляция программы
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun assemble (prog)
  (let ((bin-list '())
        (listing '()))
    
    (assemble-pass prog 1)
    (assemble-pass prog 2)

    ;; 3. Pass 3: Сбрасываем в 0
    (asm-prog-ilc! prog 0)
    (asm-prog-origin! prog 0) 
    
    (mapcar (lambda (inst)
          (let* ((op-name (struct-ref inst :op))
                 (opc (get-inst inst)))
            
            ;; 1. Обрабатываем ORG до генерации байтов
            (if (eq? op-name 'org)
              (let ((target-addr (lextoken-value (struct-ref inst :arg1))))
                (asm-prog-ilc! prog target-addr)))

            (let* ((v-addr (get-abs-pc prog))
                   (bytes (if opc ((opcode-pass3 opc) inst prog) '()))
                   (len (if (list? bytes) (length bytes) (if (integer? bytes) 1 0))))
                
                (begin
                  (set! listing (append listing (list (list v-addr bytes (inst->string inst)))))
                  
                  ;; ИСПРАВЛЕННЫЙ БЛОК: фильтруем null и пустые списки
                  (cond 
                    ((list? bytes) (set! bin-list (append bin-list bytes)))
                    ((integer? bytes) (set! bin-list (append bin-list (list bytes))))
                    (#t #f)) ;; Всё остальное (null, '()) игнорируем

                  ;; 3. Двигаем ILC
                  (if (not (eq? op-name 'org))
                      (asm-prog-ilc! prog (+ (asm-prog-ilc prog) len)))))))
        (asm-prog-insts prog))

    (list (cons :bin bin-list) (cons :lst listing))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Запись результата
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun save-listing (path lst-data)
  (let ((out ""))
    (begin
      (mapcar (lambda (row)
                (let* ((addr   (car row))
                       (bytes  (cadr row))
                       (src    (caddr row))
                       (is-lab (string-starts-with? src "label: "))
                       (is-org (string-starts-with? src "org "))
                       (b-str  ""))
                  
                  (cond 
                    ;; 1. Если это МЕТКА
                    (is-lab
                     (let ((label-name (string-substr src 7 (string-length src))))
                       (set! out (concat out (fmt #f "{:04X} | {:15} \n" addr (concat label-name ":"))))))
                    
                    ;; 2. ИНАЧЕ если это ORG
                    (is-org
                     (set! out (concat out (fmt #f "{:04X} | [ORG SET] {:6} | {}\n" addr "" src))))
                    
                    ;; 3. ИНАЧЕ это обычная инструкция
                    (#t
                     (begin
                       (if (and (not (null? bytes)) (not (eq? bytes 'null)))
                          (let ((b-list (if (list? bytes) bytes (list bytes))))
                            (mapcar (lambda (b) 
                                      ;; Используем logand, чтобы превратить -10 в F6
                                      (let ((clean-byte (if (number? b) (logand b #xFF) 0)))
                                        (set! b-str (concat b-str (fmt #f "{:02X} " clean-byte)))))
                                    b-list)))
                       (set! out (concat out (fmt #f "{:04X} |    {:13} | {}\n" addr b-str src))))))))
              lst-data)
      (write-text-file path out)
      (fmt #t "{}" out)
      null)))

(defun assemble-to-file (prog bin-path lst-path)
  (let* ((res (assemble prog))
         (bin-data (cdr (assoc :bin res)))
         (lst-data (cdr (assoc :lst res))))
    (begin
      ;; Записываем бинарный файл
      (write-binary-file bin-path bin-data)
      ;; Генерируем и записываем текстовый листинг
      (save-listing lst-path lst-data)
      (fmt #t "\nAssembly finished. Binary: {}, Listing: {}\n" bin-path lst-path)
      get_true)))

(defun assemble-raw-byte (prog file)
  (let ((bos (open file :direction :output
                        :if-does-not-exist :create
                        :element-type 'unsigned-byte
                        :if-exists :overwrite)))
       (if bos
           (begin 
             (assemble prog (lambda (byte) (write-byte byte bos)))
             (close bos)
             (fmt t "Program written to file {}\n" file))
           (fmt t "Program could not be written to file {}\n" file))))

(defun assemble-raw-byte (prog file)
   (begin 
      (assemble prog (lambda (byte) (write-byte byte bos)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; эти методы используются внутри макросов
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Получить адрес (число или адрес метки)
(defun get-addr (v prog ctx)
 (cond 
  ((integer? v) v) 
  ((symbol? v) (get-label-addr v prog ctx)) 
  (else (error (fmt #f "Invalid address: {}" v) ctx))))

(defun get-addr-list (v prog ctx)
  (cond 
    ((null? v) '())
    ((list? v) (mapcar (lambda (item) (get-addr item prog ctx)) v))
    (#t (list (get-addr v prog ctx))))) ;; Используй t или else
     
;; Получить относительное смещение для JR
(defun get-rel-offset (label prog ctx inst-size)
  (let* ((target (get-addr label prog ctx))
         (current-pc (get-abs-pc prog))
         ;; Вычисляем дельту относительно адреса следующей инструкции
         (offset (- target (+ current-pc inst-size))))
    
    ;; --- ПРОВЕРКА НА ПЕРЕПОЛНЕНИЕ ---
    (if (or (< offset -128) (> offset 127))
        (error (fmt #f "Relative jump to '{}' is out of range. Offset is {} bytes, but must be between -128 and 127." label offset) ctx)
        
        ;; Если всё ок, возвращаем байт (маскируем отрицательное число)
        (logand offset #xFF))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Макросы для описания комманд ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Дополнительная интсрукция для отображения параметров
(defun inspect-inst (msg inst size r1 r2 r3) 
  (fmt #t "<inst {}  :op {}\n  :size {} \n  :r1 {}\n  :r2 {}\n  :r3 {}\n" msg (inspect inst-op) size msg r1 r2 r3))

;; Parse function for the appropriate assembler type
(defparameter *parse* null 
   "Parse function for the appropriate assembler type")

(defmacro operand (sym size documentation
                   &key (pass1 null) 
                        (pass2 null)
                        (pass3 '()) 
                        (arg1 null) (arg2 null) (arg3 null)
                        (relative #f))
  `(begin
     (set-opcode (make-opcode 
                    :documentation ,documentation
                    :op ',sym :size ,size 
                    :arg1 ',arg1 :arg2 ',arg2 :arg3 ',arg3
                    :pass1 (lambda (inst prog) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst))) 
                               ,pass1))
                    :pass2 (lambda (inst prog) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst))) 
                               ,pass2))
                    :pass3 (lambda (inst prog) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst)))
                               ,pass3))))

     (defun ,sym (&optional (a1 (make-lextoken :type null))
                            (a2 (make-lextoken :type null))
                            (a3 (make-lextoken :type null)))
       (let ((bla1 (*parse* a1)) (bla2 (*parse* a2)) (bla3 (*parse* a3)))
         (make-inst :op ',sym :arg1 bla1 :arg2 bla2 :arg3 bla3 :ctx (get-context 3))))))


(operand lab 0 "Label"
  :arg1 asmsym
  :pass1 (begin (set-label-addr! r1 prog ctx) 0)
  :pass2 (begin (set-label-addr! r1 prog ctx) 0)
  :pass3 '()) ;; В pass3 метка просто ничего не генерирует

(define *asm-program-loader* #t)

(fmt #t "Loaded asm-program-loader\n")
