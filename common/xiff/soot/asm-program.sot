;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; эти методы используются внутри макросов
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Получить адрес (число или адрес метки)
(defun get-addr (v seg ctx)
 (cond 
  ((integer? v) v) 
  ((symbol? v) (get-label-addr v seg ctx)) 
  (else (error (fmt #f "Invalid address: {}" v) ctx))))

(defun get-addr-list (v seg ctx)
  (cond 
    ((null? v) '())
    ((list? v) (mapcar (lambda (item) (get-addr item seg ctx)) v))
    (#t (list (get-addr v seg ctx))))) ;; Используй t или else
     
;; Получить относительное смещение для JR
(defun get-rel-offset (label seg ctx inst-size)
  (let* ((target (get-addr label seg ctx))
         (current-pc (get-abs-pc seg))
         ;; Вычисляем дельту относительно адреса следующей инструкции
         (offset (- target (+ current-pc inst-size))))
    
    ;; --- ПРОВЕРКА НА ПЕРЕПОЛНЕНИЕ ---
    (if (or (< offset -128) (> offset 127))
        (error (fmt #f "Relative jump to '{}' is out of range. Offset is {} bytes, but must be between -128 and 127." label offset) ctx)
        
        ;; Если всё ок, возвращаем байт (маскируем отрицательное число)
        (logand offset #xFF))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Макросы для описания комманд ассемблера
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Дополнительная интсрукция для отображения параметров
(defun inspect-inst (msg inst size r1 r2 r3) 
  (fmt #t "<inst {}  :op {}\n  :size {} \n  :r1 {}\n  :r2 {}\n  :r3 {}\n" msg (inspect inst-op) size msg r1 r2 r3))

;; Parse function for the appropriate assembler type
(defparameter *parse* null 
   "Parse function for the appropriate assembler type")

(defmacro operand (sym size documentation
                   &key (pass1 null) 
                        (pass2 null)
                        (pass3 '()) 
                        (arg1 null) (arg2 null) (arg3 null)
                        (relative #f))
  `(begin
     (set-opcode (make-opcode 
                    :documentation ,documentation
                    :op ',sym :size ,size 
                    :arg1 ',arg1 :arg2 ',arg2 :arg3 ',arg3
                    :pass1 (lambda (inst seg) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst))) 
                               ,pass1))
                    :pass2 (lambda (inst seg) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst))) 
                               ,pass2))
                    :pass3 (lambda (inst seg) 
                             (let ((r1 (lextoken-value (inst-arg1 inst))) 
                                   (r2 (lextoken-value (inst-arg2 inst)))
                                   (r3 (lextoken-value (inst-arg3 inst)))
                                   (ctx (inst-ctx inst)))
                               ,pass3))))

     (defun ,sym (&optional (a1 (make-lextoken :type null))
                            (a2 (make-lextoken :type null))
                            (a3 (make-lextoken :type null)))
       (let ((bla1 (*parse* a1)) (bla2 (*parse* a2)) (bla3 (*parse* a3)))
         (make-inst :op ',sym :arg1 bla1 :arg2 bla2 :arg3 bla3 :ctx (get-context 3))))))

(defun %lab-get-meta (lst key)
  "Ищет значение ключа в списке метаданных метки."
  (let ((found (member key lst)))
    (if (and found (not (null? (cdr found))))
        (cadr found)
        null)))
        
(operand lab 0 "Enhanced Label with Metadata"
  :arg1 variable ;; r1 теперь может быть именем или списком (имя :scope :type :sig)
  :pass1 (let* ((meta (if (list? r1) r1 (list r1))) ;; нормализуем к списку
                (name (car meta))
                (scope (or (%lab-get-meta meta :scope) :private))
                (type  (or (%lab-get-meta meta :type)  :label))
                (sig   (or (%lab-get-meta meta :sig)   '())))
           (begin 
             (set-label-full! name seg scope type sig ctx) 
             0))
  :pass2 (let ((name (if (list? r1) (car r1) r1)))
           (begin 
             (set-label-addr! name seg ctx) ;; Обновляем адрес на 2-м проходе
             0))
  :pass3 '())

(defmacro subroutine (name &rest code)
   `(list (lab ',name) ,@code))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; верхний уровень
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defparameter *current-module* null)

(defmacro defmodule (name)
  `(begin 
    (define ,name (make-new-module ,(symbol->string name)))
    (set! *current-module* ,name)))

(defmacro in-module (name)
  ;; Здесь можно добавить логику поиска модуля в глобальном реестре
  `(set! *current-module* (find-module ,(symbol->string name))))

(defmacro zasm (&rest body)
  `(begin
     (if (null? *current-module*) (error "No module selected! Use (defmodule ...)"))
     ;; По умолчанию льем в "MAIN", если внутри нет директивы segment
     (let ((current-seg-name "MAIN"))
       (let ((insts (flatten (list ,@body))))
         (begin
           (if (not (hash-table-contains? (module-segments *current-module*) current-seg-name))
               (select-segment *current-module* current-seg-name))
           (let ((seg (hash-table-ref (module-segments *current-module*) current-seg-name)))
             (setf (segment-insts seg) insts)
             seg))))))

(defun save-symbols (mod)
  (let ((filename (fmt #f "{}.sym.sot" (module-name mod))))
    (begin
      (save-module-symbols filename mod)
      (cfmt #t "green" "Symbols saved: {}\n" filename))))

(defmacro build (mod &key (with-listing #f) (print-listing #f))
  `(begin
     (assemble-module ,mod)
     (cfmt #t "yellow" "\n──────────────────────────────────────────\n")
     (cfmt #t "white"  " BUILD SUCCESSFUL: {:15} \n" (module-name ,mod))
     (cfmt #t "yellow" "──────────────────────────────────────────\n")
     (for-each (module-segment-order ,mod)
       (lambda (name)
         (let ((seg (hash-table-ref (module-segments ,mod) name)))
           (cfmt #t "cyan" " Segment: {:10} | Base: #{:04X} | Size: {} bytes\n" 
                 name (segment-base-addr seg) (segment-ilc seg)))))
     (cfmt #t "yellow" "──────────────────────────────────────────\n")
     ;; Добавляем запятые перед аргументами макроса:
     (if ,with-listing
       (generate-module-listing ,mod :print-listing ,print-listing))))

(define *segmentram-loader* #t)

(fmt #t "Loaded segmentram-loader\n")
