;;; 02-segment.sot xiff meta-assembler segment and module class

;;; =====================================================================
;;; Class Segment
;;; =====================================================================

(defstruct segment 
  (name    null)   ;; 'code, 'data, 'const
  (buffer  null)   ;; Ссылка на C++ StaticBuffer
  (module  null)   ;; Ссылка на родительский модуль
  (base    0)
  (ilc     0)     ;; Position of PC
  (listing '()))

(defun new-segment (&key name module (size 65536) (base 0))
  "Создает новый сегмент и регистрирует его в модуле"
  (assert (module? module))
  
  (let* ((seg-buffer (make-memory-buffer :size size :base base))
         (seg (make-segment :name name 
                           :base base
                           :buffer seg-buffer 
                           :module module)))
    ;; установим base
    (segment-ilc! seg base)
    ;; Регистрируем сегмент в модуле
    (hash-table-set! (module-segments module) name seg)
    
    ;; Возвращаем сегмент
    seg))

(defun segment-reset (seg)
    "Сбросить сегмент"   
    (segment-ilc! seg (segment-base seg))
    (fmt #t "DEBUG segment-reset {} {:04x}\n" (segment-name seg) (segment-ilc seg))
    (segment-listing! seg '()))

;;; ---------------------------------------------------------------------
;;; Segment Dump
;;; ---------------------------------------------------------------------

(defun segment-record-listing-line (seg start-addr text)
  ;(fmt #t "DEBUG: segment-record-listing-line addr: {} :listing {}\n" start-addr text)
  (let* ((end-addr (segment-ilc seg))
         (len (- end-addr start-addr))
         (hex-str ""))
    
    ;; Читаем записанные байты для дампа
    (dotimes (i len)
      (let ((byte (memory-buffer-read-byte (segment-buffer seg) (+ start-addr i))))
        (set! hex-str (fmt #f "{} {:02X}" hex-str byte))))

    ;; Форматируем: Адрес | HEX | Мнемоника
    (let ((line (fmt #f "{:04X}: {:<12} | {}" start-addr hex-str text)))
      (segment-listing! seg (cons line (segment-listing seg))))))

(defun segment-dump-listing (seg)
  (fmt #t "\n--- Segment: {} ---\n" (segment-name seg))
  (for-each (reverse (segment-listing seg)) (lambda (line)
    (fmt #t "{}\n" line))))

(defun segment-dump-info (seg)
  (let* ((buffer (segment-buffer seg))
         (region (-> buffer :region)))
    (fmt #t "Segment: {}\n" (segment-name seg))
    (fmt #t "   Buffer ILC:  {}\n" (segment-ilc seg))
    (fmt #t "   Buffer Size: {}\n" (-> region :size))
    (fmt #t "   Buffer Base: {}\n" (-> region :base))))

;;; =====================================================================
;;; Class Module
;;; =====================================================================

(defstruct module 
  (name     null)
  (segments (make-hash-table)) ;; (name -> segment-struct)
  (exports  (make-hash-table))
  (labels   (make-hash-table))) ;; (label -> offset/address)

(defun module-segment-get (mod-name seg-name)
  "Получает или создает сегмент в модуле"
  (check-args #t (mod-name symbol?))
  (check-args #t (seg-name symbol?))
  
  (let* ((clean-seg-name (unquote-sym seg-name))
         (mod (ensure-module mod-name))  ; ← используем ensure-module
         (segs (module-segments mod))
         (seg (gethash clean-seg-name segs)))
    
    (unless seg
      (set! seg (new-segment :name clean-seg-name :module mod))
      (sethash clean-seg-name seg segs))
    
    seg))

(defun module-reset (mod)
  "Reset all segments"
  (fmt #t "\n--- Module: {} reset ---\n" (module-name mod)) 
  (let ((segs (module-segments mod)))
    (if (not (null? segs))
        (for-each segs (lambda (name seg)
          (segment-reset seg)))
        (fmt #t "  (No segments found in module)\n"))))

;;; ---------------------------------------------------------------------
;;; Module Lables
;;; ---------------------------------------------------------------------

;;; =====================================================================
;;; Labels
;;; =====================================================================

(defstruct label 
  (name    null)  
  (address    0)  
  (scope   null)
  (pass       0))

(defun module-label-set! (name &key (address null) (scope 'private))
  "Динамическая регистрация метки в текущем сегменте"
  (let* ((mod (current-module))
         (seg (current-segment))
         (pass (current-pass))
         (addr (if (null? address) (segment-ilc seg) address))
         (name-sym (unquote-sym name))
         (all-labels (module-labels mod))
         (new-lab (make-label :name name-sym :address addr :scope scope :pass pass))
         (old-lab (hash-table-ref all-labels name-sym null))
         )
     ;;(fmt #t "module-label-set! '{}'\n" name-sym)
     (when (and (notnull? old-lab) (== (label-pass old-lab) pass)) 
      (asm-error (fmt #f "The label '{}' is already defined in pass {}" name-sym (label-pass old-lab))))
     ;; Снова ставим кавычку перед name, чтобы (.label start) работало
     (hash-table-set! all-labels name-sym new-lab)
     (emit '() :listing (fmt #f "[{}]" name-sym) :prefix "")))

(defun module-label-get (label)
  "Возвращает метку (memory-label) из первого сегмента, где она найдена"
  (let ((mod (current-module)))
    (if (null? mod)
        (error "No current module")        
        (hash-table-ref (module-labels mod) label null))))

(defun module-label-addr-get (label)
  "На 1-м проходе возвращает 0 для неизвестных меток, на 2-м — кидает ошибку."
  (check-args #t
    (label symbol?))
    (let ((lab (module-label-get label)))
      ;(fmt #t "DEBUG lab: {}\n" (inspect lab))
      (cond
        ((not (null? lab)) (label-address lab))
        ((is-pass1?) 0) ;; Заглушка для первого прохода
      (else (asm-error (fmt #f "Label not found: `{}`" label))))))
   
(defun address-of (label)
  "Функция для использования внутри Lisp-выражений в zasm"
  (module-label-addr-get label))
   
(defun name->local (name) 
  "Создать локальную метку которая униуальна в модуле"
  (string->symbol (fmt #f "loc-{}-{}" (method-label *current-method*) name)))
  
(defmacro .label (name &key (address null) (scope 'private))
  "Статическая регистрация метки в ассемблере"
  `(module-label-set! ',name :address ,address :scope ,scope))

(defmacro .local (name &key (address null) (scope 'private))
  "Статическая регистрация метки в ассемблере"
  `(module-label-set! (name->local ',name) :address ,address :scope ,scope))

;;; ---------------------------------------------------------------------
;;; Dump Module
;;; ---------------------------------------------------------------------

(defun module-dump-listing (mod)
  (fmt #t "\n--- Module: {} ---\n" (module-name mod)) ;; Исправлено seg -> mod
  (let ((segs (module-segments mod)))
    (if (not (null? segs))
        (for-each segs (lambda (name seg)
          (segment-dump-listing seg)))
        (fmt #t "  (No segments found in module)\n"))))

(defun module-dump-segment-info (mod)
  (fmt #t "\n--- Module: {} ---\n" (module-name mod)) ;; Исправлено seg -> mod
  (let ((segs (module-segments mod)))
    (if (not (null? segs))
        (for-each segs (lambda (name seg)
          (segment-dump-info seg)))
        (fmt #t "  (No segments found in module)\n"))))

;;; =====================================================================
;;;  Passes
;;; =====================================================================

(defvar *current-pass* 1 "Глобальный флаг прохода")  

(defun current-pass () *current-pass*)

(defun is-pass1? () (eq? *current-pass* 1))
(defun is-pass2? () (eq? *current-pass* 2))

(defmacro if-pass1 (true-case false-case) `(if ,(eq? *current-pass* 1) ,true-case ,false-case))
(defmacro if-pass2 (true-case false-case) `(if ,(eq? *current-pass* 2) ,true-case ,false-case))
(defmacro when-pass1 (true-case) `(when ,(eq? *current-pass* 1) ,true-case))
(defmacro when-pass2 (true-case) `(when ,(eq? *current-pass* 2) ,true-case))

(defmacro pass-case (p1 p2)
  "Exectute body only if defined pass"
  `(if (eq? *current-pass* 1)
       ,p1
       ,p2))

(defun get-pass-signature () 
  (fmt #f "{}::{}::pass-{}" (current-module-name) (current-segment-name) *current-pass*))

;;; =====================================================================
;;; Module API - List of modules
;;; =====================================================================

(defvar *modules* (make-hash-table) 
  "Глобальный реестр всех загруженных модулей.")

(defun find-module (name)
  (begin 
     ;; Если модуля нет — создаем его
     (let ((mod (gethash name *modules*)))
      (if mod
        mod
        (error (fmt #f "Can't find module {}" name))))))

(defun ensure-module (name)
  "Гарантированно возвращает модуль (создает если нет)"
  (let* ((result (hash-table-try-ref *modules* name ))
         (found (car result))        ; #t или #f
         (mod (cdr result)))          ; значение модуля или null
    (if (eq? found #t)
        mod  ; модуль найден
        (let ((new-mod (make-module :name name 
                                    :segments (make-hash-table)
                                    :exports (make-hash-table))))
          (hash-table-set! *modules* name new-mod)
          (fmt #t "Module auto-created: {}\n" name)
          new-mod))))

;;; =====================================================================
;;; Module API - Current module
;;; =====================================================================

(defvar *current-module* null "Текущий активный модуль (объект)")

(defun current-module ()
  "Возвращает объект текущего модуля. Если не установлен - возвращает default?"
  (or *current-module* 
      (error "No current module set")))

(defun current-module-name ()
  "Возвращает имя текущего модуля"
  (if (null? *current-module*)
      (error "No current module set")
      (module-name *current-module*)))

(defun set-current-module! (mod)
  "Устанавливает текущий модуль (принимает имя или объект)"
  (cond
    ((symbol? mod)
     (let ((found (gethash mod *modules*)))
       (if found
           (set! *current-module* found)
           (error (fmt #f "Module '{}' not found" mod)))))
    ((module? mod)
     (set! *current-module* mod))
    (else
     (error "set-current-module! expects symbol or module")))
  *current-module*)


;;; =====================================================================
;;; Segment API - единый интерфейс
;;; =====================================================================

(defvar *current-segment* null "Текущий объект-сегмент для записи.")


(defun current-segment ()
  "Возвращает объект текущего сегмента"
  (or *current-segment*
      (error "No current segment set")))

(defun current-segment-name ()
  "Возвращает имя текущего сегмента"
  (if (null? *current-segment*)
      (error "No current segment set")
      (segment-name *current-segment*)))

(defun set-current-segment! (seg)
  "Устанавливает текущий сегмент (принимает имя или объект)"
  (assert (not (eq? seg 'seg-name)))
  (cond
    ((symbol? seg)
     (let ((found (module-segment-get (current-module-name) seg)))
       (if found
           (begin
            (set! *current-segment* found)
            ;(fmt #t "DEBUG set-current-segment! {} {:04x}\n" seg (segment-ilc found))
            )
           (error (fmt #f "Segment '{}' not found in module" seg)))))
    ((segment? seg)
     (set! *current-segment* seg))
    (else
     (error "set-current-segment! expects symbol or segment")))
  *current-segment*)


(defun ilc ()
  (segment-ilc *current-segment*))

;;; =====================================================================
;;; Functions Queue
;;; =====================================================================

(defstruct method 
  "Регистрируем фкнецию или метод в базе методов для многопроходной компиляции" 
  (label null)  ;; Полное имя метки (для JMP/CALL)
  (func  null)  ;; Лямбда с кодом (внутри которой zasm)
  (name  null) ;; Короткое имя для логов/ошибок
  (segment null))

(defvar *methods-to-assemble* '() "Список всех методов, ожидающих компиляции")
(defvar *current-method* null)

(defun add-function (type name label fun segment)
  (push! (make-method :func fun :name name :label label :segment (unquote-sym segment)) *methods-to-assemble*))

(defun get-function (type name)
    (eval (string->symbol (fmt #f "{}::{}" type name))))

;;; =====================================================================
;;; Module Macros
;;; =====================================================================


(defmacro defmodule (name &rest body)
  "Декларирует новый модуль и временно переключается на него"
  (let ((mod-sym (gensym)))
    `(let ((,mod-sym (ensure-module ',name)))  ; ← используем ensure-module
       
       ;; Временно переключаемся
       (let ((old-module *current-module*)
             (old-segment *current-segment*))
         (set-current-module! ,mod-sym)
         (set! *current-segment* null)  ; сегмент не выбран
         ,@body
         ;; Восстанавливаем
         (set! *current-module* old-module)
         (set! *current-segment* old-segment))
       
       ,mod-sym)))

(defmacro with-module (name &rest body)
  "Временно переключается на указанный модуль"
  `(let ((old-module *current-module*)
         (old-segment *current-segment*))
     (set-current-module! ',name)
     (set! *current-segment* null)  ; сегмент сбрасываем
     ,@body
     (set! *current-module* old-module)
     (set! *current-segment* old-segment)))

(defmacro with-segment (seg-name &rest body)
  "Временно переключается на указанный сегмент"
    (assert (not (eq? seg-name 'seg-name)))
  (fmt #t "DEBUG {}\n" seg-name)
  `(let ((old-segment *current-segment*))
     (set-current-segment! ',seg-name)  ; ← всегда кавычим
     ,@body
     (set! *current-segment* old-segment)))

(defun call-with-segment (seg-name &rest thunk)
  (let ((old-segment *current-segment*))
    (set-current-segment! seg-name)
    (thunk)
    (set! *current-segment* old-segment)))
