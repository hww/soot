;;; 04-hightlevel.sot xiff meta-assembler the hight level features

;;; =====================================================================
;;; Structures
;;; =====================================================================

(defmacro .static-new (instance-name type-name &rest args)
  (let* ((type-obj (~> type-name))
         (data-map (make-hash-table))
         (ops '()))
    
    ;; 1. Собираем аргументы из args (там лежат :x 100 :y 50 ...)
    ;; Используем while, так как он надежнее всего работает с парными списками
    (let* ((plist args))
      (while (not (null? plist))
        (let* ((k (car plist))
               (v (if (not (null? (cdr plist))) (cadr plist) 0)))
          ;; Ключ k (например, :x) превращаем в строку "x"
          ;; Важно: если k это :x, symbol->string вернет ":x" или "x" 
          ;; в зависимости от реализации, поэтому очистим от двоеточия если надо
          (hash-table-set! data-map (symbol->string k) v)
          (set! plist (cddr plist)))))

    ;; 2. Базовая метка структуры (теперь точно есть)
    (push! `(.label ,instance-name) ops)
    (emit-space (fmt #f "static-new {}" ',instance-name))

    ;; 3. Проход по всем полям через C++ итератор
    (type-for-each-field type-obj
      (lambda (idx offset field)
        (let* ((f-name (-> field :name))
               (f-tspec (-> field :type-spec))
               (f-base (-> f-tspec :base-type))
               ;; Ищем значение в мапе. Пробуем f-name, ":f-name" и т.д.
               (val (or (hash-table-ref data-map f-name #f)
                        (hash-table-ref data-map (string-append ":" f-name) 0)))
               
               ;; Генерируем метку доступа instance::field
               (f-label (string->symbol (fmt #f "{}::{}" instance-name f-name))))
          
          ;; Метка для каждого байта поля
          (push! `(.label ,f-label) ops)

          ;; 4. Генерация данных
          (push! 
            (cond
              ((or (eq? f-base "pointer") 
                   (member f-base '("int16" "uint16" "word" "int" "uint")))
               `(.dw ,val))
              (else `(.db ,val)))
            ops))))

    `(begin ,@(reverse ops))))
    
;;; =====================================================================
;;; Validations of arguments
;;; =====================================================================

(defun is-ptr? (tspec)
  (eq? (-> tspec .base-type) "pointer"))

(defun get-type-size (tspec)
  (let ((type-name (-> tspec .base-type)))
    (cond
      ((is-ptr? tspec) 2) ;; Указатели на Z80 всегда 16 бит
      ((member type-name '("int8" "uint8" "byte")) 1)
      ((member type-name '("int16" "uint16" "word")) 2)
      (else (-> (lookup-type type-name) .size)))))

;; Основная логика валидации регистров
(defun validate-reg-for-type (reg tspec arg-idx)
  (check-args #t
    (reg symbol?)
    (tspec type-spec?)
    (arg-idx integer?))
  (let ((size (get-type-size tspec))
        (reg-name (symbol->string reg)))
    (cond
      ((and (= size 1) (not (member reg '(a b c d e h l))))
       (asm-error (fmt #f "Argument {}: expected 8-bit register for type {}, but got {}" 
                       arg-idx (-> tspec .base-type) reg)))
      ((and (= size 2) (not (member reg '(hl de bc ix iy))))
       (asm-error (fmt #f "Argument {}: expected 16-bit register for type {}, but got {}" 
                       arg-idx (-> tspec .base-type) reg))))))


;;; =====================================================================
;;; Procedures
;;; =====================================================================



(defmacro defproc (name args &rest body)
  (let* ((label-name name)
         ;; Собираем аргументы для rlet: (имя тип регистр) -> (имя тип :reg регистр)
         (reg-args (filter (lambda (x) (and (list? x) (= (length x) 3))) args))
         (rlet-args (map (lambda (x) `(,(car x) ,(cadr x) :reg ,(caddr x))) reg-args))
         ;; Для системы типов SOOT (C++ уровень)
         (arg-types (map (lambda (x) (if (list? x) (cadr x) 'object)) args)))
    
    `(let ((impl (lambda ()
                   ;; Системная декларация для SOOT
                   (declare-extern ,label-name (function ,arg-types none))
                   ;; Настройка псевдонимов регистров
                   (rlet asm-regs ,rlet-args
                     (zasm 
                       (emit-space (fmt #f "function {}" ',label-name))
                       (.label ,label-name :scope 'public)
                       ,@body
                       (.ret)
                       (define-function ',name (current-function 'function)))))))
       
       ;; РЕГИСТРАЦИЯ: чтобы ассемблер прошел по этой функции
       (add-function 'global ',label-name ',label-name impl (current-segment-name))       
      
       ;; Экспорт в окружение Липа
       (define ,name impl :env *global-env*)
       (function-name! ,name ',name))))
       
(defmacro call-proc (name &rest args)
  "Пример: (call-proc copy-string :dest buffer :src msg)"
  `(begin
     ;; Здесь макрос должен посмотреть в декларацию defproc
     ;; и сгенерировать LD для каждого аргумента
     (.ld de ,(get-arg args :dest))
     (.ld hl ,(get-arg args :src))
     (.call ',name)))

;;; =====================================================================
;;; Methods 
;;; =====================================================================

(defmacro defmethod-instance (name args &rest body)
  (let* ((this-spec (car args))      ;; (self :vec3)
         (this-type (cadr this-spec))
         (label-sym (intern (fmt #f "{}::{}" this-type name)))
         )
    `(let ((impl (lambda ()
                   (rlet asm-regs ,args;((,(car this-spec) ,this-type :reg ix))
                     (emit-space (fmt #f "instance-method {}" ',label-sym))
                     (.label ,label-sym :scope 'public)
                     (zasm ,@body)
                     (.ret)
                     (define-method ',this-type  ',name (current-function 'function))))))
        ;; Экспорт в окружение Липа
        (define ,label-sym impl :env *global-env*)
        (function-name! ,label-sym ',label-sym)
        ;; Сохраняем в реестр вместо немедленной регистрации
        (add-function ',this-type ',name ',label-sym impl (current-segment-name))
        )))

(defmacro defmethod-static (name type args &rest body)
  (let* ((label-sym (intern (fmt #f "{}::{}" type name)))
        ;; Извлекаем только списки (arg :reg ... :type ...)
        (rlet-bindings (filter (lambda (x) (list? x)) args))
        )
    `(let ((impl (lambda () 
                   ;; Убрали ` перед rlet! Теперь это код, а не данные.
                   (rlet asm-regs ,args ;,rlet-bindings  
                      (zasm 
                      (emit-space (fmt #f "static-method {}" ',label-sym))
                      (.label ,label-sym :scope 'public)
                      ;; Тут важно: если body содержит макросы (типа zasm), 
                      ;; они должны раскрыться здесь.
                      ,@body
                      (.ret)
                      (define-method ',type  ',name (current-function 'function)))))))
        ;; Экспорт в окружение Липа
        (define ,label-sym impl :env *global-env*)  
        (function-name! ,label-sym ',label-sym) 
        (add-function ',type ',name ',label-sym impl (current-segment-name))
        )))

(defmacro defmethod (name type-or-args &rest body)
  (cond
    ;; Случай: (defmethod new vec3 (x y z) ...)
    ((eq? name 'new)
     (let ((type type-or-args)
           (args (car body))
           (actual-body (cdr body)))
       `(defmethod-static ,name ,type ,args ,@actual-body)))

    ;; Случай: (defmethod len ((self vec3)) ...)
    ((list? type-or-args)
     `(defmethod-instance ,name ,type-or-args ,@body))

    (else 
     (error "Malformed defmethod: check arguments structure."))))

;;; =====================================================================
;;; V-Table 
;;; =====================================================================

(defun last-element (lst)
  (if (null? (cdr lst))
      (car lst)
      (last-element (cdr lst))))

(defun method-name-only (full-name)
  (let ((s (symbol->string full-name)))
    (if (string-contains? s "::")
        (last-element (string-split s "::"))
        s)))

;;; 1. Сначала определяем вспомогательную функцию
(defun emit-vtable-slots (type-obj emit-fn)
  (let ((data '()))
    ;; Используем новый интринсик: x = ID, y = MethodInfo или null
    (type-for-each-method type-obj 
      (lambda (id method)
        (if (not (null? method))
            ;; Если метод найден (в типе или у родителя)
            ;; Берем имя самого метода, префикс vtable останется за вызывающим
            (let ((full-name (intern (concat (-> method :type-name) "::" (-> method :name)))))
              (push! (emit-fn full-name id method) data))
            
            ;; Если метода нет ни в этом типе, ни выше по иерархии
            (push! (emit-fn #f id method) data))))
    (flatten (reverse data))))

;;; 2. Теперь определяем функцию генерации таблицы
(defun .vtable (type-obj)
  (let ((v-name (intern (fmt #f "{}::vtable" (-> type-obj :name)))))
    ;; Базовая метка таблицы
    (emit-space (fmt #f "vtable {}" v-name))
    (module-label-set! v-name :scope 'public)
  
    (emit-vtable-slots type-obj 
      (lambda (method-full-name index method)
        (let* ((label-name 
                (if method-full-name 
                    (intern (fmt #f "{}::{}" v-name (method-name-only method-full-name)))
                    (intern (fmt #f "{}::empty_{}" v-name index)))))
          
          ;; Ставим метку слота
          (module-label-set! label-name)
            (let ((type-spec (~> method :type-spec))) 
            (declare-external label-name type-spec)
            )
          (if method-full-name
            (let ((addr (module-label-addr-get method-full-name)))
              (if (and addr (not (= addr 0)))
                  ;; СЛУЧАЙ А: Метод найден и скомпилирован
                  (emit (list #xC3 (lower-byte addr) (higher-byte addr))
                        :listing (fmt #f "JMP {}" method-full-name))
                  
                  ;; СЛУЧАЙ Б: Метод объявлен в типе, но кода нет (Label not found)
                  (begin
                    (asm-warning (fmt #f "Method implementation not found: {}. Plugging with panic." method-full-name))
                    (let ((panic-addr (module-label-addr-get 'panic-unimplemented)))
                      (emit (list #xC3 (lower-byte panic-addr) (higher-byte panic-addr))
                            :listing (fmt #f "MISSING: JP panic ({})" method-full-name))))))
            
            ;; СЛУЧАЙ В: Слот вообще пустой (даже в интерфейсе)
            (let ((panic-addr (module-label-addr-get 'panic-unimplemented)))
              (emit (list #xC3 (lower-byte panic-addr) (higher-byte panic-addr))
                    :listing "EMPTY SLOT: JP panic"))))))))


;;; =====================================================================
;;; Driver switcher
;;; =====================================================================  

(defun get-keyword (key lst &optional default)
  (cond
    ((null? lst) default)
    ((eq? key (car lst)) (cadr lst))
    (else (get-keyword key (cddr lst) default))))
    
(defun .vtable-proxy (type-obj name-symbol)
  ;; Генерируем имя: например, active_gfx_driver
  (emit-space (fmt #f "Proxy VTable for {}" (-> type-obj :name)))
  (label name-symbol :scope 'public)

  ;; Проходим по всем слотам, которые определены в базовом типе
  (emit-vtable-slots type-obj 
    (lambda (method-full-name index method)
      (let ((slot-label (if method-full-name
                            (intern (fmt #f "{}::{}" name-symbol (method-name-only method-full-name)))
                            (intern (fmt #f "{}::empty_{}" name-symbol index)))))
        
        ;; Ставим метку слота, чтобы можно было обращаться к конкретному методу
        (label slot-label)
        (let ((type-spec (~> method :type-spec))) 
            (declare-external slot-label type-spec)
            )
        ;; Генерируем JP 0000. 
        ;; Эти 3 байта будут заменяться при переключении драйвера.
        (emit (list #xC3 #x00 #x00) 
              :listing (if method-full-name 
                           (fmt #f "PROXY for {}" (method-name-only method-full-name))
                           "EMPTY PROXY SLOT"))))))

(defmacro .switch-vtable (source-type proxy-label)
  ;; source-type — это объект типа, proxy-label — это символ-метка в RAM
  (let* ((source-vtable (intern (fmt #f "{}::vtable" (~> source-type :name))))
         ;; Считаем размер прямо здесь, используя метаданные типа
         (methods-count (~> source-type :methods-count))
         (vtable-size (* methods-count 3)))
    
    (emit-comment (fmt #f "Switching proxy {} to {}" proxy-label (~> source-type :name)))
    
    ;; Генерируем чистый и понятный код
    (.ld hl source-vtable)
    (.ld de proxy-label)
    (.ld bc vtable-size)
    (.ldir)))

;;; =====================================================================
;;; Type Descriptors
;;; =====================================================================   

(defun .type-descriptor (type-obj)
  (let* ((t-name (-> type-obj :name))
         (label-base (fmt #f "type::{}::def" t-name))
         (label-sym (intern label-base)))

    ;; 1. Сначала ставим метку! Чтобы она уже была в таблице символов
    (module-label-set! label-sym :scope 'public)
    
    ;; 2. Поле +0: указатель на тип 'type'
    (if (eq? t-name "type")
        (emit-dw label-sym) ;; Если это сам тип, ссылаемся на себя
        (emit-dw (intern "type::type::def"))) ;; Остальные ссылаются на глобальный 'type'

    ;; 3. Поле +2: parent
    (let ((parent-name (-> type-obj :parent)))
      (emit-dw (if (and parent-name (not (eq? parent-name "")))
                   (intern (fmt #f "type::{}::def" parent-name))
                   0)))
    
    ;; ... остальной код (name, size, methods-count и т.д.) ...
    (emit-dw (intern (fmt #f "type::{}::name" t-name)))
    (emit-dw (-> type-obj :size))
    (emit-db (-> type-obj :methods-count))
    (emit-db (crc32 (-> type-obj :class)))

    (.vtable type-obj)
    
    (module-label-set! (intern (fmt #f "type::{}::name" t-name)))
    (emit-string t-name)))  

;;; =====================================================================
;;; Получить адресс метода
;;; =====================================================================  

(defmacro obj-method->iy (obj-reg method-sym)
  (let* ((parts (string-split (symbol->string method-sym) "::")) ;; (vec3 len)
         (m-id (method-id-of (car parts) (cadr parts)))
         (offset (* 3 m-id))) ;; Смещение в VTable (3 байта на JMP)
`(zasm
       (.push hl)       ; Сохраняем HL (аргумент)
       (.push bc)       ; Сохраняем BC (может быть аргументом)
       
       ;; 1. Достаем адрес VTable
       (.ld l (+ii ,obj-reg 0))
       (.ld h (+ii ,obj-reg 1)) 
       
       ;; 2. Смещение к нужному методу
       (.ld bc ,offset)
       (.add hl bc)     ; HL теперь указывает прямо на байты адреса в VTable
       (.ld iy hl)
       ;; 4. Рокировка на стеке
       (.pop bc)
       (.pop hl)
       )))

;;; =====================================================================
;;; Direct method call
;;; =====================================================================  


(defmacro ycall (target &rest args)
  (let* ((lab-exit (name->local 'exit))
         (func (if (symbol? target) (eval target) target))
         (target-sig (cond
                       ((function? func) (function-type func))
                       ((type-spec? func) func)
                       (else (error (fmt #f "Not callable: {}" target)))))
         
         ;; ВАЖНО: вычисляем каждый аргумент, чтобы получить типы
         (resolved-args (map (lambda (arg) (eval arg)) args))
         
         ;; Создаем сигнатуру вызова
         (call-sig (typespec (cons 'function resolved-args))))
    
    ;; Отладка
    ;(fmt #t "ycall: target-sig={} call-sig={}\n" target-sig call-sig)
    
    ;; Проверка совместимости
    (unless (types-match? target-sig call-sig :allow-abstract #t)
      (error (fmt #f "Signature mismatch: expected {}, got {}" 
                  target-sig call-sig)))
    
    ;; Генерация кода
    `(zasm
       ;; Адрес метода уже на стеке (от obj-method-address-push)
       ;; Кладем адрес возврата
       (.ld iy ',lab-exit)  ;; убрали quote - это метка, а не символ
       (.push iy)
       
       ;; Переход к методу
       (.ret)
       
       ;; Метка возврата
       (.label ,lab-exit)
       )))



;; Единый макрос для вызова
(defmacro dcall (target &rest args)
  (let* ((func (if (symbol? target) (eval target) target))
         (target-sig (cond
                       ((function? func) (function-type func))
                       ((type-spec? func) func)
                       (else (error (fmt #f "Not callable: {}" target)))))
         
         ;; ВАЖНО: вычисляем каждый аргумент, чтобы получить типы
         (resolved-args (map (lambda (arg) (eval arg)) args))

         ;; Строим список аргументов для новой сигнатуры
         (sig-args resolved-args) 
         
         ;; Создаем сигнатуру вызова
         (call-sig (typespec (cons 'function sig-args))))
    
    ;; Отладка (можно убрать)
    ;;(fmt #t "call: target-sig={} call-sig={}\n" target-sig call-sig)
    
    ;; Проверка совместимости
    (unless (types-match? target-sig call-sig :allow-abstract #t)
      (error (fmt #f "Signature mismatch: expected {}, got {}" 
                  target-sig call-sig)))
    
    ;; Генерация кода
    (cond
      ;; Метка VTable (TypeSpec, но не функция)
      ((and (type-spec? func) (not (type? 'function func)))
       `(zasm (.call ,(module-label-addr-get target))))
      
      ;; Настоящая функция
      ((function? func)
       `(zasm (.call ,(module-label-addr-get target))))
      
      (else (error "Unexpected")))))

;;; =====================================================================
;;; defcode - регистрация произвольного кода для компиляции
;;; =====================================================================
;;;
;;; Использование:
;;;   (defcode my-data ()
;;;     (.db #xAA #xBB #xCC)
;;;     (.dw #x1234))
;;;
;;;   (defcode init-screen (:segment 'name)
;;;     (.ld hl #xC000)
;;;     (.ld bc #x400)
;;;     (.ld a #x20)
;;;     (.fill bc a))
(defmacro defblock (name &key (segment #f) (scope 'public) (align 1) &rest body)
  (let ((seg-sym (if segment 
                     segment  ; уже символ
                     (current-segment-name)))  ; тоже символ
    
        (label-name (if (symbol? name) 
                        name 
                        (intern (fmt #f "block::{}" name)))))
    `(let ((impl (lambda ()
                   (with-segment ,seg-sym  ; ← seg-sym уже символ, не надо unquote-sym
                     (emit-space (fmt #f "code block {}" ',label-name))
                     (.label ,label-name :scope ',scope)
                     (zasm ,@body)))))
       
       ;; Регистрация
       (add-function 'global ',label-name ',label-name impl ',seg-sym)
       
       ;; Экспорт в окружение
       (define ,label-name impl :env *global-env*)
       (function-name! ,label-name ',label-name))))

(defmacro defcode (name &key (segment code) (scope 'public) (align 1) &rest body) 
  `(defblock ,name :segment ,segment :scope ,scope :align ,align ,@body))

(defmacro defdata (name &key (segment data) (scope 'public) (align 1) &rest body) 
  `(defblock ,name :segment ,segment :scope ,scope :align ,align ,@body))
