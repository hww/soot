;;; 01-core.sot xiff meta-assembler core

;;; =====================================================================
;;; Word to Byte Conversions
;;; =====================================================================

(defun lower-byte (bla)
   "Get the lower byte of the integer"
   (logand bla #b11111111))

(defun higher-byte (bla)
   "Get the higher byte of the integer"
   (logand (rshift bla 8) #b11111111))

;;; =====================================================================
;;; Z80 Registers
;;; =====================================================================

(define a    'a)
(define b    'b)
(define c    'c)
(define d    'd)
(define e    'e)
(define h    'h)
(define l    'l)
(define bc   'bc)
(define de   'de)
(define hl   'hl)
(define sp   'sp)
(define af   'af)
(define bc2  'bc2)
(define de2  'de2)
(define hl2  'hl2)
(define af2  'af2)
(define rv   'rv)
(define ix   'ix)
(define iy   'iy)
(define iv   'iv)
(define mr   'mr)

;;; =====================================================================
;;; Register codes
;;; =====================================================================

;; z80 register codes, needed often during instruction assembling
(define *reg-codes* (make-hash-table '() 11))

(defmacro reg-code (reg)
   `(hash-table-ref *reg-codes* ,reg))

(defmacro reg-code! (reg value)
   `(hash-table-set! *reg-codes* ,reg ,value))

(reg-code! 'a 7)
(reg-code! 'b 0)
(reg-code! 'c 1)
(reg-code! 'd 2)
(reg-code! 'e 3)
(reg-code! 'h 4)
(reg-code! 'l 5)
(reg-code! 'bc 0)
(reg-code! 'de 1)
(reg-code! 'hl 2)
(reg-code! 'sp 3)
(reg-code! 'af 3)

(reg-code! 'ix 2) ;; Код такой же как у HL
(reg-code! 'iy 2)

(defun get-low-reg (reg)
  (case reg
    ('hl 'l)
    ('de 'e)
    ('bc 'c)
    ('ix 'ixl) ;; Добавляем половинки для индексных
    ('iy 'iyl)
    (else (error (fmt #f "Unknown 16-bit register: {}" reg)))))

(defun get-high-reg (reg)
  (case reg
    ('hl 'h)
    ('de 'd)
    ('bc 'b)
    ('ix 'ixh)
    ('iy 'iyh)
    (else (error (fmt #f "Unknown 16-bit register: {}" reg)))))

;;; =====================================================================
;;; Complex addressing
;;; =====================================================================

(defun @ (reg) 
  "Метка-заполнитель для косвенной адресации (.ld a (@ hl))"
  (list '@ reg))

(defun +ix (obj)
  (let ((offset (if (number? obj) 
                    obj 
                    (-> obj :offset))))
    (list 'ix-indexed offset)))

(defun +iy (obj)
  (let ((offset (if (number? obj) 
                    obj 
                    (-> obj :offset))))
    (list 'iy-indexed offset)))

(defmacro ->ix (type &rest path)
  "Сокращение для (+ix (-> (reg 'tmp 'type) path...))"
  `(+ix (-> (reg 'tmp ',type) ,@path)))

(defmacro ->iy (type &rest path)
  `(+iy (-> (reg 'tmp ',type) ,@path)))

(defun +ii (ix-iy obj)
  "Make equivalet on +ix +iy "
  (let ((offset (if (number? obj) 
                    obj 
                    (-> obj :offset))))
   (cond 
      ((eq? ix-iy 'ix)
        (list 'ix-indexed offset))
      ((eq? ix-iy 'iy)
        (list 'iy-indexed offset))
      (#t 
        (asm-error (fmt #f "Unknown register {}" ix-iy))))))

;;; =====================================================================
;;; Condition Codes
;;; =====================================================================

; z80 condition codes, needed often during instruction assembling
(define *con-codes* (make-hash-table))

(defmacro con-code (reg)
   `(hash-table-ref *con-codes* ,reg))
(defmacro con-code! (reg value)
   `(hash-table-set! *con-codes* ,reg ,value))

(con-code! 'nz 0)
(con-code! 'z 1)
(con-code! 'nc 2)
(con-code! 'c 3)
(con-code! 'pe 4)
(con-code! 'po 5)
(con-code! 'p 6)
(con-code! 'm 7)

;;; =====================================================================
;;; Token System
;;; =====================================================================

(defun unquote-sym (s)
  (if (and (not (null? s)) (list? s) (eq? (car s) 'quote))
      (unquote-sym (cadr s)) ;; Рекурсивно чистим
      s))

(defun unquote-sym->str (s) (symbol->string (unquote-sym s)))

;; Используем список с тегом 'token для однозначности
(defun make-asm-token (type value)
  (list 'token type value))

(defun asm-token? (obj)
  (and (list? obj) (eq? (car obj) 'token)))

(defun asm-token-type (tok)  (cadr tok))
(defun asm-token-value (tok) (caddr tok))

(defun alias->token (alias)
  (let ((base (-> alias :reg))
        (offs (-> alias :offset))
        (size (-> alias :bit_size)))
    (cond
      ((and (= offs 0) (not (member base '(ix iy))))
       (make-asm-token (if (>= size 16) '16-reg '8-reg) base))
      ((member base '(ix iy))
       (make-asm-token (if (eq? base 'ix) 'ix-indexed 'iy-indexed) offs))
      (else (error "Unknown alias mapping" alias)))))

(defun symbol->token (sym)
  (let ((name (unquote-sym sym)))
    (cond
      ((member name '(a b c d e h l)) (make-asm-token '8-reg name))
      ((member name '(bc de hl sp af ix iy)) (make-asm-token '16-reg name))
      (else (make-asm-token 'number (module-label-addr-get name))))))

;;; =====================================================================
;;; Convert Argument To 
;;; =====================================================================

(defun parse-arg (arg)
  (check-args #t
    (arg (or symbol? number? list? native-obj?)))
  (cond
    ((asm-token? arg) arg)
    ((number? arg) (make-asm-token 'number arg))
    ((native-obj? arg) (alias->token arg))
    ((symbol? arg) (symbol->token arg))

    ((list? arg)
     (let ((head (car arg)))
       (cond
         ;; 1. Косвенная адресация (@ hl)
         ((eq? head '@) (make-asm-token 'indirect (unquote-sym (cadr arg))))
         
         ;; 2. Квотированные метки 'start
         ((eq? head 'quote) (symbol->token arg))
         
         ;; 3. Результат работы функций ix/iy (уже вычисленный)
         ((eq? head 'ix-indexed) (make-asm-token 'ix-indexed (cadr arg)))
         ((eq? head 'iy-indexed) (make-asm-token 'iy-indexed (cadr arg)))

         ;; 4. Все остальное: (ix + 2), (+ offset 1), (ADDR_BASE)
         (else 
          (let ((val (eval arg)))
            (cond
              ((number? val) (make-asm-token 'number val))
              ;; Если eval вернул (ix-indexed 2), парсим результат рекурсивно
              ((or (asm-token? val) (list? val)) (parse-arg val))
              (else (error "Expression must evaluate to a number or valid operand" arg))))))))

    (else (error (fmt #f "Unknown operand type {}" arg)))))


;;; =====================================================================
;;; Errors and Logs
;;; =====================================================================

(defvar *asm-context-stack* '()  "Метаданные исходного кода для обработки ошибок.")

(defmacro with-asm-context (info &rest body)
  "Максимально надежная версия без использования push!"
  `(begin
     (set! *asm-context-stack* (cons ,info *asm-context-stack*))
     (let ((res (begin ,@body)))
       (set! *asm-context-stack* (cdr *asm-context-stack*))
       res)))

(defun source-context ()
  "Get top context"
  (if (null? *asm-context-stack*) 
    null  ;; "no context!"  
    (car *asm-context-stack*)))

(defun asm-source-info ()
  (let ((info (source-info (source-context))))
    (if info
        (fmt #f "at {}:{}" (getf info :file) (getf info :line))
        "at unknown:0")))

(defun asm-error (message) (error (fmt #f "{} {}" ( get-pass-signature ) message) :ctx (source-context)))

(defun asm-warning (message) (print (fmt #f "{} {} {}" ( get-pass-signature ) (asm-source-info) message)))

;;; =====================================================================
;;; Arguments
;;; =====================================================================

(defmacro check-type (var predicate)
  `(when (not (,predicate ,var))
    (error (fmt #f "Variable `{}` failed type check `{}` because value: `{}` of type {}" 
      ',var ',predicate ,var (type-of ,var) (source-context)))))

;;; =====================================================================
;;; Contracts
;;; =====================================================================

(defun match-rule? (val rule)
  (cond
    ;; 0. Если правило — символ, пробуем получить функцию по имени
    ((symbol? rule)
     (let ((pred (eval rule)))
       (cond
         ((function? pred) (pred val))        ; обычная функция
         ((macro? pred)    (pred val))        ; макрос (на всякий случай)
         (else (error (fmt #f "Not a callable predicate: {}" rule))))))
    
    ;; 1. Если правило — функция (lambda)
    ((function? rule) (rule val))
    
    ;; 2. Специальные типы Z80
    ((eq? rule :u8)    (and (number? val) (between val 0 255)))
    ((eq? rule :u16)   (and (number? val) (between val 0 65535)))
    ((eq? rule :i8)    (and (number? val) (between val -128 127)))
    ((eq? rule :i16)   (and (number? val) (between val -32768 32767)))
    ((eq? rule :reg8)  (is-8bit-reg? val))
    ((eq? rule :reg16) (is-16bit-reg? val))
    ((eq? rule :any)   #t)
    
    ;; 3. Логика OR: (or :u8 symbol?)
    ((and (list? rule) (eq? (car rule) 'or))
     (any (lambda (r) (match-rule? val r)) (cdr rule)))

    ;; 4. Проверка списков (паттерны)
    ((list? rule)
     (and (list? val) (match-list-pattern? val rule)))

    ;; 5. Прямое совпадение (для констант)
    (else (equal? val rule))))

(defun match-list-pattern? (vals rules)
  (cond
    ;; Оба пусты — победа
    ((and (null? vals) (null? rules)) #t)
    
    ;; Вариативность: ( ... ) в конце правила разрешает любой остаток
    ((eq? (car rules) '...) #t)
    
    ;; Опциональность: (optional rule)
    ((and (pair? (car rules)) (eq? (caar rules) 'optional))
     (if (null? vals)
         (match-list-pattern? vals (cdr rules)) ;; Пропускаем опциональный
         (or (and (match-rule? (car vals) (cadar rules))
                  (match-list-pattern? (cdr vals) (cdr rules)))
             (match-list-pattern? vals (cdr rules)))))

    ;; Если одно из двух закончилось раньше времени — провал
    ((or (null? vals) (null? rules)) #f)

    ;; Рекурсивная проверка головы и хвоста
    (else (and (match-rule? (car vals) (car rules))
               (match-list-pattern? (cdr vals) (cdr rules))))))

;;; =====================================================================
;;; ZASM CONTRACT SYSTEM (Documentation)
;;; =====================================================================
;;; (check-args (arg-name rule) ...)
;;;
;;; ПРАВИЛА (rules):
;;; 1. Предикаты: symbol?, number?, procedure? (базовая проверка Лиспа).
;;; 2. Z80 Типы: :u8, :u16, :reg8, :reg16 (проверка границ и имен регистров).
;;; 3. Варианты: (or rule1 rule2 ...) — истинно, если подходит хотя бы одно.
;;; 4. Списки: (rule1 rule2 ...) — жесткое совпадение структуры и типов.
;;; 5. Опциональность: (optional rule) — элемент может отсутствовать в списке.
;;; 6. Вариативность: ... — в конце списка правил, разрешает любой хвост.
;;;
;;; ПРИМЕР:
;;; (check-args 
;;;   (args (:reg8 (or :u8 symbol?) (optional :any))))
;;;
;;; Означает:
;;; - args[0] должен быть 8-битным регистром.
;;; - args[1] должен быть числом 0..255 ИЛИ символом (меткой).
;;; - args[2] может быть чем угодно (флаг), а может отсутствовать.
;;; =====================================================================

(defmacro check-args (is-asm &rest clauses)
  (let ((is-asm-val is-asm)) ; фиксируем значение флага
    `(begin
       ,@(map (lambda (clause)
                (let ((var-name (car clause))
                      (rule (cadr clause)))
                  `(when (not (match-rule? ,var-name ',rule))
                       (let ((message (fmt #f 
"Contract violation!
  Argument:  '{}'
  Expected:  {}
  Actual:    {} (type: {})"
                                      ',var-name 
                                      ',rule 
                                      ,var-name
                                      (type-of ,var-name))))
                         (if ,is-asm-val 
                             (asm-error message)
                             (error message :ctx (get-context 4) ))))))
              clauses)))) 
