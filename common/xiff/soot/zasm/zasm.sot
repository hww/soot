(load "common/xiff/soot/zasm/zasm-symbols.sot")
(load "common/xiff/soot/zasm/zasm-binary.sot")
(init-types 'z80)

;;; =====================================================================
;;; Word to Byte Conversions
;;; =====================================================================

(defun lower-byte (bla)
   "Get the lower byte of the integer"
   (logand bla #b11111111))

(defun higher-byte (bla)
   "Get the higher byte of the integer"
   (logand (rshift bla 8) #b11111111))

;;; =====================================================================
;;; Z80 Registers
;;; =====================================================================

(define a    'a)
(define b    'b)
(define c    'c)
(define d    'd)
(define e    'e)
(define h    'h)
(define l    'l)
(define bc   'bc)
(define de   'de)
(define hl   'hl)
(define sp   'sp)
(define af   'af)
(define bc2  'bc2)
(define de2  'de2)
(define hl2  'hl2)
(define af2  'af2)
(define rv   'rv)
(define ix   'ix)
(define iy   'iy)
(define iv   'iv)
(define mr   'mr)

;;; =====================================================================
;;; Register codes
;;; =====================================================================

;; z80 register codes, needed often during instruction assembling
(define *reg-codes* (make-hash-table '() 11))

(defmacro reg-code (reg)
   `(hash-table-ref *reg-codes* ,reg))

(defmacro reg-code! (reg value)
   `(hash-table-set! *reg-codes* ,reg ,value))

(reg-code! 'a 7)
(reg-code! 'b 0)
(reg-code! 'c 1)
(reg-code! 'd 2)
(reg-code! 'e 3)
(reg-code! 'h 4)
(reg-code! 'l 5)
(reg-code! 'bc 0)
(reg-code! 'de 1)
(reg-code! 'hl 2)
(reg-code! 'sp 3)
(reg-code! 'af 3)

(reg-code! 'ix 2) ;; Код такой же как у HL
(reg-code! 'iy 2)

(defun get-low-reg (reg)
  (case reg
    ('hl 'l)
    ('de 'e)
    ('bc 'c)
    ('ix 'ixl) ;; Добавляем половинки для индексных
    ('iy 'iyl)
    (else (error (fmt #f "Unknown 16-bit register: {}" reg)))))

(defun get-high-reg (reg)
  (case reg
    ('hl 'h)
    ('de 'd)
    ('bc 'b)
    ('ix 'ixh)
    ('iy 'iyh)
    (else (error (fmt #f "Unknown 16-bit register: {}" reg)))))

;;; =====================================================================
;;; Complex addressing
;;; =====================================================================

(defun @ (reg) 
  "Метка-заполнитель для косвенной адресации (.ld a (@ hl))"
  (list '@ reg))

(defun +ix (obj)
  (let ((offset (if (number? obj) 
                    obj 
                    (-> obj :offset))))
    (list 'ix-indexed offset)))

(defun +iy (obj)
  (let ((offset (if (number? obj) 
                    obj 
                    (-> obj :offset))))
    (list 'iy-indexed offset)))

(defmacro ->ix (type &rest path)
  "Сокращение для (+ix (-> (reg-alias 'tmp 'type) path...))"
  `(+ix (-> (reg-alias 'tmp ',type) ,@path)))

(defmacro ->iy (type &rest path)
  `(+iy (-> (reg-alias 'tmp ',type) ,@path)))
         
;;; =====================================================================
;;; Condition Codes
;;; =====================================================================

; z80 condition codes, needed often during instruction assembling
(define *con-codes* (make-hash-table))

(defmacro con-code (reg)
   `(hash-table-ref *con-codes* ,reg))
(defmacro con-code! (reg value)
   `(hash-table-set! *con-codes* ,reg ,value))

(con-code! 'nz 0)
(con-code! 'z 1)
(con-code! 'nc 2)
(con-code! 'c 3)
(con-code! 'pe 4)
(con-code! 'po 5)
(con-code! 'p 6)
(con-code! 'm 7)

;;; =====================================================================
;;; Convert Argument To 
;;; =====================================================================

(defun unquote-sym (s)
  (if (and (not (null? s)) (list? s) (eq? (car s) 'quote))
      (unquote-sym (cadr s)) ;; Рекурсивно чистим
      s))

;; Используем список с тегом 'token для однозначности
(defun make-asm-token (type value)
  (list 'token type value))

(defun asm-token? (obj)
  (and (list? obj) (eq? (car obj) 'token)))

(defun asm-token-type (tok)  (cadr tok))
(defun asm-token-value (tok) (caddr tok))

(defun alias->token (alias)
  (let ((base (-> alias :reg))
        (offs (-> alias :offset))
        (size (-> alias :bit_size)))
    (cond
      ((and (= offs 0) (not (member base '(ix iy))))
       (make-asm-token (if (>= size 16) '16-reg '8-reg) base))
      ((member base '(ix iy))
       (make-asm-token (if (eq? base 'ix) 'ix-indexed 'iy-indexed) offs))
      (else (error "Unknown alias mapping" alias)))))

(defun symbol->token (sym)
  (let ((name (unquote-sym sym)))
    (cond
      ((member name '(a b c d e h l)) (make-asm-token '8-reg name))
      ((member name '(bc de hl sp af ix iy)) (make-asm-token '16-reg name))
      (else (make-asm-token 'number (module-label-addr-get name))))))

(defun parse-arg (arg)
  (cond
    ((asm-token? arg) arg)
    ((number? arg) (make-asm-token 'number arg))
    ((native-ref? arg) (alias->token arg))
    ((symbol? arg) (symbol->token arg))

    ((list? arg)
     (let ((head (car arg)))
       (cond
         ;; 1. Косвенная адресация (@ hl)
         ((eq? head '@) (make-asm-token 'indirect (unquote-sym (cadr arg))))
         
         ;; 2. Квотированные метки 'start
         ((eq? head 'quote) (symbol->token arg))
         
         ;; 3. Результат работы функций ix/iy (уже вычисленный)
         ((eq? head 'ix-indexed) (make-asm-token 'ix-indexed (cadr arg)))
         ((eq? head 'iy-indexed) (make-asm-token 'iy-indexed (cadr arg)))

         ;; 4. Все остальное: (ix + 2), (+ offset 1), (ADDR_BASE)
         (else 
          (let ((val (eval arg)))
            (cond
              ((number? val) (make-asm-token 'number val))
              ;; Если eval вернул (ix-indexed 2), парсим результат рекурсивно
              ((or (asm-token? val) (list? val)) (parse-arg val))
              (else (error "Expression must evaluate to a number or valid operand" arg))))))))

    (else (error (fmt #f "Unknown operand type {}" arg)))))

;;; =====================================================================
;;; Class Segment
;;; =====================================================================

(defstruct segment 
  (name    null)   ;; 'code, 'data, 'const
  (buffer  null)   ;; Ссылка на C++ StaticBuffer
  (module  null)   ;; Ссылка на родительский модуль
  (ilc     0)     ;; Position of PC
  (listing '()))

(defun new-segment (&key name module)
  (let ((seg-buffer (make-buffer (fmt #f "{}:{}" (module-name module) name) 65536 0)))
    (make-segment :name name 
                  :buffer seg-buffer 
                  :module module)))

(defun segment-label-get (seg label)
  "Возвращает адрес метки в данном сегменте или null, если не найдена."
  (let* ((buf (segment-buffer seg)))
         ;; Используем динамическое обращение к слоту буфера
         (-> buf (identity label))))

(defun segment-label-addr-get (seg label)
  "Возвращает адрес метки в данном сегменте или null, если не найдена."
  (let* ((buf (segment-buffer seg))
         ;; Используем динамическое обращение к слоту буфера
         (addr (-> buf (identity (identity label)))))
    (if (not (null? addr))
        addr
        null)))

(defun segment-label-set! (seg label &key (address null) (scope 'private))
  (let* ((clean-name (unquote-sym label)) ;; Убираем лишние quote
         (buf (segment-buffer seg))
         (ilc (segment-ilc seg))
         (target-addr (if (not (null? address)) address ilc)))
    
    (buffer-label-set! buf clean-name :address target-addr)
    (fmt #t "  [Segment:{}] Label '{}' set to {}\n" 
         (segment-name seg) clean-name target-addr)))

(defun segment-record-listing-line (seg start-addr text)
  ;(fmt #t "DEBUG: segment-record-listing-line addr: {} :listing {}\n" start-addr text)
  (let* ((end-addr (segment-ilc seg))
         (len (- end-addr start-addr))
         (hex-str ""))
    
    ;; Читаем записанные байты для дампа
    (dotimes (i len)
      (let ((byte (buffer-read (segment-buffer seg) :type 'uint8 :address (+ start-addr i))))
        (set! hex-str (fmt #f "{} {:02X}" hex-str byte))))

    ;; Форматируем: Адрес | HEX | Мнемоника
    (let ((line (fmt #f "{:04X}: {:<12} | {}" start-addr hex-str text)))
      (segment-listing! seg (cons line (segment-listing seg))))))

(defun segment-dump-listing (seg)
  (fmt #t "\n--- Segment: {} ---\n" (segment-name seg))
  (for-each (reverse (segment-listing seg)) (lambda (line)
    (fmt #t "{}\n" line))))

(defun segment-reset (seg)
    (segment-ilc! seg 0)
    (segment-listing! seg '()))

;;; =====================================================================
;;; Class Module
;;; =====================================================================

(defstruct module 
  (name     null)
  (segments (make-hash-table)) ;; (name -> segment-struct)
  (exports  (make-hash-table))) ;; (label -> offset/address)

(defun module-segment-get (mod-name seg-type)
  (while (and (pair? seg-type) (eq? (car seg-type) 'quote))
    (set! seg-type (cadr seg-type)))
  
  (let* ((mod (gethash mod-name *modules*)))
    (unless mod
      (set! mod (make-module :name mod-name 
                             :segments (make-hash-table)
                             :exports (make-hash-table)))
      (sethash mod-name mod *modules*))
    
    ;; Используем прямое обращение к слоту структуры, если -> капризничает
    (let* ((segs (module-segments mod)) 
           (seg (gethash seg-type segs)))
      (unless seg
        (set! seg (new-segment :name seg-type :module mod))
        (sethash seg-type segs seg))
      seg)))


(defun module-label-get (label)
  "Безопасный поиск метки с поддержкой проходов."
  (let ((mod (gethash *current-module* *modules*)))
    (if (null? mod)
        ;; Если модуль не найден (например, на 1-м проходе инициализации)
        (if (eq? *current-pass* 1) 
            null ;; На первом проходе это допустимо
            (error (fmt #f "Module '{}' not found in *modules*" *current-module*)))
        
        ;; Если модуль есть, ищем в сегментах
        (let ((found-label null))
          ;; 1. Проверяем текущий сегмент
          (let ((local (segment-label-get *current-segment* label)))
            (fmt #t "module-label-get {} -> {}\n" label local) ;; Исправлено seg -> mod
            (if (not (null? local))
                (set! found-label local)
                ;; 2. Проверяем остальные сегменты модуля
                ;; ВНИМАНИЕ: Используем for-each-hash для хэш-таблицы сегментов
                (for-each (module-segments mod) (lambda (name seg)
                  (let ((l (segment-label-get seg label)))
                    (if (not (null? l)) (set! found-label l)))))))
          found-label))))

(defun module-label-addr-get (label)
  "На 1-м проходе возвращает 0 для неизвестных меток, на 2-м — кидает ошибку."
  (let ((lab (module-label-get label)))
    (cond
      ((not (null? lab)) (-> lab :address))
      ((eq? *current-pass* 1) 0) ;; Заглушка для первого прохода
      (else (asm-error (fmt #f "Label not found: `{}`" label))))))
      
(defun module-dump-listing (mod)
  (fmt #t "\n--- Module: {} ---\n" (module-name mod)) ;; Исправлено seg -> mod
  (let ((segs (module-segments mod)))
    (if (not (null? segs))
        (for-each segs (lambda (name seg)
          (segment-dump-listing seg)))
        (fmt #t "  (No segments found in module)\n"))))

;;; =====================================================================
;;; Глобальное состояние 
;;; =====================================================================

(defstruct method 
  "Регистрируем фкнецию или метод в базе методов для многопроходной компиляции" 
  (name null)       ;; len, or size or other name
  (type null)       ;; vector3 or other type
  (label null)      ;; full name vector3::len
  (func null)       ;; assigned lambda
  (static #f)       ;; static or object
  (scope 'private)) ;; private or public

(defvar *modules* (make-hash-table) 
  "Глобальный реестр всех загруженных модулей.")

(defvar *current-module* 'default "Имя текущего активного модуля.")
(defvar *current-segment* null "Текущий объект-сегмент для записи.")
(defvar *source-context* null "Метаданные исходного кода для обработки ошибок.")
(defvar *current-pass* 1 "Глобальный флаг прохода")  
(defvar *source-context* null "Контекст ассемблера")
(defvar *methods-to-assemble* '() "Список всех методов, ожидающих компиляции")

(defun get-pass-signature () (fmt #f "{}::{}::pass-{}" *current-module* (segment-name *current-segment*) *current-pass*))

(defmacro pass-case (p1 p2)
  `(if (eq? *current-pass* 1)
       ,p1
       ,p2))

;;; =====================================================================
;;; Core Macros
;;; =====================================================================

(defmacro defmodule (name)
  "Декларирует новый модуль и регистрирует его в глобальном реестре."
  `(let ((mod (gethash ',name *modules* null)))
     (unless mod
       (set! mod (make-module :name ',name 
                              :segments (make-hash-table)))
       (sethash ',name *modules* mod))
      (fmt #t "DEBUG: defmodule {}\n" ',name)
     mod))

(defun get-module (name)
  (begin 
     ;; Если модуля нет — создаем его
     (let ((mod (gethash name *modules*)))
      (if mod
        mod
        (error (fmt #f "Can't find module {}" name))))))

;;; Исправленный with-module (установка глобального флага)
(defmacro with-module (name &rest body)
  `(begin 
     (set! *current-module* ',name) ;; Устанавливаем имя
     ;; Если модуля нет — создаем его
     (unless (gethash ',name *modules*)
       (sethash ',name (make-module :name ',name :segments (make-hash-table)) *modules*))
     ,@body))

;;; Исправленный with-segment
(defmacro with-segment (seg-name &rest body)
  `(begin 
     (set! *current-segment* (module-segment-get *current-module* ',seg-name))
     (fmt #t "DEBUG: with-segment {}\n" ',seg-name)
     ,@body))

(defmacro with-segment (seg-name &rest body)
  "Переключает запись в указанный сегмент (например, 'code или 'data)."
  `(begin
    (fmt #t "With segment {}" ',seg-name)
    (set! *current-segment* (module-segment-get *current-module* ',seg-name))
    ,@body))


(defmodule default)
(with-segment 'code (print "with-segment ok"))
(fmt #t "DEBUG: Modules {}\n" (inspect *modules*))

(defun record-listing-line (start-addr form)
  ;(fmt #t "DEBUG: record-listing-line addr: {} :listing {}\n" start-addr form)
  (segment-record-listing-line *current-segment* start-addr form))

(defun dump-listing (mod-name)
  "Находит модуль по имени в глобальном реестре и печатает листинг всех его сегментов."
  (let ((mod (gethash mod-name *modules*)))
    (if (not (null? mod))
        (module-dump-listing mod)
        (fmt #t "Error: Module '{}' not found in *modules*\n" mod-name))))


(defmacro zasm (&rest body)
  (let ((result '()))
    (for-each body (lambda (form)
      (push! `(begin
                (set! *source-context* ',form)
                (if (list? ',form)
                    ,form 
                    (asm-error (fmt #f "Expected expression, got {}" ',form))))
             result)))

       `(begin ,@(reverse result))))


(defun emit (data &key (listing ""))
  "Принимает байт или список байтов. Если передан :listing, сохраняет строку в листинг."
  (let ((seg *current-segment*)
        (bytes (if (list? data) data (list data))))
    (unless seg
      (throw-error "emit: *current-segment* is null."))
    
    (let ((start-addr (segment-ilc seg)))
      (for-each bytes (lambda (b)
        (let ((current-ilc (segment-ilc seg)))
          (when (eq? *current-pass* 2)
            (buffer-write (segment-buffer seg) b :type 'uint8 :address current-ilc))
          (segment-ilc! seg (+ current-ilc 1)))))

      ;; Если второй проход и есть текст — пишем в листинг
      (when (and (eq? *current-pass* 2))
        (record-listing-line start-addr listing)))))

;; Запись одного байта (8 бит)
(defun emit-db (val)
  (emit (list (logand val #xFF)) 
        :listing (fmt #f "DB  ${:02X}" (logand val #xFF))))

;; Запись слова (16 бит, Little-endian)
(defun emit-dw (val)
  (if (number? val)
      ;; Если число — разбиваем на байты
      (let ((low (logand val #xFF))
            (high (logand (rshift val 8) #xFF)))
        (emit (list low high) 
              :listing (fmt #f "DW  ${:04X}" val)))
      (let ((addr (module-label-addr-get val)))
        ;; Если символ (метка) — передаем как есть, 
        ;; механизм emit должен сам вычислить адрес позже
        (emit (list (lower-byte addr) (higher-byte addr)) 
              :listing (fmt #f "DW  <{}>" val)))))

;; Запись строки (ASCII + нуль-терминатор)
(defun emit-string (s)
  (let ((bytes (string->bytes s)))
    (emit (append bytes (list 0))
          :listing (fmt #f "DB  \"{}\", 0" s))))

(defun emit-space (&optional (text null)) 
  (if text
    (begin
      (emit '() :listing ";; -------------------------------")
      (emit '() :listing (fmt #f ";; {}" text))))
  (emit '() :listing ";; -------------------------------"))

(defun is-alias? (obj)
  "Проверяет, является ли объект псевдонимом регистра/памяти."
  ;; Если у тебя есть примитив native-ref?, используй его.
  ;; Иначе проверяем через системный запрос типа.
    (eq? 'reg-alias (car (inspect obj))))

;;; =====================================================================
;;; 
;;; =====================================================================

(defun asm-source-info ()
  (let ((info (source-info *source-context*)))
    (if info
        (fmt #f "at {}:{}" (getf info :file) (getf info :line))
        "at unknown:0")))

(defun asm-error (message) (error (fmt #f "{} {}" ( get-pass-signature ) message) :ctx *source-context*))

(defun asm-warning (message) (print (fmt #f "{} {} {}" ( get-pass-signature ) (asm-source-info) message)))

(defmacro check-type (var predicate)
  `(if (not (,predicate ,var))
    (error (fmt #f "Variable `{}` failed type check `{}` because value: `{}` of type {}" 
      ',var ',predicate ,var (type-of ,var) *source-context*))))


;;; =====================================================================
;;; Labels
;;; =====================================================================

(defun label (name &key (address null) (scope 'private))
  "Динамическая регистрация метки"
  (let* ((seg *current-segment*)
          (addr (if (null? address) (segment-ilc seg) address)))
     ;; Снова ставим кавычку перед name, чтобы (.label start) работало
     (segment-label-set! seg name :address addr :scope scope)
     (emit '() :listing (fmt #f "--- .label {} @ {:04X} ---" name addr))))

(defmacro .label (name &key (address null) (scope 'private))
  "Статическая регистрация метки"
  `(let* ((seg *current-segment*)
          (addr (if (null? ,address) (segment-ilc seg) ,address)))
     ;; Снова ставим кавычку перед name, чтобы (.label start) работало
     (segment-label-set! seg ',name :address addr :scope ',scope)
     (emit '() :listing (fmt #f "--- .label {} @ {:04X} ---" ',name addr))))

(defun address-of (label)
  "Функция для использования внутри Lisp-выражений в zasm"
  (module-label-addr-get label))

;;; =====================================================================
;;; Коллекция вариантов команд
;;; =====================================================================

(define *asm-handlers* (make-hash-table))

(defun obj->string (obj) (fmt #f "{}" obj))

;; Генерируем ключ вида "ld:8-reg:number"
(defun make-sig-key (cmd sig)
  (when (keyword? sig) (error "Unexpected keyword"))
  (let ((sig-str (cond 
                   ((string? sig) sig)
                   ((symbol? sig) (symbol->string sig))
                   ((list? sig)   (string-join (map obj->string sig) "-"))
                   (else (obj->string sig)))))
    (fmt #f "{}:{}" cmd sig-str)))

(defun register-handler (cmd sig fn)
  (let ((key (make-sig-key cmd sig)))
    (fmt #t "Register handler: {}\n" key)
    (hash-table-set! *asm-handlers* key fn)))

(defun find-handler! (cmd sig)
  (let* ((key (make-sig-key cmd sig))
         (h   (hash-table-ref *asm-handlers* key #f)))
    (or h 
        (let ((available (filter (lambda (k) (string-prefix? (fmt #f "{}:" cmd) k))
                                 (hash-table-keys *asm-handlers*))))
          (asm-error (fmt #f "Instruction {}: no implementation for [{}]\nAvailable variants:\n  {}" 
                          cmd 
                          (if (list? sig) (string-join (map obj->string sig) "-") sig)
                          (if (null? available) 
                              "NONE (check registration)" 
                              (string-join available "\n  "))))))))

(defmacro define-instruction (name)
  `(defun ,name (dest &optional (src null))
     (let* ((d-tok (parse-arg dest))
            (s-tok (if (null? src) null (parse-arg src)))
            (sig (if (null? s-tok)
                     (list (asm-token-type d-tok))
                     (list (asm-token-type d-tok) (asm-token-type s-tok))))
            (handler (find-handler! ',name sig)))
       (if (null? s-tok)
           (apply handler (list (asm-token-value d-tok)))
           (apply handler (list (asm-token-value d-tok) (asm-token-value s-tok)))))))

;;; =====================================================================
;;; 
;;; =====================================================================

;; Теперь твои определения выглядят супер-лаконично:
(defun .nop () (emit '(#x00) :listing ".nop"))
(defun .di  () (emit '(#xF3) :listing ".di"))
(defun .ei  () (emit '(#xFB) :listing ".ei"))

(defun .ret (&optional cc)
  (if (null? cc)
      ;; Обычный RET (#xC9)
      (emit #xC9 :listing "RET")
      ;; Условный RET: #xC0 + (code << 3)
      (let ((op (+ #xC0 (ash (con-code cc) 3))))
        (emit op :listing (fmt #f "RET {}" cc)))))

  ;; RST n: коды от #xC7 до #xFF с шагом 8
(defun .rst (val)
  (emit (+ #xC7 val) :listing (fmt #f "RST {:02X}h" val)))

(for-each '(a b c d e h l) (lambda (r)
  (register-handler '.ld "8-reg-8-reg"
    (lambda (d s) (emit (logior #x40 (ash (reg-code d) 3) (reg-code s)))))))

;;; =====================================================================
;;; LD
;;; =====================================================================

;; OR A (часто используется для проверки A на ноль)
(register-handler '.or "8-reg"
  (lambda (r) (emit (+ #xB0 (reg-code r)) :listing (fmt #f "OR {}" r))))

;; INC 16-bit register
(register-handler '.inc "16-reg"
  (lambda (r) (emit (+ #x03 (ash (reg-code r) 4)) :listing (fmt #f "INC {}" r))))

(define-instruction .or)
(define-instruction .inc)

;;; =====================================================================
;;; LD
;;; =====================================================================

(register-handler '.ld "8-reg-number"
  (lambda (d s) (emit (list #x3E s) :listing (fmt #f "LD {}, ${:02X}" d s))))

;; LD A, (HL) -> #x7E
(register-handler '.ld "8-reg-symbol"
  (lambda (d s)
    (if (and (eq? d 'a) (eq? s 'hl))
        (emit #x7E :listing "LD A, (HL)")
        (asm-error "Only 'LD A, (HL)' is supported for this signature"))))

;; LD 16-reg, number (например, LD HL, $4100)
(register-handler '.ld "16-reg-number"
  (lambda (d s) 
    (cond
      ((eq? d 'ix) 
       (emit (list #xDD #x21 (lower-byte s) (higher-byte s)) 
             :listing (fmt #f "LD IX, ${:04X}" s)))
      ((eq? d 'iy) 
       (emit (list #xFD #x21 (lower-byte s) (higher-byte s)) 
             :listing (fmt #f "LD IY, ${:04X}" s)))
      (else
       (let ((op (+ #x01 (ash (reg-code d) 4))))
         (emit (list op (lower-byte s) (higher-byte s))
               :listing (fmt #f "LD {}, ${:04X}" d s)))))))

(register-handler '.ld "16-reg-ix-indexed"
  (lambda (d s) 
    (let ((off (cdr s)))
       (emit (list #xDD #x6E off #xDD #x66 (+ off 1))))))

;; LD A, (IX+d) -> DD 7E d
(register-handler '.ld "8-reg-ix-indexed"
  (lambda (reg off)
    ;; Вычисляем код регистра (A=7, B=0, C=1, D=2, E=3, H=4, L=5)
    (let ((r-code (reg-code reg)))
      ;; Опкод: #x40 + (r << 3) + 6
      (let ((opcode (+ #x40 (ash r-code 3) 6)))
        (emit (list #xDD opcode off)
              :listing (fmt #f "LD {}, (IX+{})" reg off))))))

;; LD (IX+d), R -> DD 70+reg d
(register-handler '.ld '(ix-indexed 8-reg)
  (lambda (dist r)
    (emit (list #xDD (+ #x70 (reg-code r)) dist)
          :listing (fmt #f "LD (IX+{}), {}" dist r))))

;; LD (IX+d), n  -> #xDD #x36 dist n
(register-handler '.ld "ix-indexed-number"
  (lambda (off val)
    (fmt #t "DEBUG: val is {} type is {}\n" val (type-of val))
    (emit (list #xDD #x36 off val) 
          :listing (fmt #f "LD (IX+{}), ${:02X}" off val))))

;; LD (IY+d), n  -> #xFD #x36 dist n
(register-handler '.ld "iy-indexed-number"
  (lambda (off val)
    (emit (list #xFD #x36 off val) 
          :listing (fmt #f "LD (IY+{}), ${:02X}" off val))))

;; 1. Чтение из памяти: LD A, (HL/BC/DE)
(register-handler '.ld '(8-reg indirect)
  (lambda (d s)
    (if (eq? d 'a)
        (cond
          ((eq? s 'hl) (emit #x7E :listing "LD A, (HL)"))
          ((eq? s 'bc) (emit #x0A :listing "LD A, (BC)"))
          ((eq? s 'de) (emit #x1A :listing "LD A, (DE)"))
          (else (asm-error (fmt #f "Z80 cannot LD A from ({})" s))))
        (asm-error "Indirect load to register is only supported for Accumulator (A)"))))

;; 2. Запись в память: LD (HL/BC/DE), A
(register-handler '.ld '(indirect 8-reg)
  (lambda (d s)
    (if (eq? s 'a)
        (cond
          ((eq? d 'hl) (emit #x77 :listing "LD (HL), A"))
          ((eq? d 'bc) (emit #x02 :listing "LD (BC), A"))
          ((eq? d 'de) (emit #x12 :listing "LD (DE), A"))
          (else (asm-error (fmt #f "Z80 cannot LD ({}) from A" d))))
        (asm-error "Indirect store is only supported from Accumulator (A)"))))

(register-handler '.ld "16-reg-16-reg" 
  (lambda (dst src)
    (cond
      ;; Случай LD IX, HL (или IY, HL)
      ((and (member dst '(ix iy)) (eq? src 'hl))
       (begin 
         ;; Эмитим PUSH HL (0xE5)
         (emit #xE5 :listing "PUSH HL")
         ;; Эмитим POP IX (0xDD 0xE1) или POP IY (0xFD 0xE1)
         (if (eq? dst 'ix)
             (emit (list #xDD #xE1) :listing "POP IX")
             (emit (list #xFD #xE1) :listing "POP IY"))))
      
      ;; Случай LD HL, IX (или HL, IY)
      ((and (eq? dst 'hl) (member src '(ix iy)))
       (begin
         (if (eq? src 'ix)
             (emit (list #xDD #xE5) :listing "PUSH IX")
             (emit (list #xFD #xE5) :listing "PUSH IY"))
         (emit #xE1 :listing "POP HL")))

      ;; Универсальное копирование для BC, DE, HL через промежуточный регистр
      ;; (Если процессор не поддерживает прямой LD между ними)
      (else
       (begin
         (emit-ld-reg8 (low-reg dst) (low-reg src))
         (emit-ld-reg8 (high-reg dst) (high-reg src)))))))

;; ADD HL, rr (BC=00, DE=10, HL=20, SP=30)
(register-handler '.add "16-reg-16-reg"
  (lambda (d s)
    (if (eq? d 'hl)
        (let ((op (+ #x09 (ash (reg-code s) 4))))
          (emit op :listing (fmt #f "ADD HL, {}" s)))
        (asm-error "Z80 can only ADD to HL (or IX/IY) for 16-bit registers"))))

;; Теперь вместо написания функций вручную:
(define-instruction .ld)
(define-instruction .add)
(define-instruction .sub)
(define-instruction .xor)

;;; =====================================================================
;;; Переходы
;;; =====================================================================


;; Для JR
(register-handler '.jr '(number)
  (lambda (target-addr)
    (let* ((current-ilc (segment-ilc *current-segment*))
           (offset (- target-addr (+ current-ilc 2))))
      (emit (list #x18 (logand offset #xFF)) 
            :listing (fmt #f "JR {:+d} (to ${:04X})" offset target-addr)))))

(register-handler '.jr '(condition number)
  (lambda (cc target-addr)
    (let* ((current-ilc (segment-ilc *current-segment*))
           (offset (- target-addr (+ current-ilc 2)))
           ;; Условный JR: #x20 + (code << 3)
           ;; Внимание: в Z80 для JR доступны только NZ, Z, NC, C
           (op (+ #x20 (ash (con-code cc) 3))))
      (emit (list op (logand offset #xFF))
            :listing (fmt #f "JR {}, {:+d}" cc offset)))))

(define-instruction .jr)
(define-instruction .call)

;; Без условия: JP nn (тип сигнатуры: (number))
(register-handler '.jp '(number)
  (lambda (addr)
    (emit (list #xC3 (lower-byte addr) (higher-byte addr))
          :listing (fmt #f "JP ${:04X}" addr))))

;; С условием: JP cc, nn (тип сигнатуры: (condition number))
(register-handler '.jp '(condition number)
  (lambda (cc addr)
    (let ((op (+ #xC2 (ash (con-code cc) 3))))
      (emit (list op (lower-byte addr) (higher-byte addr))
            :listing (fmt #f "JP {}, ${:04X}" cc addr)))))

(register-handler '.jp "16-reg"
  (lambda (reg)
    (cond
      ((eq? reg 'hl) (emit #xE9 :listing "JP (HL)"))
      ((eq? reg 'ix) (emit (list #xDD #xE9) :listing "JP (IX)"))
      ((eq? reg 'iy) (emit (list #xFD #xE9) :listing "JP (IY)"))
      (else (asm-error "Z80 can only JP to HL, IX, or IY")))))
      
(define-instruction .jp)

(defun .jump (target)
  (let* ((t-tok (parse-arg target))
         (target-addr (asm-token-value t-tok))
         (current-ilc (segment-ilc *current-segment*)))
    (cond
      ((eq? *current-pass* 1)
       (emit '(#xC3 #x00 #x00) :listing (fmt #f "JP ${:04X} (placeholder)" target-addr)))
      (else
       (let ((offset (- target-addr (+ current-ilc 2))))
         (if (and (>= offset -128) (<= offset 127))
             (begin
               (emit (list #x18 (logand offset #xFF)) :listing (fmt #f "JR {:+d} (optimized)" offset))
               (emit #x00 :listing "nop (align)")) 
             (emit (list #xC3 (lower-byte target-addr) (higher-byte target-addr))
                   :listing (fmt #f "JP ${:04X}" target-addr))))))))

;;; =====================================================================
;;; Procedures
;;; =====================================================================

(register-handler '.call 'number
  (lambda (addr)
    (emit (list #xCD (lower-byte addr) (higher-byte addr))
          :listing (fmt #f "CALL ${:04X}" addr))))

(define-instruction .call)

;;; =====================================================================
;;; директивы
;;; =====================================================================


(defun .db (&rest args)
  (for-each args (lambda (arg)
    (cond
      ;; Если это число
      ((number? arg) 
       (emit arg :listing (fmt #f "DB ${:02X}" arg)))
      
      ;; Если это строка — расщепляем на байты
      ((string? arg)
       (let ((bytes (string->bytes arg)))
         (emit bytes :listing (fmt #f "DB \"{}\"" arg))))
      
      ;; Если это список (выражение)
      ((list? arg)
       (let ((val (eval arg)))
         (emit val :listing (fmt #f "DB ${:02X} (expr)" val))))
      
      (else (error "DB: Unsupported data type" arg))))))

(defun .dw (&rest args)
  (for-each args (lambda (arg)
    (let* ((t-tok (parse-arg arg))
           (val (asm-token-value t-tok)))
      (emit (list (lower-byte val) (higher-byte val))
            :listing (fmt #f "DW ${:04X}" val))))))

(defun .ds (size &optional (fill #x00))
  (dotimes (i size)
    (emit fill :listing (if (= i 0) (fmt #f "DS {} bytes" size) ""))))

;;; =====================================================================
;;; Address 
;;; =====================================================================

(defun .org (new-addr)
  (let ((seg *current-segment*))
    (segment-ilc! seg new-addr)
    ;; В листинге отмечаем прыжок адреса
    (emit '() :listing (fmt #f "ORG set to ${:04X}" new-addr))))

(defun .align (boundary &optional (fill #x00))
  (let* ((seg *current-segment*)
         (current (segment-ilc seg))
         ;; Вычисляем, сколько байт нужно добавить до границы
         (rem (mod current boundary))
         (padding (if (= rem 0) 0 (- boundary rem))))
    (when (> padding 0)
      (dotimes (i padding)
        (emit fill :listing (if (= i 0) (fmt #f "ALIGN {} (added {} bytes)" boundary padding) ""))))))

;;; =====================================================================
;;; Структура
;;; =====================================================================
(defmacro .static-new (instance-name type-name &rest args)
  (let* ((type-obj (~> type-name))
         (data-map (make-hash-table))
         (ops '()))
    
    ;; 1. Собираем аргументы из args (там лежат :x 100 :y 50 ...)
    ;; Используем while, так как он надежнее всего работает с парными списками
    (let* ((plist args))
      (while (not (null? plist))
        (let* ((k (car plist))
               (v (if (not (null? (cdr plist))) (cadr plist) 0)))
          ;; Ключ k (например, :x) превращаем в строку "x"
          ;; Важно: если k это :x, symbol->string вернет ":x" или "x" 
          ;; в зависимости от реализации, поэтому очистим от двоеточия если надо
          (hash-table-set! data-map (symbol->string k) v)
          (set! plist (cddr plist)))))

    ;; 2. Базовая метка структуры (теперь точно есть)
    (push! `(.label ,instance-name) ops)
    (emit-space (fmt #f "static-new {}" ',instance-name))

    ;; 3. Проход по всем полям через C++ итератор
    (type-for-each-field type-obj
      (lambda (idx offset field)
        (let* ((f-name (-> field :name))
               (f-tspec (-> field :type-spec))
               (f-base (-> f-tspec :base-type))
               ;; Ищем значение в мапе. Пробуем f-name, ":f-name" и т.д.
               (val (or (hash-table-ref data-map f-name #f)
                        (hash-table-ref data-map (string-append ":" f-name) 0)))
               
               ;; Генерируем метку доступа instance::field
               (f-label (string->symbol (fmt #f "{}::{}" instance-name f-name))))
          
          ;; Метка для каждого байта поля
          (push! `(.label ,f-label) ops)

          ;; 4. Генерация данных
          (push! 
            (cond
              ((or (eq? f-base "pointer") 
                   (member f-base '("int16" "uint16" "word" "int" "uint")))
               `(.dw ,val))
              (else `(.db ,val)))
            ops))))

    `(begin ,@(reverse ops))))
;;; =====================================================================
;;; Validations of arguments
;;; =====================================================================

(defun is-ptr? (tspec)
  (eq? (-> tspec .base-type) "pointer"))

(defun get-type-size (tspec)
  (let ((type-name (-> tspec .base-type)))
    (cond
      ((is-ptr? tspec) 2) ;; Указатели на Z80 всегда 16 бит
      ((member type-name '("int8" "uint8" "byte")) 1)
      ((member type-name '("int16" "uint16" "word")) 2)
      (else (-> (lookup-type type-name) .size)))))

;; Основная логика валидации регистров
(defun validate-reg-for-type (reg tspec arg-idx)
  (let ((size (get-type-size tspec))
        (reg-name (symbol->string reg)))
    (cond
      ((and (= size 1) (not (member reg '(a b c d e h l))))
       (asm-error (fmt #f "Argument {}: expected 8-bit register for type {}, but got {}" 
                       arg-idx (-> tspec .base-type) reg)))
      ((and (= size 2) (not (member reg '(hl de bc ix iy))))
       (asm-error (fmt #f "Argument {}: expected 16-bit register for type {}, but got {}" 
                       arg-idx (-> tspec .base-type) reg))))))

;;; =====================================================================
;;; Обработка всех харегестрированных методов
;;; =====================================================================

(defun finalize-method-registration ()
  (for-each *methods-to-assemble*
    (lambda (m)
      ;; 1. Вызываем функцию один раз (сухой запуск)
      ;; Это заставит сработать (declare) и заполнит LambdaObject->declarations
      ;(call (method-func m))
      (print (inspect m))
      ;; 2. Теперь регистрируем в системе типов. 
      ;; Твой C++ код set_method теперь увидит готовый typespec!
      (if (method-static m)
          (define-function (method-name m) (method-func m))
          (define-method (method-type m) (method-name m) (method-func m))))))

;;; =====================================================================
;;; Procedure
;;; =====================================================================

(defun get-keyword (key lst)
  (cond
    ((null? lst) 'null)
    ((eq? key (car lst)) (cadr lst))
    (else (get-keyword key (cdr lst)))))

(defmacro defproc (name args &rest body)
  (let ((label-name name)
        (arg-types (map (lambda (x) (if (list? x) (cadr x) 'object)) args))
        (rlet-bindings (filter (lambda (x) (list? x)) args)))
    
    `(let ((impl (lambda ()
                   ;; 1. Системная декларация SOOT (C++ уровень)
                   ;; Она ВСЕГДА должна быть первым выражением в лямбде
                   (declare-extern ,label-name (function ,arg-types none)) 
                   
                   (rlet ,rlet-bindings 
                        ;; 2. Ассемблерный контекст
                        (zasm 
                          (emit-space (fmt #f "function {}" ',label-name))
                          (.label ,label-name :scope 'public)
                          ;; Если в @body есть ассемблерный (declare ...), 
                          ;; нам нужно, чтобы zasm его зацитировал или переименовал
                          ,@body)
                        (.ret)))))
       
       (push! (make-method
                :static #t
                :func impl 
                :type 'global
                :name ',label-name
                :label ',label-name
                :scope 'public)
              *methods-to-assemble*)
       
       (define ,name impl))))

(defmacro call-proc (name &rest args)
  "Пример: (call-proc copy-string :dest buffer :src msg)"
  `(begin
     ;; Здесь макрос должен посмотреть в декларацию defproc
     ;; и сгенерировать LD для каждого аргумента
     (.ld de ,(get-arg args :dest))
     (.ld hl ,(get-arg args :src))
     (.call ',name)))

;;; =====================================================================
;;; Methods 
;;; =====================================================================

(defmacro defmethod-instance (name args &rest body)
  (let* ((this-spec (car args))      ;; (self :vec3)
         (this-type (cadr this-spec))
         (label-sym (intern (fmt #f "{}::{}" this-type name))))
    `(let ((impl (lambda () 
                   (rlet asm-regs ((,(car this-spec) ,this-type :reg ix))
                     (emit-space (fmt #f "instance-method {}" ',label-sym))
                     (.label ,label-sym :scope 'public)
                     (zasm ,@body)
                     (.ret)))))
       ;; Сохраняем в реестр вместо немедленной регистрации
       (push! (make-method :func impl 
                           :type ',this-type 
                           :name ',name
                           :label ',label-sym
                           :scope 'public) 
              *methods-to-assemble*))))

(defmacro defmethod-static (name type args &rest body)
  (let ((label-sym (intern (fmt #f "{}::{}" type name)))
        ;; Извлекаем только списки (arg :reg ... :type ...)
        (rlet-bindings (filter (lambda (x) (list? x)) args)))
    `(let ((impl (lambda () 
                   ;; Убрали ` перед rlet! Теперь это код, а не данные.
                   (rlet asm-regs ,rlet-bindings  
                      (zasm 
                      (emit-space (fmt #f "static-method {}" ',label-sym))
                      (.label ,label-sym :scope 'public)
                      ;; Тут важно: если body содержит макросы (типа zasm), 
                      ;; они должны раскрыться здесь.
                      ,@body
                      (.ret))))))
       (push! (make-method
                :func impl 
                :type ',type 
                :name ',name
                :label ',label-sym 
                :scope 'public
                :static #t) ;; Поправь тут поле, в логе было :static
              *methods-to-assemble*))))

(defmacro defmethod (name type-or-args &rest body)
  (cond
    ;; Случай: (defmethod new vec3 (x y z) ...)
    ((eq? name 'new)
     (let ((type type-or-args)
           (args (car body))
           (actual-body (cdr body)))
       `(defmethod-static ,name ,type ,args ,@actual-body)))

    ;; Случай: (defmethod len ((self vec3)) ...)
    ((list? type-or-args)
     `(defmethod-instance ,name ,type-or-args ,@body))

    (else 
     (error "Malformed defmethod: check arguments structure."))))

(defmacro call-method (obj method-full-name &rest args)
  (let* ((full-str (symbol->string (unquote-sym method-full-name)))
         (parts (filter (lambda (x) (> (string-length (symbol->string x)) 0)) 
                        (string-split full-str "::")))
         (t-name (car parts))
         (m-name (cadr parts))
         (m-id (eval `(method-id-of ',t-name ',m-name)))
         (offset (* 3 m-id)))
    ;; Оборачиваем в begin, чтобы zasm понял, что это группа команд
    `(begin
       (.ld ix 1)
       (.ld ix ,obj)
       (.ld l (+ix 0))
       (.ld h (+ix 1))
       (.ld de ,offset)
       (.add hl de)
       (.jp hl)
       )
       ))

;;; =====================================================================
;;; V-Table 
;;; =====================================================================

(defun last-element (lst)
  (if (null? (cdr lst))
      (car lst)
      (last-element (cdr lst))))

(defun method-name-only (full-name)
  (let ((s (symbol->string full-name)))
    (if (string-contains? s "::")
        (last-element (string-split s "::"))
        s)))

;;; 1. Сначала определяем вспомогательную функцию
(defun emit-vtable-slots (type-obj emit-fn)
  (let ((data '()))
    ;; Используем новый интринсик: x = ID, y = MethodInfo или null
    (type-for-each-method type-obj 
      (lambda (id method)
        (if (not (null? method))
            ;; Если метод найден (в типе или у родителя)
            ;; Берем имя самого метода, префикс vtable останется за вызывающим
            (let ((full-name (intern (concat (-> method :type-name) "::" (-> method :name)))))
              (push! (emit-fn full-name id) data))
            
            ;; Если метода нет ни в этом типе, ни выше по иерархии
            (push! (emit-fn #f id) data))))
    (flatten (reverse data))))

;;; 2. Теперь определяем функцию генерации таблицы
(defun .vtable (type-obj)
  (let ((v-name (intern (fmt #f "{}::vtable" (-> type-obj :name)))))
    ;; Базовая метка таблицы
    (emit-space (fmt #f "vtable {}" v-name))
    (label v-name :scope 'public)
  
    (emit-vtable-slots type-obj 
      (lambda (method-full-name index)
        (let* ((label-name 
                (if method-full-name 
                    (intern (fmt #f "{}::{}" v-name (method-name-only method-full-name)))
                    (intern (fmt #f "{}::empty_{}" v-name index)))))
          
          ;; Ставим метку слота
          (label label-name)
          
          (if method-full-name
            (let ((addr (module-label-addr-get method-full-name)))
              (if (and addr (not (= addr 0)))
                  ;; СЛУЧАЙ А: Метод найден и скомпилирован
                  (emit (list #xC3 (lower-byte addr) (higher-byte addr))
                        :listing (fmt #f "JMP {}" method-full-name))
                  
                  ;; СЛУЧАЙ Б: Метод объявлен в типе, но кода нет (Label not found)
                  (begin
                    (asm-warning (fmt #f "Method implementation not found: {}. Plugging with panic." method-full-name))
                    (let ((panic-addr (module-label-addr-get 'panic_unimplemented)))
                      (emit (list #xC3 (lower-byte panic-addr) (higher-byte panic-addr))
                            :listing (fmt #f "MISSING: JP panic ({})" method-full-name))))))
            
            ;; СЛУЧАЙ В: Слот вообще пустой (даже в интерфейсе)
            (let ((panic-addr (module-label-addr-get 'panic_unimplemented)))
              (emit (list #xC3 (lower-byte panic-addr) (higher-byte panic-addr))
                    :listing "EMPTY SLOT: JP panic"))))))))

;;; =====================================================================
;;; Types
;;; =====================================================================   

(defun .type-descriptor (type-obj)
  (let* ((t-name (-> type-obj :name))
         ;; Используем "def" как универсальный указатель на определение типа
         (label-base (fmt #f "type.def.{}" t-name)))

    (emit-space (fmt #f "type descriptor: {}" t-name))
    (label (intern label-base) :scope 'public)
    
    ;; +0: Указатель на родителя (теперь мы всегда знаем префикс!)
    (let ((parent-name (-> type-obj :parent)))
      (if (and parent-name (not (eq? parent-name "")))
          (emit-dw (intern (fmt #f "type.def.{}" parent-name)))
          (emit-dw 0)))

    ;; +2: Указатель на имя
    (emit-dw (intern (fmt #f "type.name.{}" t-name)))

    ;; +4: Размер и Класс (Kind)
    (emit-db (-> type-obj :size))
    (emit-db (crc32 (-> type-obj :class))) ;; Сохраним класс внутри!

    ;; Остальное без изменений...
    (.vtable type-obj)
    
    (label (intern (fmt #f "type.name.{}" t-name)))
    (emit-string t-name)))
    
;;; =====================================================================
;;; Top Level Functions
;;; =====================================================================   

(defun assemble-module (name)
  ;; 1. Устанавливаем текущий модуль (name тут - это 'default)
  (set! *current-module* name)
  
  ;; 2. Гарантируем, что модуль существует
  (let ((mod (gethash name *modules*)))
    (unless mod
      (set! mod (make-module :name name :segments (make-hash-table)))
      (sethash name mod *modules*))
    
    ;; 3. Работаем с сегментом 'code'
    (set! *current-segment* (module-segment-get name 'code))
    
    (let ((methods (reverse *methods-to-assemble*)))
      (for-each '(1 2) (lambda (pass)
        (set! *current-pass* pass)
        (segment-reset *current-segment*)
        
        (fmt #t "--- PASS {} ---\n" pass)
        
        (for-each methods (lambda (m)
          ;; Ставим метку метода (например, "method-vec3::len")
          (segment-label-set! *current-segment* (method-label m))
          
          ;; Вызываем тело (лямбду), которая сама сделает rlet и zasm
          ;; Оборачиваем весь блок в ловушку
          (with-error-handler 
            (lambda (msg err-form trace)
              ;; Добавляем "этаж" контекста
              (list *source-context* "ZASM Expansion error")) 
            ((method-func m)))))))
      (finalize-method-registration)
      (fmt #t "Assembly of module '{}' finished.\n" name))))