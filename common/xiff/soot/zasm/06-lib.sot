;;; 06-lib.sot xiff meta-assembler z80 library

(with-segment code

;;; ===================================================================== 
;;; System Methods
;;; ===================================================================== 

(defproc panic-unimplemented ()
  (declare (asm-func none))
  (fmt #t "DEBUG panic-unimplemented...\n"))

;;; ===================================================================== 
;;; Type System Methods
;;; ===================================================================== 
;;;
;;; Назначение аргументов по позициям
;;;
;;; Аргумент 0: allocation
;;; 
;;; Этот аргумент есть у всех конструкторов. Он имеет тип symbol и 
;;; указывает откуда и как выделять память для нового объекта. Типичные 
;;; значения: 'global, 'debug, 'game и т.д., которые определяют пул 
;;; памяти (например, игровая куча, отладочная куча).
;;;
;;; Аргумент 1: type-to-make
;;; 
;;; Этот аргумент также присутствует во всех конструкторах. Он имеет 
;;; тип type и является мета-объектом, описывающим создаваемый тип. 
;;; Он используется для:
;;; 
;;;     Получения размера базовой части объекта (-> type-to-make size).
;;; 
;;;     Получения информации о вложенных или дочерних типах (например, 
;;;     content-type для массива).
;;;
;;; Аргумент 2: специфичный для каждого объекта. 
;;;
;;; Это может бить например размер масива для array или другой параметр
;;; конструктора
;;; 
(defmethod new object ((a symbol) (b type) (c int))
    (declare (asm-func _type_))
    (fmt #t "DEBUG new object..\n")
  )

(defmethod delete ((this object))
  (declare (asm-func none))
  (fmt #t "DEBUG object delete..\n"))

(defmethod print ((this object))
  (declare (asm-func _type_))
  (fmt #t "DEBUG object print..\n"))

(defmethod new structure ((a symbol) (b type))
  (declare (asm-func _type_))
  (fmt #t "DEBUG new structure..\n"))

(defmethod new basic ((a symbol) (b type))
  (declare (asm-func _type_))
  (fmt #t "DEBUG new structure..\n"))

(defmethod new type ((a symbol) (b type) (c int))
  (declare (asm-func _type_))
  (fmt #t "DEBUG new structure..\n"))

)

(with-segment code

(defproc make-base-descriptors ()
  (declare (asm-func none))
  (fmt #t "DEBUG make-base-descriptors...\n")
  (.type-descriptor object)    ;; Родитель 0, проблем нет
  (.type-descriptor structure) ;; Родитель object, метка уже есть
  (.type-descriptor basic)     ;; Родитель structure, метка уже есть
  (.type-descriptor type)      ;; Родитель basic, метка уже есть
  )
) ;; end of segment