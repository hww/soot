(init-types 'z80)

(load "common/xiff/soot/zasm/zasm.sot")

(deftype vec3s8 (structure)
  ((x int8) 
   (y int8) 
   (z int8))
 (:methods
      (new (int16 int16) _type_)
      (len () int16)))

(deftype vec3 (structure)
  ((x int16) 
   (y int16) 
   (z int16))
 (:methods
      (new (int16 int16) _type_)
      (clear (_type_) none)
      (len (_type_) int16)))

(deftype mat3 (structure)
  ((r1 vec3 :inline)   
   (r2 vec3 :inline)   
   (r3 vec3 :inline))) 

(defenum eflag
  :type uint8
  :bitfield #t
  (bit0 0)
  (bit1 1)
  (bit2 2)
  (bit3 3))

(segment-reset *current-segment*)

;;; ===================================================================== 
;;; System Methods
;;; ===================================================================== 

(defproc panic_unimplemented ()
  (declare (once) (asm-func none))
  (fmt #t "DEBUG panic_unimplemented...\n"))

;;; ===================================================================== 
;;; Type System Methods
;;; ===================================================================== 

(defmethod new object ((a symbol) (b type) (c int))
    (declare (once) (asm-func _type_))
    (fmt #t "DEBUG new object..\n")
  )

(defmethod delete ((this object))
  (declare (once) (asm-func none))
  (fmt #t "DEBUG object delete..\n"))

(defmethod print ((this object))
  (declare (once) (asm-func _type_))
  (fmt #t "DEBUG object print..\n"))

(defmethod new structure ()
  (rlet ((a symbol) (b type))
    (declare (once) (asm-func _type_))
    (fmt #t "DEBUG new structure..\n")))

(defmethod new basic ()
  (rlet ((a symbol) (b type))
    (declare (once) (asm-func _type_))
    (fmt #t "DEBUG new structure..\n")))

(defmethod new type ()
  (rlet ((a symbol) (b type) (c int))
    (declare (once) (asm-func _type_))
    (fmt #t "DEBUG new structure..\n")))

;;; ===================================================================== 
;;; Methods
;;; ===================================================================== 

;; Пример для твоего синтаксиса (как в sprite-aux-list)
(defmethod new vec3 ((x int16) (y int16))
  ;; 1. Допустим, адрес аллокации передается в HL (через object-new)
  ;; (.call 'object-new)
  (declare (once) (asm-func _type_))
  (fmt #t "DECLARATIONS vec3::new {}" (declarations))
  ;; 2. Инициализируем VTable объекта (первые 2 байта)
  (.ld hl 'vec3::vtable)
  (.ld (+ix 0) l)
  (.ld (+ix 1) h)
  ;
  ;;; 3. Обнуляем поля или ставим дефолты
  (.ld (+ix 2) 0) ;; x
  (.ld (+ix 4) 0) ;; y
  (.ret))

(defmethod clear ((self vec3))
  (declare (once) (asm-func none))
  (fmt #t "DECLARATIONS vec3::clear {}" (declarations))
  (rlet ((self vec3 :reg ix))
    (zasm 
      (.ld (-> self x) 0)
      (.ld (-> self y) 0)
      (.ld (-> self z) 0)
      (.ret))))

(defmethod len ((this vec3))
  (declare (once) (asm-func int16))
  (fmt #t "DECLARATIONS vec3::len {}" (declarations))
  ;; Первый rlet (информационный) уже добавлен макросом скрыто.
  ;; Теперь программист добавляет свой (машинный) rlet:
  (rlet ((self uint8 :reg ix)
         (x    uint8 :reg a)) 
    (zasm
      (.label start)
      (.jr 'start)    ;; Переход назад на 3 байта
      (.jp 'exit)    ;; Переход вперед на метку exit
      (.nop)    
      (.ld self 10)
      (.ld self #x0A)  ;; Запишет 10 в (IX+0)
      (.ld a #x55)    ;; Загрузит 85 в A
      (.ld self #x0A) ;; Это (IX+0)
      (.jr 'start)    ;; Переход назад на 3 байта
      (.jp 'exit)    ;; Переход вперед на метку exit
      (.label exit)      
      (.ret))))

;;; ===================================================================== 
;;; V-Table
;;; ===================================================================== 

(defproc test-vtable ()
  (declare (once) (asm-func none))
  (fmt #t "DEBUG test-vtable...\n")
  (.vtable vec3))

(defproc test-vtable-proxy ()
  (declare (once) (asm-func none))
  (fmt #t "DEBUG test-vtable-proxy...\n")
  (.vtable-proxy vec3 'vec3-active ))

(defproc test-vtable-proxy-switch ()
  (declare (once) (asm-func none))
  (fmt #t "DEBUG test-vtable-proxy-switch...\n")
  (.switch-vtable vec3 'vec3-active ))


;;; ===================================================================== 
;;; Type Descriptor
;;; ===================================================================== 

(defproc test-type-descriptor ()
  (declare (once) (asm-func none))
  (fmt #t "DEBUG test-type-descriptor...\n")
  (.type-descriptor object)    ;; Родитель 0, проблем нет
  (.type-descriptor structure) ;; Родитель object, метка уже есть
  (.type-descriptor basic)     ;; Родитель structure, метка уже есть
  (.type-descriptor type)      ;; Родитель basic, метка уже есть
  (.type-descriptor vec3)
  )

;;; ===================================================================== 
;;; Structure
;;; ===================================================================== 

(defproc test-structure ()
  (declare (once) (asm-func none))
  (fmt #t "DEBUG test-structure...\n")
  (.static-new foo vec3
    :x 100
    :y 50
    :z 16
    ))

(defproc process-vector ((v pointer hl))
  (declare (once) (asm-func none))
  (fmt #t "DEBUG process-vector...\n")
  (.ld ix hl)
  (.ld ix v)
  (.ld a (+ix (-> vec3 y))) ;; Автоматически вычисляет смещение поля :y
  (.ld a (->ix vec3 y))  ;; Сгенерирует LD A, (IX+2)
  (.ld a (+ix 4))  ;; Сгенерирует LD A, (IX+2)
  (.ret))


;;; ===================================================================== 
;;; Method Call
;;; ===================================================================== 

(defproc test-call-method ()
  (declare (once) (asm-func none))
  (call-method #x100 vec3::len)
  (.ret))

(defproc test-new-call-method ()
  (declare (once) (asm-func none))
  (call-method #x100 vec3::new 0 0)
  (.ret))


;;; ===================================================================== 
;;; Other Tests
;;; ===================================================================== 

(define ADDR_BASE #x4000)

(defproc test-expression ()
  (declare (once) (asm-func none))
  (zasm 
    (.ld hl (+ ADDR_BASE #x100))    ;; Вычислит $4100
    (.ret)))

(defproc test-jump-optimization ()
  (declare (once) (asm-func none))
  (zasm
    (.label start)
    (.jump #x8000)
    (.jump 'start)
    (.jump 'exit)
    (.label exit)      
    (.ret)))

(defproc test-data ()
  (declare (once) (asm-func none))
  (zasm      
    (.label msg_hello)
    (.db "Hello, Z80!" 0)     ;; Строка с нуль-терминатором
    
    (.label data_table)
    (.dw #x1234 (+ (address-of 'start) 5))  ;; Таблица адресов
    
    (.label buffer)
    (.ds 8 #xFF)))            ;; Буфер на 32 байта, забитый $FF
      
(defproc test-address ()     
  (declare (once) (asm-func none))
  (zasm
    (.org #x8000)          ;; Начинаем с адреса 32768
    
    (.label main)
    (.ld a #x41)           ;; Загружаем код символа 'A'
    (.call 'print_char)    ;; Вызываем процедуру
    (.jump 'main)          ;; Бесконечный цикл

    (.align 16)            ;; Отделяем данные/процедуры границей в 16 байт
    
    (.label print_char)
    ;; Представим, что здесь вывод в порт
    (.rst #x10)            ;; Системный вызов (напр. в Sinclair ROM)
    (.ret)))      

(defproc test-string-copy ()      
  (declare (once) (asm-func none))  
  (zasm
    (.label strcpy)
    (.ld a (@ hl))      ;; Опкод 7E (LD A, (HL))
    (.or a)             ;; Опкод B7 (OR A)
    (.ret 'z)           ;; Опкод C8 (RET Z)
    
    (.ld (@ de) a)      ;; ТЕПЕРЬ Ок: Опкод 12 (LD (DE), A)
    (.inc hl)           ;; Опкод 23
    (.inc de)           ;; Опкод 13
    (.jr 'strcpy)))      ;; Опкод 18 F7 (прыжок назад)


;;; ===================================================================== 
;;; 
;;; ===================================================================== 

(defproc test-copy-string ((dest string :reg de) 
                           (src string :reg hl))
  (declare (once) (asm-func none))
  ;; Вход: DE = dest, HL = src
  (.label 'loop)
  (.ld a (@ hl))      ;; Читаем символ из источника
  (.ld (@ de) a)      ;; Пишем в приемник
  (.or a)             ;; Проверяем на 0 (конец строки)
  (.ret 'z)           ;; Если 0 — выходим (строка уже закрыта нулем)
  
  (.inc hl)           ;; Следующий в источнике
  (.inc de)           ;; Следующий в приемнике
  (.jr 'loop))        ;; Повторяем

(defproc test-indirect (dest src)
  ;; Вход: DE = dest, HL = src
  (declare (once) (asm-func none))
  (.label loop)
  (.ld a (@ hl))      ;; Читаем символ из источника
  (.ld (@ de) a)      ;; Пишем в приемник
  (.or a)             ;; Проверяем на 0 (конец строки)
  (.ret 'z)           ;; Если 0 — выходим (строка уже закрыта нулем)
  
  (.inc hl)           ;; Следующий в источнике
  (.inc de)           ;; Следующий в приемнике
  (.jr 'loop))        ;; Повторяем



