
;-*-Scheme-*-
;
;=================================================================
; Mimic Common Lisp libary 
;=================================================================

;; В CL 'eq' проверяет идентичность объектов (указателей).
;; Если твой 'eq?' делает то же самое, это идеальный алиас.
(defun eq (a b)
  "Returns T if A and B are the same object, otherwise NIL."
  (eq? a b))

;; Более CL-ориентированный подход: в Лиспе знаки обычно возвращают числа 1, -1 или 0,
;; но если тебе нужны символы '+ и '- для ассемблера, эта реализация верна.
(defun sign (x)
  "Returns '+ if X is non-negative, and '- if X is negative.
   Useful for determining jump directions or offset signs in assembly."
  (if (>= x 0) '+ '-))

;; В CL 'setq' используется для переопределения существующих переменных.
;; Если в твоем языке 'define' работает и как создание, и как обновление,
;; то этот макрос корректен.
(defmacro setq (name data)
  "Basic assignment macro. Sets the variable NAME to the result of DATA."
  `(define ,name ,data))

;; 'setf' в CL — это мощнейшая система 'set-field'.
;; В простейшем случае (setf name value) он работает как setq.
;; Если ты передаешь getter (например, (setf (car x) 5)), это требует сложной логики.
;; Пока сделаем базовую версию для переменных:
(defmacro setf (place value)
  (if (symbolp place)
      ;; Случай 1: (setf x 5) -> (set! x 5)
      `(set! ,place ,value)
      
      ;; Случай 2: (setf (getter ...) 5)
      (let ((head (car place))
            (args (cdr place)))
        (cond
          ;; Если это (car x) -> (set-car! x value)
          ((eq head 'car) `(set-car! ,(car args) ,value))
          
          ;; Если это (cdr x) -> (set-cdr! x value)
          ((eq head 'cdr) `(set-cdr! ,(car args) ,value))

          ;; Если это (make-place obj key) -> (place-set! (make-place obj key) value)
          ((eq head 'make-place) `(place-set! ,place ,value))

          ;; Если это (get hash key) или (getf hash key)
          ;; Мы можем развернуть их сразу в (hash-table-set! hash key value) 
          ;; или использовать существующий механизм place, если он универсален
          ((eq head 'get)  `(place-set! (make-place ,(car args) ,(cadr args)) ,value))
          ((eq head 'getf) `(place-set! (make-place ,(car args) ,(cadr args)) ,value))
          
          ;; Если это твой lextoken-value
          ((eq head 'lextoken-value) `(set-lextoken-value! ,(car args) ,value))
          
          ;; Дефолтный случай (используем #t вместо t для Scheme-совместимости)
          (#t (error "SETF: Неизвестное место для записи" place))))))
          

(defun symbolp (sym) (symbol? sym))

;; Маркер успешной загрузки библиотеки
(define *core-libcl-loaded* #t)
